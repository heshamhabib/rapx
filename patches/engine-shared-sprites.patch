+
+			return new CroppedFrame
+			{
+				Type = frame.Type,
+				Size = new Size(w, h),
+				FrameSize = frame.FrameSize,
+				Offset = frame.Offset + new float2(x0 + w / 2f - width / 2f, y0 + h / 2f - height / 2f),
+				Data = cropped,
+				PaddedOffset = frame.Offset,
+				PaddedSize = frame.Size,
+				CropOrigin = new int2(x0, y0)
