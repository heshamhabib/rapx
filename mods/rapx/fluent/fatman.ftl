## Fatman strike (USA only, rules/fatman.yaml)

actor-bmbf =
    .name = Strategic Bomber Field
    .description =
    Home of the AB-35 Longwing atomic bomber.
    Charges the Fatman Strike while the bomber is alive.
    USA only. Maximum 1 can be built.
    .fatmanpower-name = Fatman Strike
    .fatmanpower-description = The AB-35 Longwing takes off and drops
    a Fatman atomic bomb on the target.
    A smaller blast than the Nuclear Missile.

actor-yb35 =
    .name = AB-35 Longwing
    .description =
    Flying-wing atomic bomber.
    Drops the Fatman bomb when the Fatman Strike is ready.
    It has no other weapon.
    USA only. Maximum 1 can be built.

notification-fatman-detected = Atomic bomber detected.

## Thermonuclear strike (Russia only, rules/fatman.yaml)

actor-sbmb =
    .name = Long-Range Aviation Base
    .description =
    Home of the Tv-95 Bear strategic bomber.
    Charges the Thermonuclear Strike while the bomber is alive.
    Russia only. Maximum 1 can be built.
    .rds37power-name = Thermonuclear Strike
    .rds37power-description = The Tv-95 Bear takes off and drops
    an RDS-37 hydrogen bomb on the target.
    Bigger than the Fatman, smaller than the Nuclear Missile.

actor-tu95 =
    .name = Tv-95 Bear
    .description =
    Four-engined strategic bomber.
    Drops the RDS-37 hydrogen bomb when the
    Thermonuclear Strike is ready. It has no other weapon.
    Russia only. Maximum 1 can be built.
