## rocket-launchers.yaml (IDEA-17 national rocket launchers)
actor-himax =
    .name = HIMAX
    .description =
    Fast wheeled launcher with long-range guided rockets.
    Shoot and scoot: drives off after each launch.
      Strong vs Infantry, Buildings and Vehicles
      Weak vs Aircraft

actor-hailstorm =
    .name = Hailstorm
    .description =
    Tracked launcher: a big 12-rocket salvo over a wide area.
      Strong vs Infantry and Buildings
      Weak vs Vehicles and Aircraft; slow

actor-lrx =
    .name = LRX
    .description =
    Tracked launcher with GPS-guided rockets.
    Precise; +50% damage vs buildings.
      Strong vs Buildings and Infantry
      Weak vs Vehicles and Aircraft

actor-marz =
    .name = MARZ II
    .description =
    Tracked launcher: a big 12-rocket salvo.
    Deploy to switch to mine rockets that scatter
    anti-tank mines.
      Strong vs Infantry and Buildings
      Weak vs Vehicles and Aircraft; slow

actor-saetta =
    .name = Saetta
    .description =
    Cheaper tracked launcher that reloads faster.
      Strong vs Infantry and Buildings
      Weak vs Vehicles and Aircraft

actor-kasirga =
    .name = Kasirga-X
    .description =
    Heavy 300 mm rockets with very long range.
      Strong vs Buildings and groups
      Weak vs Aircraft; slow reload

actor-fatah =
    .name = Fatah-X
    .description =
    Guided long-range rockets; very accurate.
      Strong vs Buildings, Infantry and Vehicles
      Weak vs Aircraft; slow reload

actor-type12 =
    .name = Type-12 Sea Arrow
    .description =
    Anti-ship missile truck: hits ships far out at sea.
      Strong vs Ships
      Weak vs land targets and Aircraft

actor-chunmu =
    .name = Chunmu
    .description =
    Heavy wheeled launcher firing a 6-rocket salvo.
    Deploy to switch to one heavy guided missile
    with longer range.
      Strong vs Infantry and Buildings
      Weak vs Vehicles and Aircraft; expensive

actor-toz1 =
    .name = TOZ-1 Sunflare
    .description =
    Armoured thermobaric launcher. Short range,
    but devastating up close.
      Strong vs Infantry and Buildings
      Weak vs Tanks and Aircraft

actor-vilkra =
    .name = Vilkra
    .description =
    Precision long-range rockets.
      Strong vs Buildings, Infantry and Vehicles
      Weak vs Aircraft; slow reload

actor-grad =
    .name = Guajiro Grad
    .description =
    Old Grad launcher: cheap but inaccurate.
      Strong vs Infantry and groups
      Weak vs Vehicles and Aircraft

actor-pinak =
    .name = Pinak
    .description =
    Fires its whole load of rockets very quickly.
      Strong vs Infantry and Buildings
      Weak vs Vehicles and Aircraft

actor-saqr36 =
    .name = Saqr-36
    .description =
    Cluster rockets: each splits into bomblets.
      Strong vs Infantry and Light vehicles
      Weak vs Tanks, Buildings and Aircraft

actor-phx16 =
    .name = PHX-16 Longreach
    .description =
    The longest-range rocket launcher.
      Strong vs Buildings and groups
      Weak vs Aircraft; slow reload

actor-fajir5 =
    .name = Fajir-5
    .description =
    Long range for a cheap price, but inaccurate.
    Deploy to switch to 2 Shard-136 attack drones
    with very long range.
      Strong vs Infantry and Buildings
      Weak vs Vehicles and Aircraft

actor-zolf =
    .name = Zolfaghar
    .description =
    Ballistic missile truck: fires the two missiles on its
    erector at targets 22 cells away, then reloads slowly.
    Only long-range air defence can stop the missiles.
      Strong vs Buildings and Ground units
      Weak vs Aircraft and close combat

actor-mlrs =
    .name = Thunderhead MLRS
    .description =
    Tracked rocket tank: fires its whole rack of 19
    rockets in one heavy stream, then reloads.
      Strong vs Infantry, Buildings and groups of vehicles
      Weak vs Aircraft and close combat

actor-hlfr =
    .name = Hailfire Rocket Truck
    .description =
    Fast rocket truck: fires a long stream of
    30 light rockets from its launch tubes.
      Strong vs Infantry and Buildings
      Weak vs Tanks and Aircraft
