    .tooltipdesc =
        Passe les unités sélectionnées en posture « tout attaquer » :
        - Les unités attaquent les unités et structures ennemies à vue
        - Les unités poursuivent les assaillants sur tout le champ de bataille

button-stance-bar-defend =
