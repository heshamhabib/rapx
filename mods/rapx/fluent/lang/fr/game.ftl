catalogue-1tnk =
    .role = Char léger
    .lore = Rapide et bon marché, idéal pour la reconnaissance, le harcèlement des camions de minerai et la chasse aux véhicules légers. Il perd un duel direct contre des chars plus lourds.

catalogue-2tnk =
    .role = Char de combat principal
    .lore = Le char de combat principal de l'Union : un bon équilibre entre vitesse, blindage et puissance de feu. Associez-le aux lance-roquettes et au Flak mobile pour une armée complète.

catalogue-3tnk =
    .role = Char lourd
    .lore = Le char de combat principal de Vanguard, avec deux canons lourds. Plus lent que les blindés de l'Union mais frappe bien plus fort. Gagne les affrontements de chars frontaux.

catalogue-4tnk =
    .role = Char super-lourd
    .lore = Le Mammouth : deux canons contre les chars, des nacelles de missiles contre les aéronefs et l'infanterie, un blindage lourd et une autoréparation quand il est endommagé. Lent et coûteux, il écrase même les murs en béton.

catalogue-abas =
    .role = Grande base aérienne
    .lore = Un aérodrome plus grand avec un parking pour 6 avions. Agrandissez votre escadre sans éparpiller les pistes dans la base.

catalogue-abrn =
    .role = Base aéroportée, 3 aires de transport
    .lore = Base des brigades parachutistes : casernes, salle de pliage des parachutes et trois aires pour les transports lourds qui emportent chacun 40 soldats n'importe où sur la carte.

catalogue-afbs =
    .role = Base de l'armée de l'air
    .lore = Une véritable base aérienne avec un parking pour 8 avions, pour une escadre de frappe sérieuse.

catalogue-afld =
    .role = Base aérienne
    .lore = Construit et réarme les avions, avec un parking pour 4 appareils. Fournit aussi les pouvoirs de soutien Avion espion et Parachutistes. Les chasseurs y reviennent se réarmer après chaque sortie.

catalogue-agun =
    .role = Défense antiaérienne courte portée
    .lore = Un canon Flak qui déchiquette aéronefs, drones et missiles de croisière à courte portée. Nécessite de l'énergie. Entourez-en votre base contre les bombardiers.

catalogue-apc =
    .role = Transport blindé
    .lore = Transporte une escouade d'infanterie sous blindage et l'appuie avec une mitrailleuse. Déposez des ingénieurs dans une base ennemie ou envoyez vite des lance-roquettes au front.

catalogue-apwr =
    .role = Production d'énergie lourde
    .lore = Deux fois la production d'une centrale électrique, sur une plus grande surface. Cible de choix pour les bombardiers ennemis : protégez-la avec de la DCA.

catalogue-arty =
    .role = Artillerie
    .lore = Obusier à longue portée qui pilonne défenses et infanterie hors de leur portée. Très fragile au contact : gardez toujours une escorte.

catalogue-asat =
    .role = Antisatellite
    .lore = Abat les satellites ennemis en orbite dans un rayon de 12 cases. Ne peut toucher ni unités terrestres ni aéronefs. Votre seule défense contre un réseau laser orbital.

catalogue-atek =
    .role = Recherche avancée
    .lore = Centre de recherche de l'Union. Débloque les armes les plus avancées de l'Union et lance le satellite GPS, qui révèle toute la carte.

catalogue-aw101 =
    .role = Hélicoptère de transport lourd
    .lore = Le Merlin : un hélicoptère trimoteur rapide qui transporte dix soldats sur de longues distances. Inde uniquement.

catalogue-b17t =
    .role = Transport aéroporté, 40 parachutistes
    .lore = Une Forteresse volante capturée, comme celles de l'escadrille spéciale qui larguait des agents derrière les lignes pendant la guerre.

catalogue-b29t =
    .role = Transport aéroporté, 40 parachutistes
    .lore = La Superforteresse copiée rivet pour rivet par Vanguard, ses soutes à bombes désormais remplies de parachutistes.

catalogue-b314 =
    .role = Transport aéroporté, 40 parachutistes
    .lore = Un grand hydravion de l'âge des clippers, qui emporte les parachutistes italiens depuis ses bases d'hydravions.

catalogue-b52t =
    .role = Transport aéroporté, 40 parachutistes
    .lore = Une Stratofortress aux soutes vidées et réaménagées pour larguer un stick de quarante hommes.

catalogue-barr =
    .role = Production d'infanterie
    .lore = Caserne de Vanguard : entraîne conscrits, grenadiers, lance-flammes, soldats de choc et exosquelettes Garde de fer. Plusieurs casernes accélèrent l'entraînement.

catalogue-bb =
    .role = Cuirassé
    .lore = Les plus gros canons en mer : des tourelles triples de 406 mm à l'avant et à l'arrière qui pilonnent la côte hors de portée de la plupart des défenses. Lent et très difficile à couler, mais aveugle face aux sous-marins.

catalogue-bdrd =
    .role = Droïde de combat
    .lore = Droïdes bon marché de l'Union armés de fusils blasters, produits en masse. Utilisez-les pour submerger l'infanterie ennemie et encaisser les tirs.

catalogue-bmbf =
    .role = Aérodrome de superarme
    .lore = Un terrain de bombardiers gardé avec une piste géante, un hangar et un bunker à bombes blindé. Il abrite l'AB-35 Longwing et charge la Frappe Fatman tant que le bombardier vit. États-Unis uniquement, un par joueur.

catalogue-bmd =
    .role = Défense antimissile balistique
    .lore = Classe THAAD. Intercepte les missiles balistiques et hypersoniques haut et loin : la réponse aux frappes de missiles balistiques (il laisse les roquettes au SAM moyenne portée). Nécessite un dôme radar pour sa portée maximale.

catalogue-brik =
    .role = Barrière lourde
    .lore = Des murs en béton qui arrêtent toutes les unités terrestres et bloquent les tirs ennemis. Seul le char Mammouth peut les écraser. Utilisez-les pour protéger centrales et raffineries.

catalogue-btr =
    .role = Transport blindé
    .lore = Un véhicule blindé de transport de troupes à huit roues avec canon automatique en tourelle : rapide sur route, il dépose 5 fantassins au front et continue de tirer. Russie uniquement.

catalogue-c130 =
    .role = Transport aéroporté, 40 parachutistes
    .lore = Le Hercules : le quadrimoteur bon à tout faire des forces aéroportées, des États-Unis à la France, au Japon, à la Corée du Sud, à la Turquie et au Pakistan.

catalogue-c141 =
    .role = Transport aéroporté, 40 parachutistes
    .lore = Le long jet qui a transporté les divisions aéroportées de l'Union pendant des décennies.

catalogue-c17 =
    .role = Transport aéroporté, 40 parachutistes
    .lore = L'avion de transport stratégique de la Royal Air Force : quatre turboréacteurs, une soute immense et un stick de quarante hommes par les portes latérales.

catalogue-ca =
    .role = Croiseur
    .lore = Un navire très lent aux énormes canons longue portée qui pilonnent les bases côtières depuis le large. Escortez-le de destroyers contre les sous-marins.

catalogue-cg =
    .role = Croiseur lance-missiles
    .lore = Un croiseur lance-missiles : ses Tomahawk frappent loin dans les terres, tandis que ses SAM et son canon de défense rapprochée protègent la flotte des attaques aériennes. États-Unis uniquement.

catalogue-chunmu =
    .role = Lance-roquettes (Corée du Sud)
    .lore = Un lanceur lourd à roues tirant une salve de 6 roquettes. Déployez-le pour passer à un missile guidé lourd à plus longue portée.

catalogue-croc =
    .role = Prédateur embusqué
    .lore = Le plus vieux chasseur du Nil, élevé et dressé par l'Égypte. Il marche sur terre, nage plus vite qu'il ne marche et reste immobile dans l'eau, seuls les yeux dépassant, invisible jusqu'à ce qu'il frappe. Un bond et une morsure achèvent un soldat ou un chien ; il s'arrête ensuite pour avaler. Sa peau écailleuse résiste aux tirs de fusil. Égypte uniquement.

catalogue-ctnk =
    .role = Char Chrono
    .lore = Tire des missiles air-sol et peut se téléporter n'importe où à portée. Surgissez derrière les lignes ennemies pour frapper artillerie et raffineries, puis repartez.

catalogue-cv1 =
    .role = Porte-avions d'escadre
    .lore = Un porte-avions de classe Essex de la Seconde Guerre mondiale : une base aérienne flottante défendue par des lanceurs SAM. Lance et réarme les avions en mer.

catalogue-cv2 =
    .role = Porte-avions de combat
    .lore = Le premier porte-avions nucléaire, classe Enterprise : pont plus grand, coque plus solide et davantage de lanceurs SAM.

catalogue-cv3 =
    .role = Super porte-avions
    .lore = Un super porte-avions nucléaire de classe Nimitz, navire amiral lourdement blindé de la flotte.

catalogue-cv4 =
    .role = Super porte-avions nouvelle génération
    .lore = Un porte-avions de classe Gerald R. Ford doté des défenses les plus récentes. Le navire le plus puissant à flot.

catalogue-cvcn =
    .role = Super porte-avions (Chine)
    .lore = Le Fujian : le plus récent super porte-avions chinois, équipé de catapultes électromagnétiques.

catalogue-cveg =
    .role = Porte-hélicoptères (Égypte)
    .lore = Le Mistral : un porte-hélicoptères amphibie. Bon marché et rapide à construire.

catalogue-cvfr =
    .role = Porte-avions (France)
    .lore = Le Charles de Gaulle, porte-avions nucléaire de la France et fierté de la Marine nationale.

catalogue-cvgb =
    .role = Porte-avions (Angleterre)
    .lore = Le Queen Elizabeth de la Royal Navy, avec tremplin et double îlot.

catalogue-cvin =
    .role = Porte-avions (Inde)
    .lore = Le Vikrant : porte-avions de conception indienne avec tremplin.

catalogue-cvir =
    .role = Porte-drones (Iran)
    .lore = Le Bagheri : un navire marchand converti avec un pont d'envol pour drones. Bon marché, mais fragile.

catalogue-cvit =
    .role = Porte-avions léger (Italie)
    .lore = Le Cavour : un porte-avions léger italien pour avions à décollage vertical et hélicoptères.

catalogue-cvjp =
    .role = Porte-avions léger (Japon)
    .lore = Le Kaga : un destroyer porte-hélicoptères reconverti en porte-avions léger pour chasseurs à décollage vertical.

catalogue-cvru =
    .role = Porte-avions (Russie)
    .lore = Le Kouznetsov : un croiseur porte-aéronefs lourd avec tremplin et solides défenses SAM.

catalogue-cvsu =
    .role = Croiseur porte-aéronefs
    .lore = Le Kiev : mi-porte-avions, mi-croiseur, avec un pont d'envol à l'arrière et des lance-missiles à l'avant.

catalogue-cvtr =
    .role = Porte-drones (Turquie)
    .lore = L'Anadolu : un navire amphibie reconverti en porte-drones qui lance des essaims de drones d'attaque.

catalogue-cybt =
    .role = Infanterie cyborg
    .lore = Un cyborg blindé de l'Union armé d'un pistolet automatique lourd. Les chars ne peuvent pas l'écraser et il n'a jamais besoin de se mettre à couvert. Un solide pilier de ligne.

catalogue-dd =
    .role = Destroyer
    .lore = Un navire de guerre polyvalent et rapide qui détecte les sous-marins et combat navires, véhicules et aéronefs. L'épine dorsale de la flotte de l'Union.

catalogue-dog =
    .role = Chien d'attaque
    .lore = Rapide et bon marché, il tue un fantassin d'une morsure et flaire les espions déguisés. Gardez-en une paire à la base pour chasser les espions.

catalogue-dome =
    .role = Renseignement
    .lore = Active votre minicarte radar et débloque la plupart des unités et défenses de milieu de partie. Donne aussi leur portée maximale à vos SAM longue portée. Le perdre vous rend aveugle : protégez-le.

catalogue-dtrk =
    .role = Camion à bombe nucléaire
    .lore = Un camion avec une ogive nucléaire armée et un blindage en papier. Conduisez-le dans la base ennemie et faites-le exploser. Il emporte tout ce qui l'entoure, y compris vos propres unités.

catalogue-e1 =
    .role = Fusiliers
    .lore = La colonne vertébrale de toute armée : bon marché, vite entraîné et efficace contre l'infanterie. Placez-les en garnison dans les casemates, ou massez-les pour protéger vos chars des lance-roquettes.

catalogue-e2 =
    .role = Grenadier
    .lore = Lance des grenades qui touchent les groupes d'infanterie et endommagent les bâtiments. Leurs grenades peuvent blesser les unités alliées proches : gardez-les derrière la ligne de front.

catalogue-e3 =
    .role = Antichar / antiaérien
    .lore = Roquettes à l'épaule efficaces contre blindés et aéronefs. Bon marché, c'est la réponse de l'infanterie aux chars et hélicoptères, mais une proie facile pour les mitrailleuses.

catalogue-e4 =
    .role = Lance-flammes
    .lore = Lance-flammes à courte portée qui brûlent l'infanterie à couvert et incendient les bâtiments. Parfaits pour nettoyer les bunkers et assaillir les bases.

catalogue-e6 =
    .role = Ingénieur
    .lore = Capture les bâtiments ennemis, répare les vôtres et remet en état les ponts détruits. Escortez-les dans la base ennemie et prenez une usine d'armement ou un centre technologique pour voler sa technologie.

catalogue-e7 =
    .role = Commando d'élite
    .lore = Tanya : deux pistolets qui abattent un fantassin d'un tir, et du C4 qui rase tout bâtiment qu'elle atteint. Une seule peut être déployée. Tenez-la à l'écart des chars et des chiens.

catalogue-e8c =
    .role = Transport aéroporté, 40 parachutistes
    .lore = Une cellule de Boeing 707, comme celles que l'armée de l'air iranienne utilise depuis un demi-siècle, réaménagée pour le transport de troupes.

catalogue-elph =
    .role = Éléphant de guerre marcheur
    .lore = L'éléphant de guerre blindé de l'Inde : une forteresse ambulante sur quatre pattes d'acier, avec sur le dos un double canon lourd qui tire obus sur obus. Les soldats ne peuvent pas l'esquiver comme un char : quiconque se trouve sous ses pieds est piétiné. Lent et coûteux, mais très difficile à arrêter. Inde uniquement.

catalogue-enfw =
    .role = Marcheur d'assaut
    .lore = Un marcheur bipède lourd de l'Union. Ses deux canons automatiques déchiquettent l'infanterie et son lance-roquettes d'épaule perce les blindages. Une forteresse ambulante pour enfoncer les lignes défensives.

catalogue-fact =
    .role = Commandement de base
    .lore = Le cœur de toute base. Il construit toutes les autres structures et définit votre rayon de construction : le perdre stoppe toute expansion. Gardez-le au cœur de vos défenses et, si le salon le permet, repliez-le en VCM pour déplacer votre base.

catalogue-fajir5 =
    .role = Lance-roquettes (Iran)
    .lore = Longue portée à petit prix, mais imprécis. Déployez-le pour passer à deux drones d'attaque Shard-136 à très longue portée.

catalogue-fatah =
    .role = Lance-roquettes (Pakistan)
    .lore = Roquettes guidées à longue portée, très précises contre bâtiments, infanterie et véhicules. Rechargement lent.

catalogue-fenc =
    .role = Barrière légère
    .lore = Des barbelés qui arrêtent l'infanterie et les véhicules légers. Les chars les écrasent.

catalogue-fix =
    .role = Réparation de campagne
    .lore = Répare, contre paiement, les véhicules qui montent sur sa plateforme. Débloque aussi les véhicules avancés. Placez-le entre l'usine d'armement et le front pour que les chars endommagés reviennent vite au combat.

catalogue-flak =
    .role = Défense antiaérienne
    .lore = Un double canon Flak lourd sur affût tournant. Ses rafales touchent tous les aéronefs proches et peuvent abattre drones et missiles de croisière.

catalogue-ftrk =
    .role = Antiaérien mobile
    .lore = Un canon Flak sur camion qui déchiquette aéronefs, drones et infanterie. Gardez-en un dans chaque colonne blindée.

catalogue-ftur =
    .role = Tour anti-infanterie
    .lore = Arrose de carburant enflammé quiconque s'approche. Dévastateur contre l'infanterie et les véhicules légers, mais de courte portée et inefficace contre les chars à distance.

catalogue-gap =
    .role = Contre-espionnage
    .lore = Enveloppe votre base d'un voile pour que l'ennemi ne voie pas l'intérieur. Les éclaireurs et avions espions ne la révèlent que brièvement. Nécessite de l'énergie.

catalogue-godz =
    .role = Titan : superarme ambulante
    .lore = Une montagne d'écailles qui surgit de la mer. Quand ses plaques dorsales s'illuminent de rose, tout ce qui est devant lui va brûler : le souffle atomique porte plus loin que la plupart des artilleries et abat les aéronefs. Les chars qui s'approchent sont écrasés. Choisi dans le salon, un par joueur, et une fois tombé, il est perdu pour de bon.

catalogue-grad =
    .role = Lance-roquettes (Cuba)
    .lore = Un vieux lance-roquettes Grad : bon marché mais imprécis. Massez-les pour saturer une zone de roquettes.

catalogue-gun =
    .role = Tourelle antiblindés
    .lore = Une tourelle à canon rotatif qui perce les chars. Bon marché et fiable, mais faible contre l'infanterie en masse et impuissante contre les aéronefs.

catalogue-gurz =
    .role = Défense antiaérienne mobile
    .lore = Un lourd camion à huit roues portant un module de combat rotatif : deux nacelles de petits missiles infrarouges et un canon de 35 mm entre elles. Il tire quatre missiles à la fois, chacun décrivant une vrille serrée, et leurs fusées de proximité éclatent en flocons de flak noirs. Nations de Vanguard sauf l'Inde.

catalogue-hailstorm =
    .role = Lance-roquettes (Angleterre)
    .lore = Un lanceur chenillé qui tire une grosse salve de 12 roquettes sur une large zone. Efficace contre l'infanterie et les bases, mais lent.

catalogue-harv =
    .role = Camion de minerai
    .lore = Collecte le minerai et les gemmes et les apporte à votre raffinerie. Lourdement blindé, mais non armé. Protégez vos camions : ce sont vos revenus.

catalogue-hbox =
    .role = Bunker camouflé
    .lore = Une casemate dissimulée sous un camouflage. L'ennemi ne la voit qu'une fois tout proche : une embuscade parfaite sur une route d'attaque probable.

catalogue-hcru =
    .role = Croiseur porte-hélicoptères
    .lore = Un croiseur avec un pont pour hélicoptères à l'arrière : missiles et canon Gatling contre les aéronefs, grenades ASM et sonar contre les sous-marins.

catalogue-heli =
    .role = Hélicoptère d'attaque
    .lore = Le Longbow : un hélicoptère lance-missiles qui chasse chars, bâtiments et autres aéronefs. Frappez puis repliez-vous, et retournez à l'héliport pour vous réarmer.

catalogue-himax =
    .role = Lance-roquettes (États-Unis)
    .lore = Un lanceur à roues rapide tirant des roquettes guidées à longue portée. Il tire et décroche après chaque salve : la contre-batterie frappe généralement un terrain vide.

catalogue-hind =
    .role = Hélicoptère d'assaut
    .lore = Le Hind : un hélicoptère de combat lourd avec canons à chaîne qui fauche l'infanterie et les véhicules légers.

catalogue-hlfr =
    .role = Camion lance-roquettes
    .lore = Un lance-roquettes multiple à roues doté d'une batterie de tubes fermés. Il tire 30 roquettes légères en un long flot qui sature la zone ciblée, puis recharge.

catalogue-hmmv =
    .role = Véhicule de reconnaissance
    .lore = Le cheval de bataille de l'US Army : blindé, rapide, avec une mitrailleuse de 12,7 mm sur le toit et de la place pour une équipe de quatre. États-Unis uniquement.

catalogue-hpad =
    .role = Base d'hélicoptères
    .lore = Construit et réarme les hélicoptères des deux camps : Chinook, Black Hawk et Longbow de l'Union, Mi-26, Hind, Mi-35 et Ka-52 de Vanguard. Chaque plateforme sert un hélicoptère à la fois : construisez-en une par hélicoptère de combat prévu.

catalogue-il76 =
    .role = Transport aéroporté, 40 parachutistes
    .lore = Le Candid : le transport lourd à réaction de l'Ukraine, de la Russie et de l'Inde. Il largue un stick de quarante hommes derrière les lignes ennemies et éloigne les chasseurs grâce à deux canons de 23 mm en queue.

catalogue-irgd =
    .role = Infanterie en exosquelette
    .lore = Un soldat de Vanguard en exosquelette motorisé armé d'une mitrailleuse lourde à bande. Les chars ne peuvent pas l'écraser et il fauche l'infanterie.

catalogue-iron =
    .role = Superarme
    .lore = Rend un groupe d'unités ou de bâtiments invulnérable pendant un court instant. Synchronisez-le avec une poussée de chars pour que la pointe arrive intouchable.

catalogue-jeep =
    .role = Véhicule d'éclaireur
    .lore = Le Ranger : un éclaireur rapide armé d'une mitrailleuse qui transporte un soldat. Idéal pour reconnaître, chasser l'infanterie et traquer les camions de minerai.

catalogue-jet-a10 =
    .role = Attaque au sol, génération 3
    .lore = Le Thunderhog : un char volant construit autour d'un énorme canon rotatif. Lourdement blindé, lent et mortel pour les blindés. Tenez les chasseurs à distance.

catalogue-jet-an225 =
    .role = Transport lourd, génération 4
    .lore = L'An-225 Dreamer : le plus gros avion jamais construit. Il transporte de l'infanterie à travers la carte. Non armé.

catalogue-jet-b2 =
    .role = Bombardier furtif, génération 5
    .lore = Le Wraith : un bombardier furtif à aile volante qui largue une charge massive loin derrière les lignes ennemies.

catalogue-jet-b52 =
    .role = Bombardier lourd, génération 2
    .lore = Le Stratoforce : un énorme bombardier de tapis qui rase des quartiers entiers d'une base. Escortez-le, car il ne peut pas se défendre contre les chasseurs.

catalogue-jet-f104 =
    .role = Intercepteur, génération 2
    .lore = Le Starflash : un intercepteur de la guerre froide au nez effilé, conçu pour la vitesse pure. Ses missiles frappent fort bâtiments et véhicules, mais il est peu blindé.

catalogue-jet-f117 =
    .role = Frappe furtive, génération 3
    .lore = Le Nightjar : un jet furtif à facettes qui se faufile entre les défenses antiaériennes pour frapper les cibles de haute valeur.

catalogue-jet-f14 =
    .role = Intercepteur, génération 3
    .lore = Le Bobcat : un défenseur de flotte à géométrie variable armé de missiles longue portée. Utilisé seulement par les États-Unis et l'Iran.

catalogue-jet-f16 =
    .role = Chasseur multirôle, génération 3
    .lore = Le Fighting Kestrel : un chasseur multirôle léger et agile. Un bon rapport qualité-prix contre véhicules et bâtiments.

catalogue-jet-f2 =
    .role = Chasseur d'attaque naval, génération 4
    .lore = Le Zero Viper : le chasseur d'attaque japonais, un Falcon allongé à voilure agrandie conçu pour chasser les navires loin en mer.

catalogue-jet-f22 =
    .role = Chasseur furtif, génération 5
    .lore = Le Raptorex : un chasseur furtif de cinquième génération, le meilleur avion de supériorité aérienne de l'Union. Rapide, discret et mortel.

catalogue-jet-f4 =
    .role = Intercepteur, génération 2
    .lore = Le Spectre II : un biréacteur robuste utilisé par plus de nations que tout autre avion du jeu. Une puissance de frappe fiable à prix raisonnable.

catalogue-jet-gapgen =
    .role = Générateur de brouillage aéroporté
    .lore = Un avion radar non armé qui cache à l'ennemi le sol situé sous lui. Envoyez-le au-dessus d'une zone et il y tourne en cercle. Couvrez-en une poussée de chars.

catalogue-jet-grom =
    .role = Prototype de drone de combat
    .lore = Le Grom-K : un drone de combat russe sans pilote. Bon marché, fragile et dangereux pour l'infanterie. Un par joueur.

catalogue-jet-harrier =
    .role = Avion à décollage vertical, génération 3
    .lore = Le Harrow décolle à la verticale depuis de minuscules aires et ponts de porte-avions et frappe durement les véhicules.

catalogue-jet-he177 =
    .role = Bombardier lourd, génération 0
    .lore = Le Greif : le quadrimoteur allemand de la guerre, ses moteurs couplés entraînant deux grandes hélices, toujours capable d'emporter une lourde charge de bombes.

catalogue-jet-ho229 =
    .role = Bombardier furtif, génération 5
    .lore = Le Nachtflügel : le bombardier à réaction allemand à aile volante, né du projet des frères Horten pendant la guerre et enfin construit avec des moteurs modernes et une lourde charge de bombes guidées.

catalogue-jet-j20 =
    .role = Chasseur furtif, génération 5
    .lore = Le JX-20 Jade Dragon : le chasseur furtif chinois de cinquième génération, à long rayon d'action et difficile à repérer.

catalogue-jet-l39 =
    .role = Attaque légère, génération 2
    .lore = Le L-39U Albatross : un avion d'entraînement et d'attaque léger étonnamment efficace contre l'infanterie, les blindés légers et les drones.

catalogue-jet-la11 =
    .role = Chasseur à pistons, génération 0
    .lore = Le LaV-11 Fang : un robuste chasseur à moteur en étoile des années 1940. Bon marché et rapide à aligner en nombre.

catalogue-jet-m2000 =
    .role = Chasseur multirôle, génération 3
    .lore = Le Mirago 2000 : un élégant chasseur multirôle à aile delta utilisé par de nombreuses nations.

catalogue-jet-mig21 =
    .role = Chasseur à réaction, génération 2
    .lore = Le MiK-21 Fishbone : le jet le plus répandu du bloc Vanguard. Simple, rapide et bon marché.

catalogue-jet-mig23 =
    .role = Chasseur multirôle, génération 3
    .lore = Le MiK-23 Flintlock : un chasseur-bombardier à géométrie variable qui frappe vite et repart vite.

catalogue-jet-mig25 =
    .role = Intercepteur, génération 3
    .lore = Le MiK-25 Foxbane : un intercepteur de haute altitude d'une vitesse brutale. Peu d'appareils peuvent le rattraper.

catalogue-jet-mig3 =
    .role = Chasseur à pistons, génération 0
    .lore = Le MiK-3 Strela : un chasseur à hélice des années 1940. Bon marché et rapide à construire, idéal pour mitrailler l'infanterie et les véhicules légers.

catalogue-jet-qaher =
    .role = Prototype furtif
    .lore = Le Qahir-X : le chasseur furtif expérimental iranien. Un par joueur.

catalogue-jet-rafale =
    .role = Chasseur multirôle, génération 4
    .lore = Le Rafal F4 : un chasseur omnirôle moderne à aile delta et plans canard, aussi bon en frappe qu'en combat aérien.

catalogue-jet-saeqeh =
    .role = Chasseur à réaction, génération 3
    .lore = Le Saeqa : le chasseur iranien à double dérive, un solide avion de frappe contre véhicules et bâtiments.

catalogue-jet-seavixen =
    .role = Attaque navale, génération 2
    .lore = Le Sea Vixa : un chasseur d'attaque naval à double poutre spécialisé dans la destruction des navires.

catalogue-jet-sr71 =
    .role = Reconnaissance, génération 3
    .lore = Le Blackwing : un avion de reconnaissance à grande vitesse très difficile à intercepter. Il révèle la base ennemie sur son passage.

catalogue-jet-su25 =
    .role = Attaque au sol, génération 3
    .lore = Le Sk-25 Rook : un avion d'appui rapproché blindé qui pilonne chars et véhicules à basse altitude.

catalogue-jet-su27 =
    .role = Supériorité aérienne, génération 3
    .lore = Le Sk-27 Flankard : un gros chasseur biréacteur à long rayon d'action et lourdement armé.

catalogue-jet-su30 =
    .role = Chasseur multirôle, génération 4
    .lore = Le Flankard-M : le Flanker biplace qui combat et frappe à la fois, utilisé par Vanguard, la Russie, l'Inde et la Chine.

catalogue-jet-su35 =
    .role = Chasseur multirôle, génération 4
    .lore = Le Sk-35 Flankard-E : poussée vectorielle, supermanœuvrabilité, et le meilleur chasseur standard de Vanguard.

catalogue-jet-su47 =
    .role = Chasseur prototype
    .lore = Le Sk-47 Berkov : un chasseur furtif expérimental à ailes en flèche inversée. Un par joueur.

catalogue-jet-swarm =
    .role = Essaim de drones, génération 3
    .lore = Les drones d'essaim turcs : des attaquants sans pilote bon marché qui submergent l'infanterie et les blindés légers par le nombre.

catalogue-jet-tu160 =
    .role = Bombardier stratégique, génération 3
    .lore = Le Tv-160 Swanwing : le bombardier supersonique russe à géométrie variable, qui délivre une charge massive à grande vitesse.

catalogue-jet-typhoon =
    .role = Chasseur multirôle, génération 4
    .lore = Le Typhon : un chasseur européen à aile delta et plans canard, très agile et lourdement armé.

catalogue-jet-v22 =
    .role = Transport convertible, génération 4
    .lore = Le convertible Kestrel décolle comme un hélicoptère et vole comme un avion, transportant l'infanterie loin derrière les lignes ennemies. Non armé.

catalogue-jet-vulcan =
    .role = Bombardier lourd, génération 2
    .lore = Le Volcan : un bombardier V à aile delta, l'arme lourde à long rayon d'action de l'Angleterre contre les bases.

catalogue-jet-x47 =
    .role = Prototype de drone de combat
    .lore = Le Stingray : un drone de combat sans pilote. Bon marché et fragile, mais il mitraille l'infanterie et les blindés légers sans risquer de pilote. Un par joueur.

catalogue-jet-yak141 =
    .role = Prototype à décollage vertical
    .lore = Le Yk-141 Freestyler : un prototype supersonique à décollage vertical qui frappe les véhicules. Un par joueur.

catalogue-jet-yf23 =
    .role = Chasseur prototype
    .lore = Le Black Recluse : un chasseur furtif expérimental. Un seul par joueur, un as rare et mortel.

catalogue-jet-zeppelin =
    .role = Dirigeable de bombardement
    .lore = Un dirigeable blindé à l'énorme charge de bombes. Très lent, mais un Zeppelin à pleine charge au-dessus d'une base est dévastateur. Abattez-le tôt.

catalogue-ka52 =
    .role = Hélicoptère d'attaque
    .lore = L'Alligator : deux rotors coaxiaux et pas de rotor de queue le rendent rapide et agile. Missiles antichars et canon de 30 mm traquent les blindés. La réponse de Vanguard au Longbow.

catalogue-kasirga =
    .role = Lance-roquettes (Turquie)
    .lore = Roquettes lourdes de 300 mm à très longue portée qui écrasent bâtiments et unités groupées. Rechargement lent.

catalogue-kenn =
    .role = Dressage canin
    .lore = Entraîne des chiens d'attaque : des chasseurs rapides et bon marché qui tuent un fantassin d'une morsure et flairent les espions déguisés.

catalogue-kong =
    .role = Titan : singe géant
    .lore = Le singe géant traverse murs et colonnes de chars sans distinction. Au contact, son double coup de poing écrase tout ; plus loin, il arrache des rochers et les lance. Les avions et hélicoptères qui le survolent ne sont pas à l'abri : il bondit en l'air et les abat d'un seul coup. Plus rapide que Godzilla, mais l'eau l'arrête. Choisi dans le salon, un par joueur, et une fois tombé, il est perdu pour de bon.

catalogue-kvst =
    .role = Marcheur d'assaut
    .lore = Une caisse de char lourd avec un canon de 152 mm, portée par deux jambes blindées au lieu de chenilles. Lent, mais il enjambe murs, tranchées et quiconque se trouve sur son chemin.

catalogue-lha =
    .role = Navire d'assaut amphibie
    .lore = Un navire d'assaut à pont plat qui transporte tout un groupe de débarquement jusqu'à la plage et repousse les aéronefs en chemin. États-Unis uniquement.

catalogue-lnch =
    .role = Lancement spatial
    .lore = Construit et lance des satellites depuis l'onglet Aéronefs, jusqu'à 8 en orbite. La porte d'accès au réseau laser orbital.

catalogue-lrx =
    .role = Lance-roquettes (France)
    .lore = Un lanceur chenillé à roquettes guidées par GPS. Précis, avec +50 % de dégâts contre les bâtiments. Le meilleur outil pour démanteler les défenses.

catalogue-lsam =
    .role = Défense antiaérienne longue portée
    .lore = Classe Patriot / S-400. Arrête aéronefs, missiles de croisière et missiles balistiques tactiques bien au-delà des limites de votre base. Nécessite un dôme radar pour sa portée maximale.

catalogue-lsat =
    .role = Arme orbitale
    .lore = Plane très haut au-dessus de la carte et tire un laser à la verticale sur les ennemis en dessous. Les satellites à moins de 12 cases forment un réseau qui renforce le rayon. Seuls les sites ASAT peuvent l'atteindre.

catalogue-lst =
    .role = Péniche de débarquement
    .lore = Transporte infanterie et chars sur l'eau et les débarque sur n'importe quelle plage. Non armé.

catalogue-m16 =
    .role = Véhicule antiaérien
    .lore = Un half-track avec quatre mitrailleuses lourdes sur affût tournant. Bon marché et rapide : il déchiquette hélicoptères, avions volant bas et infanterie, mais les chars l'ignorent.

catalogue-marz =
    .role = Lance-roquettes (Allemagne)
    .lore = Un lanceur chenillé tirant une salve de 12 roquettes. Déployez-le pour passer à des roquettes qui dispersent des mines antichars sur le chemin de l'ennemi.

catalogue-mcv =
    .role = Construction mobile
    .lore = Se déploie en chantier de construction. Servez-vous-en pour ouvrir une seconde base près d'un gisement éloigné, ou pour reconstruire après un désastre.

catalogue-meads =
    .role = Défense antiaérienne longue portée
    .lore = Un camion lanceur aux conteneurs dressés à la verticale. Chaque intercepteur est éjecté par gaz, allume son moteur au-dessus et s'incline vers la cible, actionnant de petits propulseurs latéraux à l'approche pour un impact direct. Il peut tirer dans toutes les directions sans pivoter et abat aussi les missiles de croisière et balistiques. Nations de l'Union.

catalogue-mech =
    .role = Mécanicien de campagne
    .lore = Répare les véhicules sur le terrain, pour que vos chars combattent loin d'un dépôt de maintenance.

catalogue-medi =
    .role = Infirmier de campagne
    .lore = Soigne l'infanterie proche sur le terrain. Gardez-en un dans chaque groupe d'infanterie et vos escouades survivront bien plus longtemps.

catalogue-mgg =
    .role = Générateur de brouillage mobile
    .lore = Couvre les alentours d'un voile. Faites-le accompagner votre armée pour que l'ennemi ne voie pas venir l'attaque.

catalogue-mh60 =
    .role = Hélicoptère d'assaut
    .lore = Le Black Hawk : un hélicoptère de combat avec deux canons à chaîne contre l'infanterie et les véhicules légers. Rapide à réarmer et idéal pour nettoyer l'infanterie.

catalogue-mi17 =
    .role = Hélicoptère de transport de troupes
    .lore = Le Hip : l'hélicoptère bon à tout faire de Vanguard. Il emmène une escouade complète de huit au front, avec une mitrailleuse de sabord pour tenir l'ennemi à couvert sur la zone d'atterrissage.

catalogue-mi26 =
    .role = Hélicoptère de transport lourd
    .lore = Le Halo : le plus gros hélicoptère ayant jamais volé, son rotor à huit pales soulève douze soldats à la fois. La réponse de Vanguard au Chinook. Non armé : posez l'escouade loin de la DCA.

catalogue-mi35 =
    .role = Hélicoptère d'assaut
    .lore = Le char volant : un hélicoptère de combat blindé avec canon à chaîne et nacelles de roquettes, et une cabine pour 5 soldats. Il mitraille la zone d'atterrissage, puis y dépose son escouade.

catalogue-mi6 =
    .role = QG du renseignement
    .lore = Quartier général des services secrets britanniques. Débloque l'Espion et les voitures d'espion. Angleterre uniquement, un par joueur, nécessite de l'énergie.

catalogue-mig =
    .role = Avion d'attaque
    .lore = Un avion d'attaque au sol rapide avec des missiles contre bâtiments et véhicules. Frappez, puis retournez à l'aérodrome pour vous réarmer.

catalogue-mlrs =
    .role = Char lance-roquettes
    .lore = Un lance-roquettes multiple chenillé. Il vide tout son panier en quelques secondes, un flot massif de 19 roquettes qui couvre la zone ciblée, puis met longtemps à recharger.

catalogue-mnly =
    .role = Mouilleur de mines
    .lore = Pose des mines antichars et antipersonnel et voit les mines ennemies. Minez les gisements et les points de passage pour faire payer cher chaque attaque.

catalogue-mrj =
    .role = Brouilleur radar
    .lore = Brouille les dômes radar ennemis proches et dévie les missiles guidés entrants. Escortez avec lui vos blindés face aux défenses riches en missiles.

catalogue-msam =
    .role = Défense antiaérienne moyenne portée
    .lore = Une batterie de missiles moyenne portée et votre bouclier anti-roquettes (style Dôme de fer) : dix intercepteurs rapides partent en salve, montent presque à la verticale et détruisent en vol les salves de roquettes et roquettes d'avions, laissant des traînées lumineuses. Il intercepte aussi aéronefs, missiles de croisière et drones. D'énormes salves peuvent encore le saturer pendant qu'il recharge. N'atteint sa portée maximale qu'avec un dôme radar.

catalogue-mslo =
    .role = Superarme
    .lore = Un silo de missile nucléaire. Après une longue charge, il lance une bombe atomique qui rase tout un quartier d'une base ennemie. Un seul exemplaire possible, et tous les adversaires sont prévenus quand il est prêt.

catalogue-msub =
    .role = Sous-marin lance-missiles
    .lore = Une plateforme de siège sous-marine qui tire des missiles sur les bâtiments, unités terrestres et aéronefs loin dans les terres. Faible contre les autres navires.

catalogue-mtnk =
    .role = Char moyen
    .lore = Un char de combat de Vanguard moins cher et plus rapide à construire que le char lourd, avec un canon plus léger.

catalogue-mtrk =
    .role = Écraseur
    .lore = Un tout-terrain civil sur roues géantes, réquisitionné. Il n'a aucune arme : il roule simplement sur l'infanterie, les clôtures et les murs de sacs de sable, et sa cabine et sa benne accueillent une escouade de quatre. États-Unis uniquement.

catalogue-nation-allies =
    .lore = L'arsenal commun de l'Union, partagé par toutes ses nations ; ses parachutistes volent à bord du long C-141 Starlifter.

catalogue-nation-china =
    .lore = Dragon rouge : le super porte-avions Fujian, le chasseur furtif JX-20 et le PHX-16, le lanceur à plus longue portée de tous. Le Y-20 Kunpeng transporte son corps aéroporté.

catalogue-nation-cuba =
    .lore = Forteresse insulaire : de robustes vieux lanceurs Grad tirés en nombre et une défense conçue pour tenir n'importe quel siège. Ses parachutistes volent à bord de vieilles B-29 Superfortress.

catalogue-nation-egypt =
    .lore = Commandement du désert : porte-hélicoptères Mistral bon marché et roquettes à sous-munitions Saqr-36 qui déchiquettent les véhicules légers. Ses brigades aéroportées volent à bord de B-52 Stratofortress réaménagés pour larguer des troupes.

catalogue-nation-england =
    .lore = Maîtres de la tromperie : espions du MI6, voitures d'espion bourrées de gadgets et générateurs de brouillage qui aveuglent l'ennemi. Ses forces aéroportées volent sur C-17A Globemaster III, le plus robuste des transports à réaction.

catalogue-nation-france =
    .lore = Précision et furtivité : roquettes LRX guidées par GPS, chasseurs Rafale et Transport à phase camouflé. Ses parachutistes sautent de C-130 Hercules.

catalogue-nation-germany =
    .lore = Ingénieurs du temps : chars Chrono qui se téléportent à travers la carte et lanceurs MARZ qui sèment des champs de mines. Ses raids aéroportés volent à bord de B-17 Flying Fortress capturées, et l'aile volante HG-229 Nachtflügel emporte ses lourdes bombes guidées.

catalogue-nation-india =
    .lore = Puissance montante : le porte-avions Vikrant de conception nationale et les lanceurs Pinak qui vident leurs nacelles en quelques secondes. Ses parachutistes sautent de l'Il-76MD et de ses canons de queue.

catalogue-nation-iran =
    .lore = Maîtres des drones : le porte-drones Bagheri, les drones d'attaque Shard et le prototype furtif Qahir-X. Ses parachutistes volent à bord d'un Boeing 707 réaménagé.

catalogue-nation-italy =
    .lore = Légion méditerranéenne : le porte-avions léger Cavour et le lance-roquettes Saetta à rechargement rapide. Ses parachutistes décollent de bases d'hydravions à bord du grand hydravion Boeing 314 Clipper.

catalogue-nation-japan =
    .lore = Une marine insulaire : le porte-avions Kaga pour avions à décollage vertical et les camions Sea Arrow qui coulent les navires loin en mer. Ses parachutistes sautent de C-130 Hercules.

catalogue-nation-pakistan =
    .lore = Défenseurs des montagnes : roquettes guidées Fatah qui frappent fort et juste depuis l'arrière du front. Ses parachutistes sautent de C-130 Hercules.

catalogue-nation-russia =
    .lore = Armes Tesla : soldats de choc, chars Tesla, le porte-avions Kouznetsov et le lanceur thermobarique TOZ-1 Sunflare. Ses parachutistes sautent de l'Il-76MD et de ses canons de queue.

catalogue-nation-southkorea =
    .lore = Bouclier de la péninsule : lanceurs Chunmu qui alternent entre salves de roquettes et un missile guidé lourd. Ses parachutistes sautent de C-130 Hercules.

catalogue-nation-soviet =
    .lore = L'arsenal commun de Vanguard, partagé par toutes ses nations ; ses parachutistes volent à bord de B-29 Superfortress copiées rivet pour rivet. Depuis l'héliport, il aligne l'hélicoptère lourd Mi-26 Halo, les hélicoptères de combat Hind et Mi-35 et le Ka-52 Alligator.

catalogue-nation-turkey =
    .lore = Porte des continents : guerre des drones depuis le porte-drones Anadolu, drones d'essaim et lourdes roquettes Kasirga. Ses parachutistes sautent de C-130 Hercules.

catalogue-nation-ukraine =
    .lore = Démolitions : camions de démolition nucléaires, raids de parabombes, l'énorme An-225 et les roquettes de précision Vilkra. Ses parachutistes sautent de l'Il-76MD, dont les deux canons de queue de 23 mm tiennent les chasseurs à distance.

catalogue-nation-usa =
    .lore = L'arsenal de la démocratie de l'Union : la plus grande flotte aérienne au monde, des super porte-avions, le camion lance-roquettes HIMAX et l'AB-35 Longwing qui largue la bombe atomique Fatman. Ses parachutistes volent à bord de C-130 Hercules depuis la base aéroportée.

catalogue-oilr =
    .role = Économie offshore
    .lore = Une plateforme marine qui pompe un filet régulier de crédits, sans camions à protéger. Elle doit être construite sur l'eau près de votre base et cesse de pomper en cas de manque d'énergie. Navires et sous-marins sont sa plus grande menace.

catalogue-pbox =
    .role = Bunker anti-infanterie
    .lore = Une casemate en béton avec une mitrailleuse. Elle repère les unités furtives et fauche les assauts d'infanterie. Associez-la à une tourelle antichar.

catalogue-phx16 =
    .role = Lance-roquettes (Chine)
    .lore = Le lance-roquettes à plus longue portée du jeu. Il pilonne bases et groupes depuis loin derrière le front. Rechargement lent.

catalogue-pinak =
    .role = Lance-roquettes (Inde)
    .lore = Tire toute sa charge de roquettes en quelques secondes. Une salve surprise dévastatrice contre l'infanterie et les bases.

catalogue-powr =
    .role = Production d'énergie
    .lore = L'énergie de base de votre base. Défenses, radar et superarmes s'arrêtent en cas de manque d'énergie : construisez des centrales avant d'en avoir besoin et dispersez-les, car une seule frappe sur un groupe de centrales peut plonger toute la base dans le noir.

catalogue-proc =
    .role = Économie
    .lore = Transforme minerai et gemmes en crédits et est livrée avec un camion de minerai gratuit. Construisez-la près des gisements riches pour raccourcir chaque trajet. Une seconde raffinerie près d'un autre gisement double presque vos revenus.

catalogue-pt =
    .role = Canonnière
    .lore = Un patrouilleur léger et rapide qui détecte les sous-marins et chasse les petits navires. Des yeux bon marché sur l'eau.

catalogue-ptnk =
    .role = Char Prisme
    .lore = Un char à rayon longue portée dont le faisceau de cristal frappe les groupes d'infanterie, de véhicules légers et de bâtiments. Fragile : gardez-le derrière vos blindés lourds.

catalogue-ptwr =
    .role = Défense Prisme
    .lore = Tire un faisceau lumineux de cristal. Les tours Prisme proches se relient et envoient leur énergie à celle qui tire : +40 % de dégâts par tour reliée, jusqu'à +200 %. Construisez-les en groupes.

catalogue-qtnk =
    .role = Char sismique
    .lore = Le char MAD secoue le sol d'ondes sismiques qui détruisent véhicules et structures proches, et se détruit lui-même au passage. Conduisez-le au milieu d'une base ennemie.

catalogue-rgun =
    .role = Robot antiblindé
    .lore = Son canon électromagnétique frappe les blindés à longue portée mais recharge lentement. Gardez-le derrière un écran d'infanterie et laissez-le éliminer les chars un par un.

catalogue-sacm =
    .role = Commandement aérien stratégique
    .lore = Le joyau d'une armée de l'air : un parking pour 10 avions dans une seule enceinte. Un seul exemplaire possible : défendez-le aussi bien que votre chantier de construction.

catalogue-saetta =
    .role = Lance-roquettes (Italie)
    .lore = Un lanceur chenillé moins cher qui recharge plus vite. Plusieurs Saetta tirant à tour de rôle maintiennent une pression constante.

catalogue-sam =
    .role = Défense antiaérienne courte portée
    .lore = Tire des missiles sol-air sur les aéronefs et les drones, et peut abattre certaines roquettes et missiles de croisière. Nécessite de l'énergie.

catalogue-saqr36 =
    .role = Lance-roquettes à sous-munitions (Égypte)
    .lore = Roquettes à sous-munitions qui libèrent des bombettes au-dessus de la cible. Ravageuses contre l'infanterie et les véhicules légers, faibles contre les chars et les bâtiments.

catalogue-sbag =
    .role = Barrière légère
    .lore = Des sacs de sable bon marché qui arrêtent l'infanterie et les véhicules légers et canalisent les assaillants vers vos canons. Les chars les écrasent.

catalogue-sbmb =
    .role = Aérodrome de superarme
    .lore = Une base de bombardiers de style soviétique avec une piste immense, un hangar voûté et une soute à armes thermonucléaires. Elle abrite le Tv-95 Bear et charge la Frappe thermonucléaire tant que le bombardier vit. Russie uniquement, une par joueur.

catalogue-scar =
    .role = Véhicule d'espion
    .lore = Une voiture de luxe avec mitrailleuses cachées et roquettes escamotables, qui transporte un Espion. L'ennemi voit une voiture civile inoffensive jusqu'à ce qu'elle attaque. Nécessite le QG du MI6.

catalogue-scr2 =
    .role = Véhicule d'espion
    .lore = Un grand tourisme classique avec deux mitrailleuses cachées, qui transporte un Espion. Plus robuste et moins cher que la voiture d'espion 1. Nécessite le QG du MI6.

catalogue-sdrn =
    .role = Drone suicide
    .lore = Un drone araignée rapide et bon marché qui fonce sur sa cible et explose. Envoyez-les par vagues contre les colonnes de chars et les armées de robots.

catalogue-sfng =
    .role = Char expérimental
    .lore = Un char cybernétique des laboratoires Project X. Son canon principal projette une lourde décharge électrique qui cuit les blindages de l'intérieur. Un seul peut être déployé.

catalogue-shok =
    .role = Soldat Tesla
    .lore = Infanterie d'élite équipée de bobines Tesla portatives dont les arcs frappent infanterie et véhicules. Le soldat emblématique de la Russie.

catalogue-silo =
    .role = Stockage économique
    .lore = Stockage supplémentaire pour les crédits raffinés. Sans stockage suffisant, le minerai livré au-delà de votre limite est perdu. Bon marché : construisez-en un dès que vos revenus dépassent votre capacité.

catalogue-snip =
    .role = Tireur d'élite
    .lore = Un tireur d'élite longue portée qui tue la plupart des fantassins d'un tir et se cache à l'arrêt. Mortel en couverture, inutile contre les blindés.

catalogue-spdr =
    .role = Marcheur d'assaut
    .lore = Le char araignée à huit pattes de Vanguard trottine jusqu'à portée et lâche de lourds missiles qui plongent sur le mince blindage supérieur des chars. Ses deux lanceurs antiaériens tirent des intercepteurs de style Dôme de fer sur les aéronefs et abattent aussi les roquettes entrantes.

catalogue-spen =
    .role = Production navale
    .lore = Base sous-marine de Vanguard. Construit et répare sous-marins, transports et porte-avions de Vanguard. Doit être construite sur l'eau.

catalogue-spy =
    .role = Infiltrateur
    .lore = Se déguise en soldat ennemi et infiltre les bâtiments : volez des fonds dans une raffinerie, réinitialisez les superarmes, aveuglez un radar ou découvrez des secrets de production. Les chiens percent le déguisement à jour.

catalogue-spyd =
    .role = Défense antiaérienne mobile
    .lore = Un camion avec un affût rotatif incliné de quatre conteneurs : missiles Python à guidage infrarouge pour les cibles proches et missiles Derby à guidage radar, dont le moteur à deux impulsions plane entre les allumages, pour les cibles lointaines. Tous montent haut puis plongent sur les aéronefs, explosant en grosses boules de feu. Inde uniquement.

catalogue-ss =
    .role = Sous-marin d'attaque
    .lore = Plonge hors de vue et torpille les navires. Détecte les autres sous-marins. Ne fait surface que pour tirer.

catalogue-stek =
    .role = Recherche avancée
    .lore = Centre de recherche de Vanguard. Débloque les chars les plus lourds de Vanguard, les armes Tesla et les meilleurs avions.

catalogue-stnk =
    .role = Transport furtif
    .lore = Un transport blindé léger qui se camoufle à l'arrêt et tire des missiles air-sol. Faites passer une escouade d'ingénieurs devant les défenses sans être vu.

catalogue-strd =
    .role = Marcheur d'assaut
    .lore = Un marcheur quadrupède lent de Vanguard avec canon lourd et mitrailleuse. Il traverse l'infanterie et surclasse la plupart des chars.

catalogue-supl =
    .role = Contrôle satellite
    .lore = Contrôle au sol de vos satellites. Si vous perdez toutes vos liaisons, tous vos satellites sont hors ligne jusqu'à ce que vous en construisiez une : construisez-en une de réserve loin du front.

catalogue-syrd =
    .role = Production navale
    .lore = Chantier naval de l'Union. Construit et répare canonnières, destroyers, croiseurs, transports et, pour certaines nations, porte-avions. Doit être construit sur l'eau.

catalogue-taut =
    .role = Robot Tesla
    .lore = Un robot lourd de Vanguard qui projette des éclairs Tesla de ses mains, mortel pour l'infanterie et les robots ennemis.

catalogue-tent =
    .role = Production d'infanterie
    .lore = Caserne de l'Union : entraîne fusiliers, lance-roquettes, ingénieurs, infirmiers et infanterie robotisée. Plusieurs casernes accélèrent l'entraînement. Définissez un point de ralliement pour que les nouvelles escouades marchent droit au front.

catalogue-tiger =
    .role = Hélicoptère d'attaque lourd
    .lore = Le Tigre : un hélicoptère de combat franco-allemand avec missiles antichars HOT sur les pylônes extérieurs et nacelles tirant un flot de roquettes de 68 mm. France et Allemagne uniquement.

catalogue-toz1 =
    .role = Lanceur thermobarique (Russie)
    .lore = Un lanceur thermobarique blindé. Courte portée, mais il calcine infanterie et bâtiments dans une énorme boule de feu.

catalogue-tran =
    .role = Hélicoptère de transport
    .lore = Le Chinook : transporte une escouade d'infanterie n'importe où sur la carte. Non armé : déposez vos troupes loin de la DCA.

catalogue-truk =
    .role = Camion de ravitaillement
    .lore = Apporte des fonds à la raffinerie d'un allié. Non armé. Utilisez-le pour maintenir en jeu un coéquipier en difficulté.

catalogue-tsla =
    .role = Défense Tesla
    .lore = Projette des éclairs qui détruisent infanterie et véhicules. Consomme beaucoup d'énergie, et une panne l'éteint : protégez vos centrales.

catalogue-ttnk =
    .role = Char Tesla
    .lore = Un char équipé d'une bobine Tesla dont les arcs frappent infanterie, véhicules et bâtiments. La réponse de la Russie aux blindés en masse.

catalogue-tu95 =
    .role = Bombardier thermonucléaire
    .lore = Le Bear : un bombardier à long rayon d'action doté de quatre moteurs à hélices contrarotatives. Non armé, il n'a qu'une mission : quand la Frappe thermonucléaire est prête, il largue la bombe H RDS-37 et rentre à la base. Perdez-le et le compte à rebours repart de zéro. Russie uniquement, un par joueur.

catalogue-type12 =
    .role = Missiles antinavires (Japon)
    .lore = Un camion lance-missiles qui frappe les navires loin en mer. Postez-le sur la côte et les flottes ennemies ne pourront pas approcher.

catalogue-v2rl =
    .role = Artillerie à roquettes
    .lore = Tire une énorme roquette qui dévaste infanterie et bâtiments à longue portée. Rechargement lent, vulnérable à tout ce qui l'atteint.

catalogue-vilkra =
    .role = Lance-roquettes (Ukraine)
    .lore = Roquettes de précision longue portée qui frappent bâtiments, infanterie et véhicules avec une précision chirurgicale. Rechargement lent.

catalogue-weap =
    .role = Production de véhicules
    .lore = Construit tous les chars, transports et lance-roquettes. Ajoutez un dépôt de maintenance et un dôme radar pour débloquer les modèles plus lourds, dont le lance-roquettes propre à votre nation.

