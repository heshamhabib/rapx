    .tooltip = Déployer
    .tooltipdesc =
        Les unités sélectionnées effectuent leur action de déploiement
        - Les VCM se déploient en chantier de construction
        - Les chantiers de construction se replient en VCM
        - Les transports débarquent leurs passagers
        - Les camions de démolition et chars MAD s'autodétruisent
        - Les mouilleurs de mines posent une mine
        - Les aéronefs retournent à la base
        Agit immédiatement sur les unités sélectionnées.

button-command-bar-force-attack =
    .tooltip = Attaque forcée
    .tooltipdesc =
        Les unités sélectionnées attaquent l'unité ou la zone ciblée
        - L'action par défaut sur la cible est ignorée
        - Permet de cibler ses propres forces ou celles des alliés
        - L'artillerie à longue portée cible toujours la
        zone, sans tenir compte des unités et bâtiments
        Clic gauche sur l'icône puis clic droit sur la cible.
        Maintenez <(Ctrl)> pour l'activer temporairement en donnant des ordres.

button-command-bar-force-move =
    .tooltip = Déplacement forcé
    .tooltipdesc =
        Les unités sélectionnées se rendent à la destination
        - L'action par défaut sur la cible est ignorée
        - Les véhicules tentent d'écraser les ennemis sur place
