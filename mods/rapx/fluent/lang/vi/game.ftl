dialog-incompatible-replay =
    .title = Bản ghi Không tương thích
    .prompt = Không thể đọc dữ liệu bản ghi.
    .confirm = OK
    .prompt-unknown-version = { -incompatible-replay-recorded } một phiên bản không xác định.
    .prompt-unknown-mod = { -incompatible-replay-recorded } một mod không xác định.
    .prompt-unavailable-mod = { -incompatible-replay-recorded } một mod không khả dụng: { $mod }.
    .prompt-incompatible-version =
        { -incompatible-replay-recorded } một phiên bản không tương thích:
        { $version }.
    .prompt-unavailable-map =
        { -incompatible-replay-recorded } một bản đồ không khả dụng:
        { $map }.

