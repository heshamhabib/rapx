catalogue-1tnk =
    .role = Xe tăng nhẹ
    .lore = Nhanh và rẻ, lý tưởng để trinh sát, quấy rối xe tải quặng và bắt gọn xe hạng nhẹ. Nó thua thiệt khi đối đầu trực diện với xe tăng hạng nặng hơn.

catalogue-2tnk =
    .role = Xe tăng chủ lực
    .lore = Xe tăng chủ lực của Liên minh: cân bằng tốt giữa tốc độ, giáp và hỏa lực. Tập hợp chúng cùng lính rocket và Pháo Flak Cơ động để có một đội quân hoàn chỉnh.

catalogue-3tnk =
    .role = Xe tăng hạng nặng
    .lore = Xe tăng chủ lực của Tiên phong với pháo đôi hạng nặng. Chậm hơn xe tăng Liên minh nhưng gây sát thương mạnh hơn nhiều. Thắng thế trong các trận đấu tăng trực diện.

catalogue-4tnk =
    .role = Xe tăng siêu nặng
    .lore = Mammoth: pháo đôi để diệt xe tăng, cụm tên lửa để chống máy bay và bộ binh, giáp dày và tự sửa chữa khi bị hư hại. Chậm và đắt tiền, nhưng có thể húc đổ cả tường bê tông.

catalogue-abas =
    .role = Căn cứ không quân lớn
    .lore = Một sân bay lớn hơn với chỗ đậu cho 6 máy bay. Mở rộng phi đội của bạn mà không cần dàn trải nhiều bệ đỗ khắp căn cứ.

catalogue-abrn =
    .role = Căn cứ không vận, 3 bệ đỗ vận tải cơ
    .lore = Căn cứ của các lữ đoàn lính dù: doanh trại, nhà xếp dù và ba bệ đỗ cho vận tải cơ hạng nặng, mỗi chiếc chở 40 lính đến bất kỳ đâu trên bản đồ.

catalogue-afbs =
    .role = Căn cứ không lực
    .lore = Một căn cứ không lực đầy đủ với chỗ đậu cho 8 máy bay, dành cho một phi đội tấn công hùng hậu.

catalogue-afld =
    .role = Căn cứ không quân
    .lore = Sản xuất và nạp lại máy bay phản lực, với chỗ đậu cho 4 máy bay. Nó cũng mở khóa sức mạnh hỗ trợ Máy bay Trinh sát và Lính dù. Tiêm kích quay về đây để nạp đạn sau mỗi phi vụ.

catalogue-agun =
    .role = Phòng không tầm gần
    .lore = Một khẩu pháo flak xé nát máy bay, drone và tên lửa hành trình bay tới ở tầm gần. Nó cần điện. Bố trí quanh căn cứ để chống máy bay ném bom.

catalogue-apc =
    .role = Xe vận tải bọc thép
    .lore = Chở một toán bộ binh dưới lớp giáp bảo vệ và hỗ trợ họ bằng súng máy. Thả kỹ sư vào căn cứ địch hoặc đưa nhanh lính rocket ra tiền tuyến.

catalogue-apwr =
    .role = Phát điện công suất lớn
    .lore = Sản lượng điện gấp đôi một Nhà máy Điện trên diện tích lớn hơn. Mục tiêu hàng đầu của máy bay ném bom địch, nên hãy bảo vệ nó bằng phòng không.

catalogue-arty =
    .role = Pháo binh
    .lore = Lựu pháo tầm xa nã đạn vào công trình phòng thủ và bộ binh từ ngoài tầm phản công của chúng. Rất yếu ớt ở cự ly gần, nên luôn cần có lực lượng hộ tống.

catalogue-asat =
    .role = Chống vệ tinh
    .lore = Bắn hạ vệ tinh địch bay ngang qua trong phạm vi 12 ô. Nó không thể bắn trúng quân mặt đất hoặc máy bay. Tuyến phòng thủ duy nhất của bạn trước mạng lưới laser quỹ đạo.

catalogue-atek =
    .role = Nghiên cứu cao cấp
    .lore = Trung tâm nghiên cứu của Liên minh. Nó mở khóa những vũ khí tiên tiến nhất của Liên minh và phóng Vệ tinh GPS, hiện lộ toàn bộ bản đồ.

catalogue-aw101 =
    .role = Trực thăng vận tải hạng nặng
    .lore = Merlin: trực thăng ba động cơ tốc độ cao, chở mười lính đi quãng đường xa. Chỉ Ấn Độ.

catalogue-b17t =
    .role = Vận tải cơ đường không, 40 lính dù
    .lore = Một chiếc Flying Fortress bị thu giữ, giống những chiếc phi đội đặc biệt thời chiến dùng để thả điệp viên sau phòng tuyến địch.

catalogue-b29t =
    .role = Vận tải cơ đường không, 40 lính dù
    .lore = Chiếc Superfortress mà Tiên phong sao chép từng con tán rivet, khoang bom giờ đây chất đầy lính dù.

catalogue-b314 =
    .role = Vận tải cơ đường không, 40 lính dù
    .lore = Một chiếc thủy phi cơ khổng lồ của thời đại clipper, chở lính dù của Ý từ các căn cứ thủy phi cơ.

catalogue-b52t =
    .role = Vận tải cơ đường không, 40 lính dù
    .lore = Một chiếc Stratofortress đã tháo bỏ khoang bom và cải tạo để thả một toán 40 lính dù.

catalogue-barr =
    .role = Sản xuất bộ binh
    .lore = Doanh trại Tiên phong: huấn luyện lính nghĩa vụ, lính lựu đạn, lính phun lửa, Lính Tesla và các bộ giáp trợ lực Vệ binh Sắt. Nhiều doanh trại sẽ tăng tốc huấn luyện.

catalogue-bb =
    .role = Thiết giáp hạm
    .lore = Những khẩu pháo lớn nhất trên biển: tháp pháo ba nòng 16 inch ở mũi và đuôi tàu, nã đạn vào bờ biển từ ngoài tầm phản công của hầu hết công trình phòng thủ. Chậm và rất khó đánh chìm, nhưng mù trước tàu ngầm.

catalogue-bdrd =
    .role = Robot chiến đấu
    .lore = Robot giá rẻ của Liên minh trang bị súng blaster, được sản xuất hàng loạt. Dùng chúng để áp đảo bộ binh địch và hứng hỏa lực thay quân khác.

catalogue-bmbf =
    .role = Sân bay siêu vũ khí
    .lore = Một sân bay ném bom được canh gác chặt chẽ, có một bệ đỗ khổng lồ, một nhà chứa máy bay và một hầm bom bọc thép. Nó là nơi đồn trú của chiếc AB-35 Longwing và nạp năng lượng cho Đòn Fatman khi máy bay ném bom còn sống. Chỉ Hoa Kỳ, mỗi người chơi 1 cái.

catalogue-bmd =
    .role = Phòng thủ tên lửa đạn đạo
    .lore = Lớp THAAD. Nó đánh chặn tên lửa đạn đạo và siêu vượt âm ở độ cao và khoảng cách lớn, là câu trả lời cho các đòn tấn công bằng tên lửa đạn đạo (còn rocket thì để SAM Tầm trung xử lý). Cần Mái vòm Radar để đạt tầm bắn tối đa.

catalogue-brik =
    .role = Rào chắn hạng nặng
    .lore = Những bức tường bê tông chặn đứng mọi đơn vị mặt đất và cản hỏa lực địch. Chỉ Xe tăng Mammoth mới có thể húc đổ chúng. Dùng chúng để bảo vệ nhà máy điện và nhà máy tinh luyện.

catalogue-btr =
    .role = Xe vận tải bọc thép
    .lore = Xe bọc thép chở quân tám bánh với pháo tự động trên tháp pháo: di chuyển nhanh trên đường, thả 5 bộ binh ở tiền tuyến và tiếp tục khai hỏa. Chỉ Nga.

catalogue-c130 =
    .role = Vận tải cơ đường không, 40 lính dù
    .lore = Hercules: cỗ máy bốn động cơ chủ lực của lực lượng không vận từ Hoa Kỳ đến Pháp, Nhật Bản, Hàn Quốc, Thổ Nhĩ Kỳ và Pakistan.

catalogue-c141 =
    .role = Vận tải cơ đường không, 40 lính dù
    .lore = Chiếc phản lực thân dài đã chuyên chở các sư đoàn không vận của Liên minh suốt nhiều thập kỷ.

catalogue-c17 =
    .role = Vận tải cơ đường không, 40 lính dù
    .lore = Máy bay vận tải chiến lược của Không quân Hoàng gia Anh: bốn động cơ turbofan, khoang hàng khổng lồ và thả một toán 40 lính qua cửa hông.

catalogue-ca =
    .role = Tuần dương hạm
    .lore = Một chiến hạm rất chậm với những khẩu pháo tầm xa khổng lồ, nã đạn vào căn cứ ven biển từ ngoài khơi xa. Hộ tống nó bằng khu trục hạm để chống tàu ngầm.

catalogue-cg =
    .role = Tuần dương hạm tên lửa
    .lore = Một tuần dương hạm tên lửa dẫn đường: tên lửa Tomahawk vươn tới mục tiêu sâu trong đất liền, trong khi SAM và pháo cận chiến của nó bảo vệ hạm đội trước các cuộc tấn công từ trên không. Chỉ Hoa Kỳ.

catalogue-chunmu =
    .role = Bệ phóng rocket (Hàn Quốc)
    .lore = Một bệ phóng bánh lốp hạng nặng với loạt 6 rocket. Triển khai để chuyển sang bắn một tên lửa dẫn đường hạng nặng với tầm bắn xa hơn.

catalogue-croc =
    .role = Kẻ săn mồi phục kích
    .lore = Kẻ săn mồi lâu đời nhất của sông Nile, được Ai Cập nuôi dưỡng và huấn luyện. Nó đi trên cạn, bơi nhanh hơn đi bộ, và nằm im dưới nước chỉ để lộ đôi mắt, không ai thấy được cho đến khi nó ra đòn. Một cú lao tới và một cú cắn là đủ để hạ gục một người lính hay một con chó; rồi nó dừng lại để nuốt chửng con mồi. Lớp da đầy vảy của nó chống chịu được đạn súng trường. Chỉ Ai Cập.

catalogue-ctnk =
    .role = Xe tăng Chrono
    .lore = Bắn tên lửa đối đất và có thể dịch chuyển tức thời đến bất kỳ đâu trong tầm. Dịch chuyển ra sau phòng tuyến địch để tấn công pháo binh và nhà máy tinh luyện, rồi dịch chuyển đi ngay.

catalogue-cv1 =
    .role = Tàu sân bay hạm đội
    .lore = Một tàu sân bay lớp Essex từ Thế chiến thứ hai: một căn cứ không quân nổi với bệ phóng SAM để phòng thủ. Phóng và nạp lại đạn cho máy bay phản lực ngay trên biển.

catalogue-cv2 =
    .role = Tàu sân bay chiến đấu
    .lore = Tàu sân bay chạy năng lượng hạt nhân đầu tiên, lớp Enterprise: sàn đáp lớn hơn, thân tàu chắc chắn hơn và nhiều bệ phóng SAM hơn.

catalogue-cv3 =
    .role = Siêu Tàu sân bay
    .lore = Một siêu tàu sân bay hạt nhân lớp Nimitz, kỳ hạm giáp dày của hạm đội.

catalogue-cv4 =
    .role = Siêu tàu sân bay thế hệ mới
    .lore = Một tàu sân bay lớp Gerald R. Ford với hệ thống phòng thủ hiện đại nhất. Chiến hạm mạnh nhất đang hoạt động.

catalogue-cvcn =
    .role = Siêu tàu sân bay (Trung Quốc)
    .lore = Fujian: siêu tàu sân bay mới nhất của Trung Quốc, trang bị máy phóng điện từ.

catalogue-cveg =
    .role = Tàu sân bay trực thăng (Ai Cập)
    .lore = Mistral: tàu sân bay trực thăng đổ bộ. Rẻ và đóng nhanh.

catalogue-cvfr =
    .role = Tàu sân bay (Pháp)
    .lore = Charles de Gaulle, tàu sân bay chạy năng lượng hạt nhân của Pháp và là niềm tự hào của Hải quân Pháp.

catalogue-cvgb =
    .role = Tàu sân bay (Anh)
    .lore = Tàu sân bay Queen Elizabeth của Hải quân Hoàng gia Anh, với mũi tàu kiểu ski-jump và hai đảo chỉ huy.

catalogue-cvin =
    .role = Tàu sân bay (Ấn Độ)
    .lore = Vikrant: tàu sân bay tự đóng trong nước của Ấn Độ với mũi tàu kiểu ski-jump.

catalogue-cvir =
    .role = Tàu sân bay drone (Iran)
    .lore = Bagheri: một tàu buôn được hoán cải với sàn đáp cho drone. Rẻ, nhưng mỏng manh.

catalogue-cvit =
    .role = Tàu sân bay hạng nhẹ (Ý)
    .lore = Cavour: tàu sân bay hạng nhẹ của Ý dành cho máy bay cất cánh thẳng đứng và trực thăng.

catalogue-cvjp =
    .role = Tàu sân bay hạng nhẹ (Nhật Bản)
    .lore = Kaga: khu trục hạm trực thăng được cải tạo thành tàu sân bay hạng nhẹ cho tiêm kích cất cánh thẳng đứng.

catalogue-cvru =
    .role = Tàu sân bay (Nga)
    .lore = Kuznetsov: tuần dương hạm mang máy bay hạng nặng với mũi tàu kiểu ski-jump và hệ thống phòng không SAM mạnh.

catalogue-cvsu =
    .role = Tuần dương hạm hàng không
    .lore = Kiev: nửa tàu sân bay, nửa tuần dương hạm, với sàn đáp ở đuôi tàu và bệ phóng tên lửa ở mũi tàu.

catalogue-cvtr =
    .role = Tàu sân bay drone (Thổ Nhĩ Kỳ)
    .lore = Anadolu: tàu đổ bộ được chuyển đổi thành tàu sân bay drone, phóng ra bầy drone tấn công.

catalogue-cybt =
    .role = Bộ binh cyborg
    .lore = Một cyborg bọc thép của Liên minh trang bị súng ngắn tự động hạng nặng. Nó không thể bị xe tăng cán và không bao giờ cần nấp. Một lính giữ tuyến kiên cường.

catalogue-dd =
    .role = Khu trục hạm
    .lore = Một chiến hạm đa năng tốc độ cao, phát hiện tàu ngầm và giao chiến với tàu chiến, xe cơ giới và máy bay. Xương sống của hạm đội Liên minh.

catalogue-dog =
    .role = Chó tấn công
    .lore = Nhanh và rẻ, nó giết bộ binh chỉ bằng một cú cắn và đánh hơi ra gián điệp cải trang. Giữ một cặp ở nhà làm thợ săn gián điệp.

catalogue-dome =
    .role = Tình báo
    .lore = Bật radar thu nhỏ trên bản đồ và mở khóa hầu hết đơn vị cùng công trình phòng thủ tầm trung. Nó cũng giúp SAM tầm xa của bạn đạt tầm bắn tối đa. Mất nó sẽ khiến bạn mù thông tin, nên hãy bảo vệ nó cẩn thận.

catalogue-dtrk =
    .role = Xe bom hạt nhân
    .lore = Một chiếc xe tải mang đầu đạn hạt nhân đã kích hoạt với lớp giáp mỏng như giấy. Lái nó vào căn cứ địch và kích nổ. Nó sẽ phá hủy mọi thứ xung quanh, kể cả đơn vị của chính bạn.

catalogue-e1 =
    .role = Bộ binh súng trường
    .lore = Xương sống của mọi đội quân: rẻ, huấn luyện nhanh và hiệu quả trước bộ binh khác. Đưa họ vào đồn trú trong lô cốt, hoặc tập hợp số đông để che chắn xe tăng của bạn khỏi lính rocket.

catalogue-e2 =
    .role = Lính Lựu đạn
    .lore = Ném lựu đạn gây sát thương diện rộng lên nhóm bộ binh và làm hư hại công trình. Lựu đạn của họ có thể gây hại cho đơn vị phe mình ở gần, nên hãy giữ họ phía sau tiền tuyến.

catalogue-e3 =
    .role = Chống tăng / phòng không
    .lore = Rocket vác vai bắn trúng cả xe bọc thép lẫn máy bay. Giá rẻ, là câu trả lời của bộ binh trước xe tăng và trực thăng, nhưng dễ trở thành mồi ngon cho súng máy.

catalogue-e4 =
    .role = Lính phun lửa
    .lore = Súng phun lửa tầm gần thiêu cháy bộ binh đang ẩn nấp và đốt cháy công trình. Mạnh khi dọn sạch boong-ke và tấn công căn cứ.

catalogue-e6 =
    .role = Kỹ sư
    .lore = Chiếm công trình địch, sửa chữa công trình của bạn và sửa cầu bị hỏng. Hộ tống họ vào căn cứ địch và chiếm một Nhà máy Chiến xa hoặc Trung tâm Công nghệ để đánh cắp công nghệ.

catalogue-e7 =
    .role = Biệt kích tinh nhuệ
    .lore = Tanya: hai súng ngắn hạ gục bộ binh chỉ bằng một phát, và thuốc nổ C4 san phẳng bất kỳ công trình nào cô tiếp cận được. Chỉ có thể triển khai 1 người. Giữ cô tránh xa xe tăng và chó.

catalogue-e8c =
    .role = Vận tải cơ đường không, 40 lính dù
    .lore = Một khung thân Boeing 707 loại mà không quân Iran đã sử dụng suốt nửa thế kỷ, được cải tạo để chở quân.

catalogue-elph =
    .role = Cỗ máy voi chiến
    .lore = Voi chiến bọc thép của Ấn Độ: một pháo đài di động trên bốn chân thép, với pháo đôi hạng nặng trên lưng bắn hết loạt đạn này đến loạt khác. Binh lính không thể né nó như né xe tăng: bất cứ ai ở dưới chân nó đều bị giẫm nát. Chậm và tốn kém, nhưng rất khó ngăn chặn. Chỉ Ấn Độ.

catalogue-enfw =
    .role = Cỗ máy tấn công
    .lore = Một cỗ máy hai chân hạng nặng của Liên minh. Pháo tự động đôi trên hai tay xé nát bộ binh và cụm rocket trên vai xuyên phá giáp. Một pháo đài di động để phá vỡ phòng tuyến địch.

catalogue-fact =
    .role = Chỉ huy căn cứ
    .lore = Trái tim của mọi căn cứ. Nó xây dựng mọi công trình khác và xác định bán kính xây dựng của bạn, nên mất nó sẽ ngừng mọi sự mở rộng. Hãy giữ nó sâu trong vòng phòng thủ, và nếu phòng chờ cho phép, hãy gấp nó lại thành MCV để di chuyển căn cứ.

catalogue-fajir5 =
    .role = Bệ phóng rocket (Iran)
    .lore = Tầm bắn xa với giá rẻ, nhưng thiếu chính xác. Triển khai để chuyển sang dùng 2 drone tấn công Shard-136 với tầm bắn rất xa.

catalogue-fatah =
    .role = Bệ phóng rocket (Pakistan)
    .lore = Rocket dẫn đường tầm xa, chính xác cao trước cả công trình, bộ binh lẫn xe cơ giới. Nạp đạn chậm.

catalogue-fenc =
    .role = Rào chắn hạng nhẹ
    .lore = Dây thép gai chặn bộ binh và xe hạng nhẹ. Xe tăng có thể cán qua.

catalogue-fix =
    .role = Sửa chữa dã chiến
    .lore = Sửa chữa xe cơ giới lái vào bệ đỗ của nó, có thu phí. Nó cũng mở khóa xe cơ giới cao cấp. Đặt nó giữa Nhà máy Chiến xa và tiền tuyến để xe tăng hư hại nhanh chóng quay lại chiến đấu.

catalogue-flak =
    .role = Phòng thủ phòng không
    .lore = Một khẩu pháo flak đôi hạng nặng trên bệ xoay. Loạt đạn của nó gây sát thương cho mọi máy bay lân cận, và có thể hạ gục drone cùng tên lửa hành trình.

catalogue-ftrk =
    .role = Phòng không cơ động
    .lore = Một khẩu pháo flak gắn trên xe tải, xé nát máy bay, drone và bộ binh. Luôn mang theo một chiếc cùng mỗi đoàn xe bọc thép.

catalogue-ftur =
    .role = Tháp chống bộ binh
    .lore = Tưới nhiên liệu cháy lên bất cứ ai đến gần. Nó tiêu diệt bộ binh và xe hạng nhẹ, nhưng tầm bắn ngắn và không thể chạm tới xe tăng từ xa.

catalogue-gap =
    .role = Phản gián
    .lore = Bao phủ căn cứ của bạn trong màn sương để địch không thể thấy bên trong. Trinh sát và máy bay gián điệp chỉ hiện lộ nó trong chốc lát. Nó cần điện.

catalogue-godz =
    .role = Titan: siêu vũ khí di động
    .lore = Một ngọn núi vảy lội ra từ biển khơi. Khi các tấm vảy lưng của nó phát sáng màu hồng, mọi thứ phía trước sắp bị thiêu rụi: hơi thở nguyên tử của nó vươn xa hơn hầu hết pháo binh và hạ gục cả máy bay trên không. Xe tăng đến gần sẽ bị giẫm nát. Được chọn trong phòng chờ, mỗi người chơi 1 con, và khi nó gục ngã thì sẽ mất vĩnh viễn.

catalogue-grad =
    .role = Bệ phóng rocket (Cuba)
    .lore = Một bệ phóng Grad cũ: rẻ nhưng thiếu chính xác. Tập hợp số đông và trút rocket ngập một khu vực.

catalogue-gun =
    .role = Tháp súng chống giáp
    .lore = Một tháp pháo xoay xuyên thủng xe tăng. Rẻ và đáng tin cậy, nhưng yếu trước bộ binh đông đảo và bất lực trước máy bay.

catalogue-gurz =
    .role = Phòng không cơ động
    .lore = Một xe tải tám bánh hạng nặng mang mô-đun chiến đấu xoay: hai cụm tên lửa hồng ngoại nhỏ và một khẩu pháo 35 mm ở giữa. Nó bắn ra bốn tên lửa cùng lúc, mỗi quả xoáy chặt trong không trung, và ngòi nổ cận đích của chúng bùng lên thành những đám khói flak đen. Các quốc gia Tiên phong trừ Ấn Độ.

catalogue-hailstorm =
    .role = Bệ phóng rocket (Anh)
    .lore = Một bệ phóng bánh xích bắn loạt 12 rocket lớn trên diện rộng. Mạnh trước bộ binh và căn cứ, nhưng chậm.

catalogue-harv =
    .role = Xe tải quặng
    .lore = Thu thập quặng và đá quý rồi mang về nhà máy tinh luyện của bạn. Giáp dày, nhưng không vũ trang. Hãy bảo vệ xe tải của bạn: chúng chính là nguồn thu của bạn.

catalogue-hbox =
    .role = Boong-ke ngụy trang
    .lore = Một lô cốt được ngụy trang kín đáo. Địch không thấy nó cho đến khi đến gần, nên đây là điểm phục kích hoàn hảo trên tuyến đường tấn công tiềm năng.

catalogue-hcru =
    .role = Tuần dương hạm trực thăng
    .lore = Một tuần dương hạm với sàn đáp trực thăng ở đuôi tàu: tên lửa và súng gatling chống máy bay, bom chìm và sonar chống tàu ngầm.

catalogue-heli =
    .role = Trực thăng tấn công
    .lore = Longbow: trực thăng vũ trang tên lửa săn lùng xe tăng, công trình và máy bay khác. Đánh rồi rút, sau đó quay về Sân đỗ Trực thăng để nạp lại đạn.

catalogue-himax =
    .role = Bệ phóng rocket (Hoa Kỳ)
    .lore = Một bệ phóng bánh lốp tốc độ cao với rocket dẫn đường tầm xa. Nó bắn rồi chạy, rời đi ngay sau mỗi lần phóng, nên hỏa lực phản công thường chỉ trúng vào khoảng không.

catalogue-hind =
    .role = Trực thăng tấn công
    .lore = Hind: trực thăng vũ trang hạng nặng với súng máy quét sạch bộ binh và xe hạng nhẹ.

catalogue-hlfr =
    .role = Xe rocket
    .lore = Một bệ phóng rocket đa nòng trên bánh lốp với dàn ống phóng kín. Nó bắn ra 30 rocket nhẹ thành một loạt dài trùm kín khu vực mục tiêu, rồi nạp lại đạn.

catalogue-hmmv =
    .role = Xe trinh sát
    .lore = Cỗ máy chủ lực của Lục quân Hoa Kỳ: bọc thép, nhanh nhẹn, với súng .50 cal trên nóc và chỗ cho một tổ 4 lính. Chỉ Hoa Kỳ.

catalogue-hpad =
    .role = Căn cứ trực thăng
    .lore = Sản xuất và nạp lại đạn cho trực thăng của cả hai phe: Chinook, Black Hawk và Longbow của Liên minh, Mi-26, Hind, Mi-35 và Ka-52 của Tiên phong. Mỗi bệ đỗ chỉ phục vụ một trực thăng tại một thời điểm, nên hãy xây thêm một cái cho mỗi trực thăng vũ trang bạn định triển khai.

catalogue-il76 =
    .role = Vận tải cơ đường không, 40 lính dù
    .lore = Candid: máy bay vận tải phản lực hạng nặng của Ukraina, Nga và Ấn Độ. Nó thả một toán 40 lính dù sau phòng tuyến địch và giữ tiêm kích địch tránh xa đuôi bằng súng đôi 23 mm.

catalogue-irgd =
    .role = Bộ binh giáp trợ lực
    .lore = Một lính Tiên phong mặc bộ giáp trợ lực với súng máy hạng nặng dùng băng đạn dây. Xe tăng không thể cán nó, và nó quét sạch bộ binh.

catalogue-iron =
    .role = Siêu vũ khí
    .lore = Khiến một nhóm đơn vị hoặc công trình bất tử trong một thời gian ngắn. Tính toán thời điểm cùng một đợt tấn công bằng xe tăng để mũi nhọn tiến công trở nên bất khả xâm phạm.

catalogue-jeep =
    .role = Xe trinh sát
    .lore = Ranger: xe trinh sát tốc độ cao với súng máy, chở theo một lính. Dùng nó để trinh sát, truy đuổi bộ binh và săn xe tải quặng.

catalogue-jet-a10 =
    .role = Cường kích mặt đất, cấp 3
    .lore = Thunderhog: một "xe tăng bay" được chế tạo quanh một khẩu pháo quay cỡ lớn. Giáp dày, chậm và gây chết chóc cho xe bọc thép. Hãy giữ tiêm kích tránh xa nó.

catalogue-jet-an225 =
    .role = Vận tải hạng nặng, cấp 4
    .lore = An-225 Dreamer: chiếc máy bay lớn nhất từng được chế tạo. Nó chở bộ binh khắp bản đồ. Không vũ trang.

catalogue-jet-b2 =
    .role = Máy bay ném bom tàng hình, cấp 5
    .lore = Wraith: máy bay ném bom tàng hình kiểu cánh bay, mang tải trọng bom khổng lồ sâu sau phòng tuyến địch.

catalogue-jet-b52 =
    .role = Máy bay ném bom hạng nặng, cấp 2
    .lore = Stratoforce: máy bay ném bom rải thảm khổng lồ, san phẳng cả một khu vực căn cứ. Hãy hộ tống nó, vì nó không thể tự vệ trước tiêm kích địch.

catalogue-jet-f104 =
    .role = Máy bay đánh chặn, cấp 2
    .lore = Starflash: máy bay đánh chặn mũi nhọn thời Chiến tranh Lạnh, được chế tạo cho tốc độ thuần túy. Tên lửa của nó gây sát thương mạnh lên công trình và xe cơ giới, nhưng giáp rất mỏng.

catalogue-jet-f117 =
    .role = Tấn công tàng hình, cấp 3
    .lore = Nightjar: tiêm kích tàng hình nhiều mặt, len lỏi qua hệ thống phòng không để tấn công các mục tiêu giá trị cao.

catalogue-jet-f14 =
    .role = Máy bay đánh chặn, cấp 3
    .lore = Bobcat: máy bay bảo vệ hạm đội cánh cụp xòe với tên lửa tầm xa. Chỉ được Hoa Kỳ và Iran sử dụng.

catalogue-jet-f16 =
    .role = Tiêm kích đa năng, cấp 3
    .lore = Fighting Kestrel: tiêm kích đa năng nhẹ, nhanh nhẹn. Hiệu quả cao khi tấn công xe cơ giới và công trình.

catalogue-jet-f2 =
    .role = Tiêm kích tấn công hải quân, cấp 4
    .lore = Zero Viper: tiêm kích tấn công tự chế tạo của Nhật Bản, một biến thể Falcon kéo dài với cánh lớn hơn, chuyên để săn tàu chiến ngoài khơi xa.

catalogue-jet-f22 =
    .role = Tiêm kích tàng hình, cấp 5
    .lore = Raptorex: tiêm kích tàng hình thế hệ thứ năm và là máy bay chiếm ưu thế trên không tốt nhất của Liên minh. Nhanh, khó bị phát hiện và chết chóc.

catalogue-jet-f4 =
    .role = Máy bay đánh chặn, cấp 2
    .lore = Spectre II: tiêm kích hai động cơ bền bỉ, được nhiều quốc gia sử dụng hơn bất kỳ máy bay phản lực nào khác trong trò chơi. Sức mạnh tấn công đáng tin cậy với mức giá hợp lý.

catalogue-jet-gapgen =
    .role = Máy tạo vùng mù bay
    .lore = Một máy bay radar không vũ trang che giấu mặt đất bên dưới nó khỏi tầm nhìn địch. Ra lệnh bay đến một khu vực để nó bay vòng tại đó. Dùng nó để yểm trợ một đợt tấn công bằng xe tăng.

catalogue-jet-grom =
    .role = Nguyên mẫu drone chiến đấu
    .lore = Grom-K: drone chiến đấu không người lái của Nga. Rẻ, mỏng manh và nguy hiểm với bộ binh. Mỗi người chơi 1 chiếc.

catalogue-jet-harrier =
    .role = Máy bay cất cánh thẳng đứng VTOL, cấp 3
    .lore = Harrow cất cánh thẳng đứng từ những bệ đỗ nhỏ và sàn tàu sân bay, gây sát thương mạnh lên xe cơ giới.

catalogue-jet-he177 =
    .role = Máy bay ném bom hạng nặng, cấp 0
    .lore = Greif: máy bay ném bom bốn động cơ thời chiến của Đức, các cặp động cơ dẫn động hai cánh quạt lớn, vẫn mang tải trọng bom nặng nề.

catalogue-jet-ho229 =
    .role = Máy bay ném bom tàng hình, cấp 5
    .lore = Nachtflügel: máy bay ném bom phản lực kiểu cánh bay của Đức, ra đời từ thiết kế thời chiến của anh em nhà Horten và cuối cùng được chế tạo với động cơ hiện đại cùng tải trọng bom dẫn đường hạng nặng.

catalogue-jet-j20 =
    .role = Tiêm kích tàng hình, cấp 5
    .lore = JX-20 Jade Dragon: tiêm kích tàng hình thế hệ thứ năm của Trung Quốc, tầm bắn xa và khó bị phát hiện.

catalogue-jet-l39 =
    .role = Cường kích hạng nhẹ, cấp 2
    .lore = L-39U Albatross: máy bay huấn luyện tấn công hạng nhẹ, hiệu quả bất ngờ trước bộ binh, giáp nhẹ và drone.

catalogue-jet-la11 =
    .role = Tiêm kích động cơ piston, cấp 0
    .lore = LaV-11 Fang: tiêm kích động cơ hình sao bền bỉ từ thập niên 1940. Rẻ và nhanh để triển khai số đông.

catalogue-jet-m2000 =
    .role = Tiêm kích đa năng, cấp 3
    .lore = Mirago 2000: tiêm kích đa năng cánh tam giác thanh thoát, được nhiều quốc gia sử dụng.

catalogue-jet-mig21 =
    .role = Tiêm kích phản lực, cấp 2
    .lore = MiK-21 Fishbone: máy bay phản lực được sử dụng rộng rãi nhất trong khối Tiên phong. Đơn giản, nhanh và rẻ.

catalogue-jet-mig23 =
    .role = Tiêm kích đa năng, cấp 3
    .lore = MiK-23 Flintlock: tiêm kích-ném bom cánh cụp xòe, tấn công nhanh và rút nhanh.

catalogue-jet-mig25 =
    .role = Máy bay đánh chặn, cấp 3
    .lore = MiK-25 Foxbane: máy bay đánh chặn tầm cao với tốc độ đáng sợ. Rất ít thứ có thể đuổi kịp nó.

catalogue-jet-mig3 =
    .role = Tiêm kích động cơ piston, cấp 0
    .lore = MiK-3 Strela: tiêm kích cánh quạt thập niên 1940. Rẻ và đóng nhanh, hiệu quả khi quét bộ binh và xe hạng nhẹ.

catalogue-jet-qaher =
    .role = Nguyên mẫu tàng hình
    .lore = Qahir-X: tiêm kích tàng hình thử nghiệm của Iran. Mỗi người chơi 1 chiếc.

catalogue-jet-rafale =
    .role = Tiêm kích đa năng, cấp 4
    .lore = Rafal F4: tiêm kích đa nhiệm cánh tam giác-canard hiện đại, mạnh cả khi tấn công lẫn không chiến.

catalogue-jet-saeqeh =
    .role = Tiêm kích phản lực, cấp 3
    .lore = Saeqa: tiêm kích tự chế tạo hai đuôi của Iran, một máy bay tấn công đáng gờm trước xe cơ giới và công trình.

catalogue-jet-seavixen =
    .role = Tấn công hải quân, cấp 2
    .lore = Sea Vixa: tiêm kích tấn công hải quân hai thân đuôi, chuyên đánh chìm tàu chiến.

catalogue-jet-sr71 =
    .role = Trinh sát, cấp 3
    .lore = Blackwing: máy bay trinh sát phản lực tốc độ cao, rất khó bị bắt kịp. Nó hiện lộ căn cứ địch trên đường bay qua.

catalogue-jet-su25 =
    .role = Cường kích mặt đất, cấp 3
    .lore = Sk-25 Rook: máy bay yểm trợ cận chiến bọc thép, giáng đòn mạnh vào xe tăng và xe cơ giới ở độ cao thấp.

catalogue-jet-su27 =
    .role = Chiếm ưu thế trên không, cấp 3
    .lore = Sk-27 Flankard: tiêm kích hai động cơ cỡ lớn với tầm bay xa và tải trọng vũ khí nặng.

catalogue-jet-su30 =
    .role = Tiêm kích đa năng, cấp 4
    .lore = Flankard-M: biến thể Flanker hai chỗ ngồi vừa không chiến vừa tấn công, được Tiên phong, Nga, Ấn Độ và Trung Quốc sử dụng.

catalogue-jet-su35 =
    .role = Tiêm kích đa năng, cấp 4
    .lore = Sk-35 Flankard-E: khả năng siêu cơ động nhờ vectơ lực đẩy, tiêm kích chủ lực tốt nhất của Tiên phong.

catalogue-jet-su47 =
    .role = Tiêm kích nguyên mẫu
    .lore = Sk-47 Berkov: tiêm kích tàng hình cánh vút ngược thử nghiệm. Mỗi người chơi 1 chiếc.

catalogue-jet-swarm =
    .role = Bầy drone, cấp 3
    .lore = Drone Bầy đàn của Thổ Nhĩ Kỳ: những kẻ tấn công không người lái giá rẻ, áp đảo bộ binh và giáp nhẹ bằng số đông.

catalogue-jet-tu160 =
    .role = Máy bay ném bom chiến lược, cấp 3
    .lore = Tv-160 Swanwing: máy bay ném bom siêu thanh cánh cụp xòe của Nga, mang tải trọng khổng lồ với tốc độ cao.

catalogue-jet-typhoon =
    .role = Tiêm kích đa năng, cấp 4
    .lore = Typhon: tiêm kích cánh tam giác-canard của châu Âu, cơ động cao và tải trọng tấn công nặng.

catalogue-jet-v22 =
    .role = Vận tải cánh xoay, cấp 4
    .lore = Kestrel tiltrotor cất cánh như trực thăng và bay như máy bay, chở bộ binh sâu sau phòng tuyến địch. Không vũ trang.

catalogue-jet-vulcan =
    .role = Máy bay ném bom hạng nặng, cấp 2
    .lore = Volcan: máy bay ném bom cánh tam giác kiểu V, vũ khí tầm xa chủ lực của Anh để tấn công căn cứ.

catalogue-jet-x47 =
    .role = Nguyên mẫu drone chiến đấu
    .lore = Stingray: drone chiến đấu không người lái. Rẻ và mỏng manh, nhưng quét bộ binh và giáp nhẹ mà không cần mạo hiểm tính mạng phi công. Mỗi người chơi 1 chiếc.

catalogue-jet-yak141 =
    .role = Nguyên mẫu VTOL
    .lore = Yk-141 Freestyler: nguyên mẫu máy bay cất cánh thẳng đứng siêu thanh, tấn công xe cơ giới. Mỗi người chơi 1 chiếc.

catalogue-jet-yf23 =
    .role = Tiêm kích nguyên mẫu
    .lore = Black Recluse: tiêm kích tàng hình thử nghiệm. Chỉ mỗi người chơi 1 chiếc, một át chủ bài hiếm có và chết chóc.

catalogue-jet-zeppelin =
    .role = Khí cầu ném bom
    .lore = Một khí cầu bọc thép với tải trọng bom khổng lồ. Rất chậm, nhưng một chiếc Zeppelin chở đầy bom bay trên căn cứ sẽ gây tàn phá khủng khiếp. Hãy bắn hạ nó sớm.

catalogue-ka52 =
    .role = Trực thăng tấn công
    .lore = Alligator: hai cánh quạt đồng trục và không có cánh quạt đuôi giúp nó nhanh và cơ động. Tên lửa chống tăng và pháo 30 mm săn lùng xe bọc thép. Câu trả lời của Tiên phong trước Longbow.

catalogue-kasirga =
    .role = Bệ phóng rocket (Thổ Nhĩ Kỳ)
    .lore = Rocket 300 mm hạng nặng với tầm bắn rất xa, nghiền nát công trình và các nhóm đơn vị. Nạp đạn chậm.

catalogue-kenn =
    .role = Huấn luyện chó
    .lore = Huấn luyện chó tấn công: những thợ săn nhanh nhẹn, giá rẻ, giết bộ binh chỉ bằng một cú cắn và đánh hơi ra gián điệp cải trang.

catalogue-kong =
    .role = Titan: khỉ đột khổng lồ
    .lore = Con khỉ đột khổng lồ băng qua cả tường thành lẫn đoàn xe tăng. Ở cự ly gần, cú đấm búa song thủ của nó san phẳng mọi thứ; ở xa hơn, nó xé toạc đá tảng và ném đi. Máy bay phản lực và trực thăng bay ngang qua nó cũng không an toàn: nó nhảy vọt lên không trung và đập chúng rơi chỉ bằng một cú. Nhanh hơn Godzilla, nhưng mặt nước ngăn được nó. Được chọn trong phòng chờ, mỗi người chơi 1 con, và khi nó gục ngã thì sẽ mất vĩnh viễn.

catalogue-kvst =
    .role = Cỗ máy tấn công
    .lore = Một thân xe tăng hạng nặng với pháo 152 mm, đặt trên hai chân bọc thép thay vì bánh xích. Chậm, nhưng nó bước qua tường thành, chiến hào và bất cứ ai cản đường.

catalogue-lha =
    .role = Tàu đổ bộ tấn công
    .lore = Một tàu tấn công sàn phẳng chở cả một nhóm đổ bộ lên bãi biển và chống trả máy bay trên đường đi. Chỉ Hoa Kỳ.

catalogue-lnch =
    .role = Phóng vệ tinh
    .lore = Chế tạo và phóng vệ tinh từ tab Máy bay, tối đa 8 vệ tinh trên quỹ đạo. Cánh cửa dẫn đến mạng lưới laser quỹ đạo.

catalogue-lrx =
    .role = Bệ phóng rocket (Pháp)
    .lore = Một bệ phóng bánh xích với rocket dẫn đường GPS. Chính xác cao, +50% sát thương trước công trình. Công cụ tốt nhất để phá vỡ hệ thống phòng thủ.

catalogue-lsam =
    .role = Phòng không tầm xa
    .lore = Lớp Patriot / S-400. Nó chặn máy bay, tên lửa hành trình và tên lửa đạn đạo chiến thuật từ xa ngoài rìa căn cứ của bạn. Cần Mái vòm Radar để đạt tầm bắn tối đa.

catalogue-lsat =
    .role = Vũ khí quỹ đạo
    .lore = Lơ lửng cao trên bản đồ và bắn tia laser thẳng xuống kẻ địch bên dưới. Các vệ tinh trong phạm vi 12 ô liên kết thành mạng lưới giúp tăng cường tia laser. Chỉ trận địa ASAT mới có thể vươn tới nó.

catalogue-lst =
    .role = Tàu đổ bộ
    .lore = Chở bộ binh và xe tăng qua mặt nước và đổ bộ lên bất kỳ bãi biển nào. Không vũ trang.

catalogue-m16 =
    .role = Xe phòng không
    .lore = Một xe bán xích với bốn súng máy hạng nặng trên bệ xoay. Rẻ và nhanh: nó xé nát trực thăng, máy bay bay thấp và bộ binh, nhưng xe tăng thì không hề hấn gì.

catalogue-marz =
    .role = Bệ phóng rocket (Đức)
    .lore = Một bệ phóng bánh xích với loạt 12 rocket. Triển khai để chuyển sang bắn rocket mìn, rải mìn chống tăng trên đường tiến quân của địch.

catalogue-mcv =
    .role = Xây dựng cơ động
    .lore = Triển khai thành Xưởng Xây dựng. Dùng nó để mở căn cứ thứ hai gần một mỏ quặng xa, hoặc để xây dựng lại sau thảm họa.

catalogue-meads =
    .role = Phòng không tầm xa
    .lore = Một xe phóng với các ống phóng dựng thẳng đứng. Mỗi tên lửa đánh chặn được khí nén đẩy ra, kích hoạt động cơ trên không rồi gập xuống nhắm vào mục tiêu, bắn những động cơ đẩy phụ nhỏ ở hai bên khi áp sát để đánh trúng trực diện. Nó có thể bắn theo mọi hướng mà không cần xoay bệ phóng, và cũng hạ gục được tên lửa hành trình lẫn tên lửa đạn đạo. Các quốc gia Liên minh.

catalogue-mech =
    .role = Thợ máy dã chiến
    .lore = Sửa chữa xe cơ giới ngay tại chiến trường, giúp xe tăng của bạn tiếp tục chiến đấu dù ở xa Trạm Bảo dưỡng.

catalogue-medi =
    .role = Quân y dã chiến
    .lore = Hồi phục bộ binh lân cận ngay tại chiến trường. Luôn mang theo một người cùng mỗi nhóm bộ binh để các toán quân của bạn sống sót lâu hơn nhiều.

catalogue-mgg =
    .role = Máy tạo vùng mù cơ động
    .lore = Bao phủ khu vực xung quanh nó trong màn sương. Lái nó theo cùng đội quân của bạn để địch không thể thấy đòn tấn công sắp tới.

catalogue-mh60 =
    .role = Trực thăng tấn công
    .lore = Black Hawk: trực thăng vũ trang với súng máy đôi chống bộ binh và xe hạng nhẹ. Nạp lại đạn nhanh và rất hiệu quả khi dọn sạch bộ binh.

catalogue-mi17 =
    .role = Trực thăng chở quân
    .lore = Hip: trực thăng chủ lực của Tiên phong. Nó chở trọn một toán 8 lính ra tiền tuyến, với súng máy cửa giữ đầu địch cúi thấp tại bãi đáp.

catalogue-mi26 =
    .role = Trực thăng vận tải hạng nặng
    .lore = Halo: trực thăng lớn nhất từng được vận hành, cánh quạt tám lá nâng mười hai lính cùng lúc. Câu trả lời của Tiên phong trước Chinook. Không vũ trang, nên hãy đổ quân tránh xa khu vực phòng không.

catalogue-mi35 =
    .role = Trực thăng tấn công
    .lore = "Xe tăng bay": một trực thăng vũ trang bọc thép với súng máy xích và cụm rocket, cùng khoang chở 5 lính. Nó quét sạch bãi đáp rồi thả toán quân xuống đó.

catalogue-mi6 =
    .role = Trụ sở tình báo
    .lore = Trụ sở tình báo bí mật của Anh. Nó mở khóa Gián điệp và các Xe Gián điệp. Chỉ Anh, mỗi người chơi 1 cái, và nó cần điện.

catalogue-mig =
    .role = Phản lực tấn công
    .lore = Một máy bay cường kích tốc độ cao với tên lửa chống công trình và xe cơ giới. Tấn công rồi bay về Sân bay để nạp lại đạn.

catalogue-mlrs =
    .role = Xe tăng rocket
    .lore = Một bệ phóng rocket đa nòng bánh xích. Nó bắn hết toàn bộ giàn phóng chỉ trong vài giây, một loạt 19 rocket dày đặc trùm kín khu vực mục tiêu, rồi cần nhiều thời gian để nạp lại.

catalogue-mnly =
    .role = Xe Rải mìn
    .lore = Rải mìn chống tăng và sát thương người, đồng thời có thể phát hiện mìn địch. Gài mìn ở mỏ quặng và các điểm thắt cổ chai để mọi cuộc tấn công đều phải trả giá đắt.

catalogue-mrj =
    .role = Máy gây nhiễu radar
    .lore = Gây nhiễu Mái vòm Radar của địch ở gần và làm lệch hướng tên lửa dẫn đường bay tới. Dùng nó để hộ tống xe bọc thép của bạn vào khu vực phòng thủ dày đặc tên lửa.

catalogue-msam =
    .role = Phòng không tầm trung
    .lore = Một trận địa tên lửa tầm trung kiêm lá chắn rocket của bạn (kiểu Iron Dome): mười tên lửa đánh chặn tốc độ cao bắn ra liên tiếp, bay gần như thẳng đứng lên cao và phá tan các loạt rocket cùng rocket máy bay bay tới trên không, để lại những vệt sáng phía sau. Nó cũng đánh chặn máy bay, tên lửa hành trình và drone. Những loạt bắn lớn vẫn có thể áp đảo nó trong lúc nạp lại đạn. Chỉ đạt tầm bắn tối đa khi có Mái vòm Radar.

catalogue-mslo =
    .role = Siêu vũ khí
    .lore = Một hầm tên lửa hạt nhân. Sau một thời gian nạp năng lượng dài, nó phóng một quả bom nguyên tử san phẳng cả một khu vực trong căn cứ địch. Chỉ có thể xây 1 cái, và mọi đối thủ đều được cảnh báo khi nó sẵn sàng.

catalogue-msub =
    .role = Tàu ngầm tên lửa
    .lore = Một bệ công thành ngầm dưới nước, bắn tên lửa vào công trình, quân mặt đất và máy bay sâu trong đất liền. Yếu trước các tàu chiến khác.

catalogue-mtnk =
    .role = Xe tăng vừa
    .lore = Một xe tăng chiến đấu rẻ hơn của Tiên phong, đóng nhanh hơn Xe tăng Hạng nặng, trang bị pháo nhẹ hơn.

catalogue-mtrk =
    .role = Kẻ nghiền nát
    .lore = Một chiếc xe việt dã dân sự trên bánh xe khổng lồ, được trưng dụng vào quân đội. Nó không mang bất kỳ vũ khí nào: nó chỉ đơn giản là lái qua bộ binh, hàng rào và tường bao cát, và khoang lái cùng thùng xe chở theo một toán 4 lính. Chỉ Hoa Kỳ.

catalogue-nation-allies =
    .lore = Kho vũ khí chung của Liên minh, được mọi quốc gia thành viên chia sẻ; lính dù của phe này bay trên chiếc C-141 Starlifter thân dài.

catalogue-nation-china =
    .lore = Rồng đỏ: siêu tàu sân bay Fujian, tiêm kích tàng hình JX-20 và PHX-16, bệ phóng có tầm bắn xa nhất trong tất cả. Chiếc Y-20 Kunpeng chuyên chở quân đoàn không vận của phe này.

catalogue-nation-cuba =
    .lore = Pháo đài đảo: những bệ phóng Grad cũ bền bỉ được bắn hàng loạt và hệ thống phòng thủ được xây dựng để trụ vững trước mọi cuộc vây hãm. Lính dù của phe này bay trên những chiếc B-29 Superfortress cũ.

catalogue-nation-egypt =
    .lore = Bộ chỉ huy sa mạc: tàu sân bay trực thăng Mistral giá rẻ và rocket chùm Saqr-36 xé nát xe hạng nhẹ. Các lữ đoàn không vận của phe này bay trên những chiếc B-52 Stratofortress được cải tạo để thả quân.

catalogue-nation-england =
    .lore = Bậc thầy nghi binh: gián điệp MI6, các Xe Gián điệp đầy trang bị và máy tạo vùng mù làm mù mắt địch. Lực lượng không vận của phe này bay trên chiếc C-17A Globemaster III, máy bay vận tải phản lực bền bỉ nhất trong tất cả.

catalogue-nation-france =
    .lore = Chính xác và tàng hình: rocket dẫn đường GPS LRX, tiêm kích Rafale và Xe Vận tải Pha có khả năng tàng hình. Lính dù của phe này nhảy từ vận tải cơ C-130 Hercules.

catalogue-nation-germany =
    .lore = Kỹ sư thời gian: Xe tăng Chrono dịch chuyển tức thời khắp bản đồ và bệ phóng MARZ gieo rắc bãi mìn. Các cuộc đột kích đường không của phe này bay trên những chiếc B-17 Flying Fortress bị thu giữ, và chiếc cánh bay HG-229 Nachtflügel mang theo những quả bom dẫn đường hạng nặng.

catalogue-nation-india =
    .lore = Cường quốc đang lên: tàu sân bay tự đóng trong nước Vikrant và bệ phóng Pinak bắn hết cụm đạn chỉ trong vài giây. Lính dù của phe này nhảy từ chiếc Il-76MD với súng đuôi của nó.

catalogue-nation-iran =
    .lore = Bậc thầy drone: tàu sân bay drone Bagheri, drone tấn công Shard và nguyên mẫu tàng hình Qahir-X. Lính dù của phe này bay trên một chiếc Boeing 707 cải tạo.

catalogue-nation-italy =
    .lore = Quân đoàn Địa Trung Hải: tàu sân bay hạng nhẹ Cavour và bệ phóng rocket Saetta nạp đạn nhanh. Lính dù của phe này bay từ các căn cứ thủy phi cơ trên chiếc thủy phi cơ khổng lồ Boeing 314 Clipper.

catalogue-nation-japan =
    .lore = Hải quân đảo quốc: tàu sân bay Kaga cho máy bay cất cánh thẳng đứng và xe Sea Arrow đánh chìm tàu chiến ngoài khơi xa. Lính dù của phe này nhảy từ vận tải cơ C-130 Hercules.

catalogue-nation-pakistan =
    .lore = Người giữ núi: rocket dẫn đường Fatah giáng đòn mạnh và chính xác từ sâu phía sau tiền tuyến. Lính dù của phe này nhảy từ vận tải cơ C-130 Hercules.

catalogue-nation-russia =
    .lore = Vũ khí Tesla: Lính Tesla, Xe tăng Tesla, tàu sân bay Kuznetsov và bệ phóng nhiệt áp TOZ-1 Sunflare. Lính dù của phe này nhảy từ chiếc Il-76MD với súng đuôi của nó.

catalogue-nation-southkorea =
    .lore = Lá chắn bán đảo: bệ phóng Chunmu chuyển đổi giữa loạt rocket và một tên lửa dẫn đường hạng nặng. Lính dù của phe này nhảy từ vận tải cơ C-130 Hercules.

catalogue-nation-soviet =
    .lore = Kho vũ khí chung của Tiên phong, được mọi quốc gia thành viên chia sẻ; lính dù của phe này bay trên những chiếc B-29 Superfortress được sao chép từng con tán rivet. Từ Sân đỗ Trực thăng, phe này triển khai trực thăng vận tải hạng nặng Mi-26 Halo, trực thăng vũ trang Hind và Mi-35, cùng chiếc Ka-52 Alligator.

catalogue-nation-turkey =
    .lore = Cửa ngõ các lục địa: chiến tranh drone từ tàu sân bay Anadolu, Drone Bầy đàn và rocket hạng nặng Kasirga. Lính dù của phe này nhảy từ vận tải cơ C-130 Hercules.

catalogue-nation-ukraine =
    .lore = Phá hủy: Xe tải Phá hủy hạt nhân, các phi vụ Bom dù, chiếc An-225 khổng lồ và rocket Vilkra chính xác. Lính dù của phe này nhảy từ chiếc Il-76MD, với súng đuôi đôi 23 mm giữ tiêm kích địch tránh xa.

catalogue-nation-usa =
    .lore = Kho vũ khí của dân chủ thuộc Liên minh: phi đội không quân rộng lớn nhất thế giới, các siêu tàu sân bay, xe rocket HIMAX và chiếc AB-35 Longwing thả bom nguyên tử Fatman. Lính dù của phe này bay trên vận tải cơ C-130 Hercules từ Căn cứ Không vận.

catalogue-oilr =
    .role = Kinh tế ngoài khơi
    .lore = Một giàn khoan trên mặt nước bơm một nguồn thu nhỏ giọt ổn định mà không cần xe tải để bảo vệ. Nó phải được xây trên mặt nước gần căn cứ của bạn và ngừng bơm khi thiếu điện. Tàu chiến và tàu ngầm là mối đe dọa lớn nhất của nó.

catalogue-pbox =
    .role = Boong-ke chống bộ binh
    .lore = Một lô cốt bê tông trang bị súng máy. Nó phát hiện được đơn vị tàng hình và chặn đứng các đợt xung phong của bộ binh. Kết hợp nó với một tháp súng chống tăng.

catalogue-phx16 =
    .role = Bệ phóng rocket (Trung Quốc)
    .lore = Bệ phóng rocket có tầm bắn xa nhất trong trò chơi. Nó nã đạn vào căn cứ và các nhóm mục tiêu từ sâu phía sau tiền tuyến. Nạp đạn chậm.

catalogue-pinak =
    .role = Bệ phóng rocket (Ấn Độ)
    .lore = Bắn hết toàn bộ số rocket mang theo chỉ trong vài giây. Một loạt đạn bất ngờ tàn khốc trước bộ binh và căn cứ.

catalogue-powr =
    .role = Phát điện
    .lore = Nguồn điện cơ bản cho căn cứ của bạn. Công trình phòng thủ, radar và siêu vũ khí sẽ ngừng hoạt động khi thiếu điện, nên hãy xây nhà máy điện trước khi nhu cầu tăng và dàn trải chúng ra: một đòn tấn công duy nhất vào một cụm nhà máy điện có thể khiến cả căn cứ mất điện.

catalogue-proc =
    .role = Kinh tế
    .lore = Chuyển quặng và đá quý thành tiền, và đi kèm một Xe tải Quặng miễn phí. Xây nó gần các mỏ giàu để rút ngắn mỗi chuyến đi. Một nhà máy tinh luyện thứ hai gần mỏ khác gần như tăng gấp đôi nguồn thu của bạn.

catalogue-pt =
    .role = Pháo hạm
    .lore = Một tàu tuần tra hạng nhẹ, tốc độ cao, phát hiện tàu ngầm và săn tàu nhỏ. Đôi mắt giá rẻ trên mặt nước.

catalogue-ptnk =
    .role = Xe tăng lăng kính
    .lore = Một xe tăng tia tầm xa với tia sáng tinh thể gây sát thương diện rộng lên nhóm bộ binh, xe hạng nhẹ và công trình. Mỏng manh, nên hãy giữ nó phía sau xe bọc thép hạng nặng của bạn.

catalogue-ptwr =
    .role = Phòng thủ lăng kính
    .lore = Bắn ra một tia sáng tinh thể. Các Tháp Lăng kính lân cận liên kết và truyền năng lượng vào tháp đang bắn: +40% sát thương cho mỗi tháp liên kết, tối đa +200%. Hãy xây chúng thành cụm.

catalogue-qtnk =
    .role = Xe tăng địa chấn
    .lore = Xe tăng MAD làm rung chuyển mặt đất bằng sóng địa chấn, phá hủy xe cơ giới và công trình lân cận, và tự hủy trong quá trình đó. Hãy lái nó vào giữa căn cứ địch.

catalogue-rgun =
    .role = Robot chống giáp
    .lore = Súng ray của nó tấn công xe bọc thép từ tầm xa nhưng nạp năng lượng chậm. Hãy giữ nó phía sau một hàng bộ binh che chắn và để nó lần lượt hạ gục xe tăng.

catalogue-sacm =
    .role = Bộ chỉ huy không quân chiến lược
    .lore = Đỉnh cao của một lực lượng không quân: chỗ đậu cho 10 máy bay trong một khu vực. Chỉ có thể xây 1 cái, nên hãy bảo vệ nó cẩn thận như Xưởng Xây dựng của bạn.

catalogue-saetta =
    .role = Bệ phóng rocket (Ý)
    .lore = Một bệ phóng bánh xích rẻ hơn, nạp đạn nhanh hơn. Nhiều chiếc Saetta bắn luân phiên sẽ duy trì áp lực liên tục.

catalogue-sam =
    .role = Phòng không tầm gần
    .lore = Phóng tên lửa đất-đối-không vào máy bay và drone, và có thể bắn hạ một số rocket cùng tên lửa hành trình. Nó cần điện.

catalogue-saqr36 =
    .role = Bệ phóng rocket chùm (Ai Cập)
    .lore = Rocket chùm tách thành nhiều quả bom nhỏ phía trên mục tiêu. Tàn khốc với bộ binh và xe hạng nhẹ, yếu trước xe tăng và công trình.

catalogue-sbag =
    .role = Rào chắn hạng nhẹ
    .lore = Bao cát giá rẻ chặn bộ binh và xe hạng nhẹ, hướng kẻ tấn công vào tầm súng của bạn. Xe tăng có thể cán qua.

catalogue-sbmb =
    .role = Sân bay siêu vũ khí
    .lore = Một căn cứ ném bom kiểu Soviet với một bệ đỗ khổng lồ, một nhà chứa máy bay mái vòm và một hầm vũ khí nhiệt hạch. Nó là nơi đồn trú của chiếc Tv-95 Bear và nạp năng lượng cho Đòn Nhiệt hạch khi máy bay ném bom còn sống. Chỉ Nga, mỗi người chơi 1 cái.

catalogue-scar =
    .role = Xe gián điệp
    .lore = Một chiếc xe sang giấu súng máy và rocket bật lên, chở một Gián điệp. Địch chỉ thấy một chiếc xe dân sự vô hại cho đến khi nó tấn công. Cần Trụ sở MI6.

catalogue-scr2 =
    .role = Xe gián điệp
    .lore = Một chiếc xe grand tourer cổ điển giấu súng máy đôi, chở một Gián điệp. Chắc chắn hơn và rẻ hơn Xe Gián điệp 1. Cần Trụ sở MI6.

catalogue-sdrn =
    .role = Drone cảm tử
    .lore = Một drone nhện tốc độ cao, giá rẻ, lao vào mục tiêu rồi kích nổ. Hãy gửi từng đợt chúng vào các đoàn xe tăng và đội quân robot.

catalogue-sfng =
    .role = Xe tăng thử nghiệm
    .lore = Một xe tăng điện tử từ phòng thí nghiệm Project X. Pháo chính của nó phóng ra một luồng điện mạnh thiêu đốt lớp giáp từ bên trong. Chỉ có thể triển khai 1 chiếc.

catalogue-shok =
    .role = Lính Tesla
    .lore = Bộ binh tinh nhuệ với cuộn Tesla cầm tay, phóng tia hồ quang xuyên qua cả bộ binh lẫn xe cơ giới. Người lính biểu tượng của Nga.

catalogue-silo =
    .role = Kho chứa kinh tế
    .lore = Kho chứa thêm cho tiền đã tinh luyện. Nếu không đủ kho chứa, quặng giao vượt quá giới hạn sẽ bị lãng phí. Giá rẻ, nên hãy xây thêm bất cứ khi nào nguồn thu của bạn vượt quá sức chứa.

catalogue-snip =
    .role = Xạ thủ bắn tỉa
    .lore = Một xạ thủ bắn tỉa tầm xa, hạ gục hầu hết bộ binh chỉ bằng một phát và ẩn mình khi đứng yên. Chết chóc khi phục kích, nhưng vô dụng trước xe bọc thép.

catalogue-spdr =
    .role = Cỗ máy tấn công
    .lore = Xe tăng Nhện tám chân của Tiên phong len lỏi vào tầm bắn và phóng ra những tên lửa hạng nặng bổ nhào xuống lớp giáp nóc mỏng của xe tăng. Bệ phóng phòng không đôi của nó bắn tên lửa đánh chặn kiểu Iron Dome vào máy bay, và cũng bắn hạ cả rocket bay tới.

catalogue-spen =
    .role = Sản xuất hải quân
    .lore = Căn cứ tàu ngầm của Tiên phong. Nó sản xuất và sửa chữa tàu ngầm, tàu vận tải và tàu sân bay của Tiên phong. Phải được xây trên mặt nước.

catalogue-spy =
    .role = Kẻ xâm nhập
    .lore = Cải trang thành lính địch và xâm nhập công trình: đánh cắp tiền từ nhà máy tinh luyện, đặt lại thời gian siêu vũ khí, làm mù radar hoặc tìm hiểu bí mật sản xuất. Chó có thể nhìn xuyên qua lớp ngụy trang.

catalogue-spyd =
    .role = Phòng không cơ động
    .lore = Một chiếc xe tải với giá phóng xoay, nghiêng chứa bốn ống tên lửa: tên lửa tầm nhiệt Python cho mục tiêu gần và tên lửa radar Derby, với động cơ hai xung lướt đi giữa các lần đốt, cho mục tiêu xa. Cả hai đều bay vọt lên cao rồi bổ nhào xuống máy bay, bùng nổ thành những quả cầu lửa lớn. Chỉ Ấn Độ.

catalogue-ss =
    .role = Tàu ngầm tấn công
    .lore = Lặn khuất tầm nhìn và phóng ngư lôi vào tàu chiến. Nó phát hiện được tàu ngầm khác. Chỉ nổi lên để khai hỏa.

catalogue-stek =
    .role = Nghiên cứu cao cấp
    .lore = Trung tâm nghiên cứu của Tiên phong. Nó mở khóa những xe tăng hạng nặng nhất, vũ khí Tesla và những máy bay phản lực tốt nhất của Tiên phong.

catalogue-stnk =
    .role = Xe vận tải tàng hình
    .lore = Một xe vận tải bọc thép nhẹ tàng hình khi đứng yên và bắn tên lửa đối đất. Lén đưa một toán kỹ sư qua hệ thống phòng thủ mà không bị phát hiện.

catalogue-strd =
    .role = Cỗ máy tấn công
    .lore = Một cỗ máy bốn chân chậm chạp của Tiên phong với pháo hạng nặng và súng máy. Nó đi xuyên qua bộ binh và áp đảo hỏa lực hầu hết xe tăng.

catalogue-supl =
    .role = Điều khiển vệ tinh
    .lore = Trạm điều khiển mặt đất cho vệ tinh của bạn. Nếu bạn mất hết các Trạm Vệ tinh Mặt đất, mọi vệ tinh của bạn sẽ ngừng hoạt động cho đến khi bạn xây một trạm mới, nên hãy xây thêm một trạm dự phòng ở xa tiền tuyến.

catalogue-syrd =
    .role = Sản xuất hải quân
    .lore = Xưởng đóng tàu của Liên minh. Nó sản xuất và sửa chữa pháo hạm, khu trục hạm, tuần dương hạm, tàu vận tải và, với một số quốc gia, cả tàu sân bay. Phải được xây trên mặt nước.

catalogue-taut =
    .role = Robot Tesla
    .lore = Một robot hạng nặng của Tiên phong phóng ra tia sét Tesla từ hai tay, gây chết chóc cho bộ binh và robot địch.

catalogue-tent =
    .role = Sản xuất bộ binh
    .lore = Doanh trại Liên minh: huấn luyện lính súng trường, lính rocket, kỹ sư, quân y và bộ binh robot. Nhiều doanh trại sẽ tăng tốc huấn luyện. Đặt điểm tập kết để các toán quân mới hành quân thẳng ra tiền tuyến.

catalogue-tiger =
    .role = Trực thăng tấn công hạng nặng
    .lore = Tiger: trực thăng vũ trang Pháp-Đức với tên lửa chống tăng HOT trên giá treo ngoài và cụm rocket bắn ra một loạt rocket 68 mm. Chỉ Pháp và Đức.

catalogue-toz1 =
    .role = Bệ phóng nhiệt áp (Nga)
    .lore = Một bệ phóng nhiệt áp bọc thép. Tầm bắn ngắn, nhưng nó thiêu rụi bộ binh và công trình trong một quả cầu lửa khổng lồ.

catalogue-tran =
    .role = Trực thăng vận tải
    .lore = Chinook: chở một toán bộ binh đến bất kỳ đâu trên bản đồ. Không vũ trang, nên hãy thả quân tránh xa khu vực phòng không.

catalogue-truk =
    .role = Xe tiếp tế
    .lore = Vận chuyển tiền mặt đến nhà máy tinh luyện của đồng minh. Không vũ trang. Dùng nó để giúp đồng đội đang gặp khó khăn trụ vững trong trận đấu.

catalogue-tsla =
    .role = Phòng thủ Tesla
    .lore = Phóng ra tia sét phá hủy cả bộ binh lẫn xe cơ giới. Nó cần rất nhiều điện, và mất điện sẽ khiến nó ngừng hoạt động, nên hãy bảo vệ nhà máy điện của bạn.

catalogue-ttnk =
    .role = Xe tăng Tesla
    .lore = Một xe tăng gắn cuộn Tesla phóng tia sét xuyên qua cả bộ binh, xe cơ giới và công trình. Câu trả lời của Nga trước các đoàn xe bọc thép đông đảo.

catalogue-tu95 =
    .role = Máy bay ném bom nhiệt hạch
    .lore = Bear: máy bay ném bom tầm xa với bốn động cơ cánh quạt đồng trục ngược chiều. Không vũ trang, nó chỉ bay một nhiệm vụ duy nhất: khi Đòn Nhiệt hạch sẵn sàng, nó thả bom khinh khí RDS-37 rồi bay về nhà. Mất nó thì thời gian nạp đòn đánh sẽ bắt đầu lại từ đầu. Chỉ Nga, mỗi người chơi 1 chiếc.

catalogue-type12 =
    .role = Tên lửa chống hạm (Nhật Bản)
    .lore = Một xe tên lửa tấn công tàu chiến ngoài khơi xa. Giữ nó trên bờ biển và hạm đội địch sẽ không thể đến gần.

catalogue-v2rl =
    .role = Pháo rocket
    .lore = Bắn một quả rocket khổng lồ tàn phá bộ binh và công trình từ tầm xa. Nạp đạn chậm và yếu trước bất cứ thứ gì tiếp cận được nó.

catalogue-vilkra =
    .role = Bệ phóng rocket (Ukraina)
    .lore = Rocket tầm xa chính xác cao, tấn công công trình, bộ binh và xe cơ giới với độ chính xác tuyệt đối. Nạp đạn chậm.

catalogue-weap =
    .role = Sản xuất xe cơ giới
    .lore = Sản xuất mọi loại xe tăng, xe vận tải và bệ phóng rocket. Thêm một Trạm Bảo dưỡng và một Mái vòm Radar để mở khóa các thiết kế hạng nặng hơn, bao gồm cả bệ phóng rocket riêng của quốc gia bạn.

