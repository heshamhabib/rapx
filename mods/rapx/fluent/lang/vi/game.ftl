catalogue-xr85 =
    .role = Robot pháo hạng nặng
    .lore = France's XR-85: một bệ pháo chậm chạp di chuyển bằng chân, với khẩu pháo có tầm bắn xa hơn mọi xe tăng và gây sát thương mạnh hơn bất kỳ khẩu pháo nào khác.

catalogue-y20 =
    .role = Vận tải cơ đường không, 40 lính dù
    .lore = Máy bay vận tải phản lực hạng nặng tự chế tạo của Trung Quốc, xương sống của Quân đoàn Không vận PLA.

catalogue-yak =
    .role = Phản lực quét mục tiêu
    .lore = Một máy bay tấn công trang bị súng máy đôi, quét sạch bộ binh và giáp nhẹ.

catalogue-yb35 =
    .role = Máy bay ném bom nguyên tử
    .lore = Longwing: máy bay ném bom kiểu cánh bay với bốn động cơ cánh quạt đẩy. Nó không mang súng. Khi Đòn Fatman sẵn sàng, nó cất cánh, thả bom nguyên tử Fatman xuống mục tiêu rồi bay về nhà. Mất nó thì thời gian nạp đòn đánh sẽ bắt đầu lại từ đầu. Chỉ Hoa Kỳ, mỗi người chơi 1 chiếc.

catalogue-zolf =
    .role = Xe tên lửa đạn đạo
    .lore = Một bệ phóng bánh lốp hạng nặng với hai tên lửa đạn đạo tầm ngắn trên giá phóng. Nó có tầm bắn xa hơn mọi đơn vị mặt đất khác; chỉ phòng không tầm xa mới có thể chặn được tên lửa này. Chỉ Iran.

