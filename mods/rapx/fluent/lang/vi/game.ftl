    .title = Xóa bản đồ
    .prompt = Xóa tất cả bản đồ trên trang này?
    .confirm = Xóa

dialog-delete-all-replays =
    .title = Xóa tất cả bản ghi đã chọn?
    .prompt =
        { $count ->
        [one] Xóa { $count } bản ghi.
        *[other] Xóa { $count } bản ghi.
        }
    .confirm = Xóa Tất cả

