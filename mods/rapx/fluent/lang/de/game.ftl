catalogue-xr85 =
    .role = Schwerer Geschützdroide
    .lore = Frankreichs XR-85: eine langsame, laufende Geschützplattform, deren Kanone jeden Panzer an Reichweite übertrifft und härter trifft als jedes andere Geschütz.

catalogue-y20 =
    .role = Lufttransporter, 40 Fallschirmjäger
    .lore = Chinas eigener schwerer Jet-Transporter, das Rückgrat des Luftlandekorps der Volksbefreiungsarmee.

catalogue-yak =
    .role = Tiefflieger
    .lore = Ein Erdkampfflugzeug mit zwei MGs, das Infanterie und leichte Panzerung im Tiefflug beschießt.

catalogue-yb35 =
    .role = Atombomber
    .lore = Die Longwing: ein Nurflügelbomber mit vier Druckpropellern. Sie trägt keine Bordwaffen. Ist der Fatman-Schlag bereit, startet sie, wirft die Fatman-Atombombe auf das Ziel und fliegt heim. Geht sie verloren, beginnt der Timer von vorn. Nur USA, eine pro Spieler.

catalogue-zolf =
    .role = Ballistischer Raketen-Lkw
