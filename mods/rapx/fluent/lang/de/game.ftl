catalogue-1tnk =
    .role = Leichter Panzer
    .lore = Schnell und billig, ideal zur Aufklärung, zum Bedrängen von Erzsammlern und zum Jagen leichter Fahrzeuge. Im direkten Kampf gegen schwerere Panzer unterliegt er.

catalogue-2tnk =
    .role = Kampfpanzer
    .lore = Der Kampfpanzer der Union: ausgewogen in Tempo, Panzerung und Feuerkraft. Zusammen mit Raketensoldaten und Mobiler Flak ergibt er eine vollständige Armee.

catalogue-3tnk =
    .role = Schwerer Panzer
    .lore = Der Kampfpanzer der Vanguard mit schweren Zwillingskanonen. Langsamer als die Panzer der Union, trifft aber viel härter. Gewinnt direkte Panzerduelle.

catalogue-4tnk =
    .role = Superschwerer Panzer
    .lore = Der Mammut: Zwillingskanonen gegen Panzer, Raketenwerfer gegen Luftfahrzeuge und Infanterie, schwere Panzerung und Selbstreparatur bei Schaden. Langsam und teuer – und er zermalmt sogar Betonmauern.

catalogue-abas =
    .role = Großer Fliegerhorst
    .lore = Ein größerer Flugplatz mit Stellplätzen für 6 Flugzeuge. Erweitere deine Luftstreitmacht, ohne Landeplätze über die Basis zu verteilen.

catalogue-abrn =
    .role = Luftlandebasis, 3 Transportplätze
    .lore = Heimat der Fallschirmjägerbrigaden: Kaserne, Fallschirmpackhalle und drei Plätze für die schweren Transporter, die je 40 Soldaten überallhin auf der Karte bringen.

catalogue-afbs =
    .role = Luftwaffenstützpunkt
    .lore = Ein vollständiger Luftwaffenstützpunkt mit Stellplätzen für 8 Flugzeuge für ein ernsthaftes Angriffsgeschwader.

catalogue-afld =
    .role = Fliegerhorst
    .lore = Baut und munitioniert Jets, mit Stellplätzen für 4 Flugzeuge. Liefert außerdem die Unterstützung Spionageflugzeug und Fallschirmjäger. Jäger kehren nach jedem Einsatz hierher zum Nachladen zurück.

catalogue-agun =
    .role = Flugabwehr kurzer Reichweite
    .lore = Eine Flakkanone, die Luftfahrzeuge, Drohnen und anfliegende Marschflugkörper auf kurze Distanz zerfetzt. Benötigt Energie. Umgib deine Basis damit gegen Bomber.

catalogue-apc =
    .role = Gepanzerter Transporter
    .lore = Trägt einen Infanterietrupp unter Panzerschutz und unterstützt ihn mit einem MG. Bring Ingenieure in eine feindliche Basis oder Raketensoldaten schnell an die Front.

catalogue-apwr =
    .role = Schwere Energieerzeugung
    .lore = Doppelte Leistung eines Kraftwerks auf größerer Fläche. Ein Hauptziel feindlicher Bomber, also schütze es mit Flugabwehr.

catalogue-arty =
    .role = Artillerie
    .lore = Weitreichende Haubitze, die Verteidigungen und Infanterie außerhalb ihrer Reichweite beschießt. Aus der Nähe sehr verwundbar, also immer mit Eskorte.

catalogue-asat =
    .role = Anti-Satellit
    .lore = Schießt feindliche Satelliten im Umkreis von 12 Feldern ab. Kann keine Bodeneinheiten oder Luftfahrzeuge treffen. Deine einzige Abwehr gegen ein orbitales Lasernetz.

catalogue-atek =
    .role = Fortgeschrittene Forschung
    .lore = Forschungszentrum der Union. Schaltet die fortschrittlichsten Waffen der Union frei und startet den GPS-Satelliten, der die ganze Karte aufdeckt.

catalogue-aw101 =
    .role = Schwerer Transporthubschrauber
    .lore = Der Merlin: ein schneller dreistrahliger Hubschrauber, der zehn Soldaten über weite Strecken trägt. Nur Indien.

catalogue-b17t =
    .role = Lufttransporter, 40 Fallschirmjäger
    .lore = Eine erbeutete Flying Fortress, wie sie die Sonderstaffel im Krieg flog, um Agenten hinter den Linien abzusetzen.

catalogue-b29t =
    .role = Lufttransporter, 40 Fallschirmjäger
    .lore = Die Superfortress, die die Vanguard Niete für Niete kopiert hat – ihre Bombenschächte sind jetzt voller Fallschirmjäger.

catalogue-b314 =
    .role = Lufttransporter, 40 Fallschirmjäger
    .lore = Ein großes Flugboot aus der Clipper-Ära, das Italiens Fallschirmjäger von seinen Wasserflugzeugbasen trägt.

catalogue-b52t =
    .role = Lufttransporter, 40 Fallschirmjäger
    .lore = Eine Stratofortress mit ausgeräumten Bombenschächten, umgerüstet zum Absetzen von vierzig Mann.

catalogue-barr =
    .role = Infanterieproduktion
    .lore = Kaserne der Vanguard: bildet Wehrpflichtige, Grenadiere, Flammentruppen, Schocktruppler und die Eisengarde-Exoanzüge aus. Mehrere Kasernen beschleunigen die Ausbildung.

catalogue-bb =
    .role = Schlachtschiff
    .lore = Die größten Geschütze auf See: Drillingstürme mit 16-Zoll-Kanonen vorn und achtern beschießen die Küste außerhalb der Reichweite der meisten Verteidigungen. Langsam und sehr schwer zu versenken, aber blind gegenüber U-Booten.

catalogue-bdrd =
    .role = Kampfdroide
    .lore = Billige Droiden der Union mit Blastergewehren, in großer Zahl gebaut. Überrenne damit feindliche Infanterie und fange Feuer ab.

catalogue-bmbf =
    .role = Superwaffen-Flugplatz
    .lore = Ein bewachter Bomberflugplatz mit einem riesigen Abstellplatz, einem Hangar und einem gepanzerten Bombenbunker. Beherbergt die AB-35 Longwing und lädt den Fatman-Schlag, solange der Bomber lebt. Nur USA, einer pro Spieler.

catalogue-bmd =
    .role = Abwehr ballistischer Raketen
    .lore = THAAD-Klasse. Fängt ballistische und Hyperschallraketen hoch und weit draußen ab – die Antwort auf ballistische Raketenangriffe (Raketen überlässt sie der Mittelstrecken-SAM). Benötigt eine Radarkuppel für volle Reichweite.

catalogue-brik =
    .role = Schwere Barriere
    .lore = Betonmauern, die jede Bodeneinheit aufhalten und feindliches Feuer blockieren. Nur der Mammut-Panzer kann sie zermalmen. Schütze damit Kraftwerke und Raffinerien.

catalogue-btr =
    .role = Gepanzerter Transporter
    .lore = Ein achträdriger Schützenpanzer mit Maschinenkanone im Turm: schnell auf Straßen, setzt 5 Infanteristen an der Front ab und schießt weiter. Nur Russland.

catalogue-c130 =
    .role = Lufttransporter, 40 Fallschirmjäger
    .lore = Die Hercules: das viermotorige Arbeitspferd der Luftlandetruppen von den USA bis Frankreich, Japan, Südkorea, Türkei und Pakistan.

catalogue-c141 =
    .role = Lufttransporter, 40 Fallschirmjäger
    .lore = Der langgestreckte Jet, der jahrzehntelang die Luftlandedivisionen der Union trug.

catalogue-c17 =
    .role = Lufttransporter, 40 Fallschirmjäger
    .lore = Der strategische Transporter der Royal Air Force: vier Mantelstromtriebwerke, ein riesiger Frachtraum und vierzig Mann durch die Seitentüren.

catalogue-ca =
    .role = Kreuzer
    .lore = Ein sehr langsames Schiff mit riesigen Langstreckengeschützen, die Küstenbasen von weit draußen auf See beschießen. Eskortiere es mit Zerstörern gegen U-Boote.

catalogue-cg =
    .role = Lenkwaffenkreuzer
    .lore = Ein Lenkwaffenkreuzer: Tomahawks erreichen Ziele tief im Landesinneren, während SAMs und Nahbereichsgeschütz die Flotte aus der Luft schützen. Nur USA.

catalogue-chunmu =
    .role = Raketenwerfer (Südkorea)
    .lore = Ein schwerer Radwerfer mit 6-Raketen-Salve. Aufbauen, um auf eine schwere Lenkrakete mit größerer Reichweite umzuschalten.

catalogue-croc =
    .role = Lauerjäger
    .lore = Der älteste Jäger des Nils, von Ägypten aufgezogen und abgerichtet. Es läuft an Land, schwimmt schneller als es läuft und liegt im Wasser, nur die Augen sichtbar, ungesehen bis zum Zuschlagen. Ein Sprung und ein Biss erledigen einen Soldaten oder Hund; dann hält es an, um zu schlucken. Seine schuppige Haut steckt Gewehrfeuer weg. Nur Ägypten.

catalogue-ctnk =
    .role = Chrono-Panzer
    .lore = Feuert Boden-Raketen und teleportiert sich überallhin in Reichweite. Springe hinter feindliche Linien, triff Artillerie und Raffinerien und springe wieder weg.

catalogue-cv1 =
    .role = Flottenträger
    .lore = Ein Träger der Essex-Klasse aus dem Zweiten Weltkrieg: ein schwimmender Flugplatz mit SAM-Werfern zur Verteidigung. Startet und munitioniert Jets auf See.

catalogue-cv2 =
    .role = Kampfträger
    .lore = Der erste Flugzeugträger mit Atomantrieb, Enterprise-Klasse: größeres Deck, härterer Rumpf und mehr SAM-Werfer.

catalogue-cv3 =
    .role = Superträger
    .lore = Ein atomgetriebener Superträger der Nimitz-Klasse, das schwer gepanzerte Flaggschiff der Flotte.

catalogue-cv4 =
    .role = Superträger der nächsten Generation
    .lore = Ein Träger der Gerald-R.-Ford-Klasse mit modernster Abwehr. Das stärkste Schiff auf See.

catalogue-cvcn =
    .role = Superträger (China)
    .lore = Die Fujian: Chinas neuester Superträger mit elektromagnetischen Katapulten.

catalogue-cveg =
    .role = Hubschrauberträger (Ägypten)
    .lore = Die Mistral: ein amphibischer Hubschrauberträger. Billig und schnell gebaut.

catalogue-cvfr =
    .role = Träger (Frankreich)
    .lore = Die Charles de Gaulle, Frankreichs atomgetriebener Flugzeugträger und Stolz der Marine nationale.

catalogue-cvgb =
    .role = Träger (England)
    .lore = Die Queen Elizabeth der Royal Navy mit Skisprungschanze und zwei Inselaufbauten.

catalogue-cvin =
    .role = Träger (Indien)
    .lore = Die Vikrant: Indiens selbst gebauter Träger mit Skisprungschanze.

catalogue-cvir =
    .role = Drohnenträger (Iran)
    .lore = Die Bagheri: ein umgebautes Handelsschiff mit Flugdeck für Drohnen. Billig, aber zerbrechlich.

catalogue-cvit =
    .role = Leichter Träger (Italien)
    .lore = Die Cavour: ein italienischer leichter Träger für Senkrechtstarter und Hubschrauber.

catalogue-cvjp =
    .role = Leichter Träger (Japan)
    .lore = Die Kaga: ein Hubschrauberzerstörer, umgebaut zum leichten Träger für senkrechtstartende Jäger.

catalogue-cvru =
    .role = Träger (Russland)
    .lore = Die Kusnezow: ein schwerer flugzeugtragender Kreuzer mit Skisprungschanze und starker SAM-Abwehr.

catalogue-cvsu =
    .role = Flugdeckkreuzer
    .lore = Die Kiew: halb Träger, halb Kreuzer, mit Flugdeck achtern und Raketenwerfern vorn.

catalogue-cvtr =
    .role = Drohnenträger (Türkei)
    .lore = Die Anadolu: ein Amphibienschiff, umgebaut zum Drohnenträger, das Schwärme von Kampfdrohnen startet.

catalogue-cybt =
    .role = Cyborg-Infanterie
    .lore = Ein gepanzerter Cyborg der Union mit schwerer Automatikpistole. Kann von Panzern nicht überrollt werden und braucht nie Deckung. Ein zäher Linienhalter.

catalogue-dd =
    .role = Zerstörer
    .lore = Ein schnelles Mehrzweck-Kriegsschiff, das U-Boote aufspürt und gegen Schiffe, Fahrzeuge und Luftfahrzeuge kämpft. Das Rückgrat einer Union-Flotte.

catalogue-dog =
    .role = Kampfhund
    .lore = Schnell und billig, tötet Infanterie mit einem Biss und wittert verkleidete Spione. Halte ein Paar zu Hause als Spionjäger.

catalogue-dome =
    .role = Aufklärung
    .lore = Aktiviert deine Radar-Minikarte und schaltet die meisten Einheiten und Verteidigungen der mittleren Stufe frei. Gibt deinen weitreichenden SAMs außerdem volle Reichweite. Verlierst du sie, bist du blind – also schütze sie.

catalogue-dtrk =
    .role = Atombomben-Lkw
    .lore = Ein Lkw mit scharfem Atomsprengkopf und hauchdünner Panzerung. Fahr ihn in die feindliche Basis und zünde ihn. Er reißt alles in der Nähe mit, auch deine eigenen Einheiten.

catalogue-e1 =
    .role = Schützen
    .lore = Das Rückgrat jeder Armee: billig, schnell ausgebildet und gut gegen andere Infanterie. Stationiere sie in Bunkern oder setze sie in Massen ein, um deine Panzer vor Raketensoldaten zu schützen.

catalogue-e2 =
    .role = Grenadier
    .lore = Wirft Granaten, die Infanteriegruppen treffen und Gebäude beschädigen. Die Granaten können nahe eigene Einheiten verletzen, also halte sie hinter der Front.

catalogue-e3 =
    .role = Panzer-/Flugabwehr
    .lore = Schultergestützte Raketen gegen Panzerung und Luftfahrzeuge. Billig und die Antwort der Infanterie auf Panzer und Hubschrauber, aber leichte Beute für Maschinengewehre.

catalogue-e4 =
    .role = Flammenwerfer
    .lore = Flammenwerfer kurzer Reichweite, die Infanterie in Deckung verbrennen und Gebäude in Brand setzen. Stark beim Räumen von Bunkern und beim Sturm auf Basen.

catalogue-e6 =
    .role = Ingenieur
    .lore = Erobert feindliche Gebäude, repariert eigene und flickt zerstörte Brücken. Eskortiere sie in die feindliche Basis und nimm eine Waffenfabrik oder ein Technologiezentrum ein, um dessen Technologie zu stehlen.

catalogue-e7 =
    .role = Elite-Kommando
    .lore = Tanya: zwei Pistolen, die Infanterie mit einem Schuss fällen, und C4, das jedes Gebäude dem Erdboden gleichmacht, das sie erreicht. Nur eine kann eingesetzt werden. Halte sie von Panzern und Hunden fern.

catalogue-e8c =
    .role = Lufttransporter, 40 Fallschirmjäger
    .lore = Eine Boeing-707-Zelle, wie sie Irans Luftwaffe seit einem halben Jahrhundert fliegt, umgerüstet für den Truppentransport.

catalogue-elph =
    .role = Kriegselefanten-Läufer
    .lore = Indiens gepanzerter Kriegselefant: eine wandelnde Festung auf vier Stahlbeinen, mit einer schweren Zwillingskanone auf dem Rücken, die Granate um Granate abfeuert. Soldaten können ihm nicht ausweichen wie einem Panzer: Wer unter seine Füße gerät, wird zertrampelt. Langsam und teuer, aber kaum aufzuhalten. Nur Indien.

catalogue-enfw =
    .role = Sturmläufer
    .lore = Ein schwerer zweibeiniger Läufer der Union. Zwei Arm-Maschinenkanonen zerfetzen Infanterie, ein Schulter-Raketenwerfer knackt Panzerung. Eine wandelnde Festung zum Durchbrechen von Verteidigungslinien.

catalogue-fact =
    .role = Basiskommando
    .lore = Das Herz jeder Basis. Er baut alle anderen Gebäude und bestimmt deinen Bauradius – verlierst du ihn, endet jede Expansion. Halte ihn tief in deinen Verteidigungen und pack ihn, falls die Lobby es erlaubt, wieder zum MBF zusammen, um deine Basis zu verlegen.

catalogue-fajir5 =
    .role = Raketenwerfer (Iran)
    .lore = Große Reichweite für wenig Geld, aber ungenau. Aufbauen, um auf zwei Shard-136-Kampfdrohnen mit sehr großer Reichweite umzuschalten.

catalogue-fatah =
    .role = Raketenwerfer (Pakistan)
    .lore = Gelenkte Langstreckenraketen, sehr präzise gegen Gebäude, Infanterie und Fahrzeuge gleichermaßen. Lädt langsam nach.

catalogue-fenc =
    .role = Leichte Barriere
    .lore = Stacheldraht, der Infanterie und leichte Fahrzeuge aufhält. Panzer walzen ihn nieder.

catalogue-fix =
    .role = Feldreparatur
    .lore = Repariert gegen Gebühr Fahrzeuge, die auf seine Plattform fahren. Schaltet außerdem fortschrittliche Fahrzeuge frei. Platziere es zwischen Waffenfabrik und Front, damit beschädigte Panzer schnell wieder kämpfen.

catalogue-flak =
    .role = Flugabwehrstellung
    .lore = Eine schwere Zwillings-Flak auf drehbarer Lafette. Ihre Salven treffen jedes Luftfahrzeug in der Nähe und holen auch Drohnen und Marschflugkörper vom Himmel.

catalogue-ftrk =
    .role = Mobile Flugabwehr
    .lore = Eine Flakkanone auf Lkw, die Luftfahrzeuge, Drohnen und Infanterie zerfetzt. Gib jeder Panzerkolonne eine mit.

catalogue-ftur =
    .role = Anti-Infanterie-Turm
    .lore = Übergießt jeden, der zu nahe kommt, mit brennendem Treibstoff. Verheerend gegen Infanterie und leichte Fahrzeuge, aber mit kurzer Reichweite und machtlos gegen entfernte Panzer.

catalogue-gap =
    .role = Spionageabwehr
    .lore = Hüllt deine Basis in Nebel, sodass der Feind nicht hineinsehen kann. Späher und Spionageflugzeuge decken sie nur kurz auf. Benötigt Energie.

catalogue-godz =
    .role = Titan: wandelnde Superwaffe
    .lore = Ein Berg aus Schuppen, der aus dem Meer watet. Wenn seine Rückenplatten rosa aufleuchten, wird gleich alles vor ihm brennen: Der Atomatem reicht weiter als die meiste Artillerie und holt Luftfahrzeuge vom Himmel. Panzer, die zu nahe kommen, werden zertreten. Wird in der Lobby gewählt, einer pro Spieler – fällt er, ist er für immer verloren.

catalogue-grad =
    .role = Raketenwerfer (Kuba)
    .lore = Ein alter Grad-Werfer: billig, aber ungenau. Setze sie in Massen ein und überziehe ein Gebiet mit Raketen.

catalogue-gun =
    .role = Panzerabwehrturm
    .lore = Ein drehbarer Kanonenturm, der Panzer durchschlägt. Billig und zuverlässig, aber schwach gegen Infanteriemassen und hilflos gegen Luftfahrzeuge.

catalogue-gurz =
    .role = Mobile Flugabwehr
    .lore = Ein schwerer achträdriger Lkw mit drehbarem Kampfmodul: zwei Behälter mit kleinen Infrarotraketen und dazwischen eine 35-mm-Kanone. Er feuert je vier Raketen in Folge ab, jede in enger Spirale, und ihre Annäherungszünder platzen zu schwarzen Flakwolken. Vanguard-Nationen außer Indien.

catalogue-hailstorm =
    .role = Raketenwerfer (England)
    .lore = Ein Kettenwerfer, der eine große 12-Raketen-Salve über eine weite Fläche feuert. Stark gegen Infanterie und Basen, aber langsam.

catalogue-harv =
    .role = Erzsammler
    .lore = Sammelt Erz und Edelsteine und bringt sie zu deiner Raffinerie. Schwer gepanzert, aber unbewaffnet. Schütze deine Sammler: Sie sind dein Einkommen.

catalogue-hbox =
    .role = Getarnter Bunker
    .lore = Ein unter Tarnung versteckter Bunker. Feinde sehen ihn erst aus der Nähe – ein perfekter Hinterhalt an einer wahrscheinlichen Angriffsroute.

catalogue-hcru =
    .role = Hubschrauberkreuzer
    .lore = Ein Kreuzer mit Hubschrauberdeck achtern: Raketen und Gatling gegen Luftfahrzeuge, Wasserbomben und Sonar gegen U-Boote.

catalogue-heli =
    .role = Kampfhubschrauber
    .lore = Der Longbow: ein Raketen-Kampfhubschrauber, der Panzer, Gebäude und andere Luftfahrzeuge jagt. Zuschlagen, abdrehen und am Heli-Landeplatz nachmunitionieren.

catalogue-himax =
    .role = Raketenwerfer (USA)
    .lore = Ein schneller Radwerfer mit gelenkten Langstreckenraketen. Schießt und fährt nach jedem Abschuss weg, sodass Gegenfeuer meist ins Leere geht.

catalogue-hind =
    .role = Sturmhubschrauber
    .lore = Der Hind: ein schwerer Kampfhubschrauber mit Kettenkanonen, der Infanterie und leichte Fahrzeuge niedermäht.

catalogue-hlfr =
    .role = Raketen-Lkw
    .lore = Ein Mehrfachraketenwerfer auf Rädern mit geschlossenen Startrohren. Er feuert 30 leichte Raketen in einem langen Strom, der das Zielgebiet überzieht, und lädt dann nach.

catalogue-hmmv =
    .role = Spähwagen
    .lore = Das Arbeitspferd der US Army: gepanzert, schnell, mit .50 cal auf dem Dach und Platz für einen Trupp aus vier Mann. Nur USA.

catalogue-hpad =
    .role = Hubschrauberbasis
    .lore = Baut und munitioniert Hubschrauber für beide Seiten: Chinook, Black Hawk und Longbow der Union, Mi-26, Hind, Mi-35 und Ka-52 der Vanguard. Jeder Landeplatz versorgt nur einen Hubschrauber gleichzeitig – baue also einen pro geplantem Kampfhubschrauber.

catalogue-il76 =
    .role = Lufttransporter, 40 Fallschirmjäger
    .lore = Die Candid: der schwere Jet-Transporter der Ukraine, Russlands und Indiens. Setzt vierzig Mann hinter feindlichen Linien ab und hält Jäger mit zwei 23-mm-Kanonen vom Heck fern.

catalogue-irgd =
    .role = Exoanzug-Infanterie
    .lore = Ein Vanguard-Soldat in einem Kraftanzug mit gurtgespeistem schwerem MG. Panzer können ihn nicht überrollen, und er mäht Infanterie nieder.

catalogue-iron =
    .role = Superwaffe
    .lore = Macht eine Gruppe von Einheiten oder Gebäuden kurz unverwundbar. Stimme es auf einen Panzervorstoß ab, damit die Speerspitze unantastbar ankommt.

catalogue-jeep =
    .role = Spähfahrzeug
    .lore = Der Ranger: ein schneller Späher mit MG, der einen Soldaten trägt. Zum Aufklären, Infanteriejagen und Sammlerjagen.

catalogue-jet-a10 =
    .role = Erdkampf, Stufe 3
    .lore = Der Thunderhog: ein fliegender Panzer rund um eine riesige Gatling-Kanone. Schwer gepanzert, langsam und tödlich für Panzer. Halte Jäger von ihm fern.

catalogue-jet-an225 =
    .role = Schwertransporter, Stufe 4
    .lore = Die An-225 Dreamer: das größte je gebaute Flugzeug. Trägt Infanterie über die Karte. Unbewaffnet.

catalogue-jet-b2 =
    .role = Tarnkappenbomber, Stufe 5
    .lore = Der Wraith: ein Nurflügel-Tarnkappenbomber, der eine gewaltige Bombenlast tief hinter feindliche Linien bringt.

catalogue-jet-b52 =
    .role = Schwerer Bomber, Stufe 2
    .lore = Der Stratoforce: ein riesiger Flächenbomber, der ganze Blöcke einer Basis einebnet. Eskortiere ihn, denn gegen Jäger kann er sich nicht wehren.

catalogue-jet-f104 =
    .role = Abfangjäger, Stufe 2
    .lore = Der Starflash: ein nadelnasiger Abfangjäger aus dem Kalten Krieg, gebaut für pures Tempo. Seine Raketen treffen Gebäude und Fahrzeuge hart, aber er hat kaum Panzerung.

catalogue-jet-f117 =
    .role = Tarnkappenschlag, Stufe 3
    .lore = Der Nightjar: ein kantiger Tarnkappenjet, der an Flugabwehr vorbeischlüpft, um hochwertige Ziele zu treffen.

catalogue-jet-f14 =
    .role = Abfangjäger, Stufe 3
    .lore = Der Bobcat: ein Flottenverteidiger mit Schwenkflügeln und Langstreckenraketen. Nur von USA und Iran geflogen.

catalogue-jet-f16 =
    .role = Mehrzweckjäger, Stufe 3
    .lore = Der Fighting Kestrel: ein leichter, wendiger Mehrzweckjäger. Preiswert für Schläge gegen Fahrzeuge und Gebäude.

catalogue-jet-f2 =
    .role = Marine-Jagdbomber, Stufe 4
    .lore = Der Zero Viper: Japans selbst gebauter Jagdbomber, eine gestreckte Falcon mit größerem Flügel, gebaut für die Schiffsjagd weit draußen auf See.

catalogue-jet-f22 =
    .role = Tarnkappenjäger, Stufe 5
    .lore = Der Raptorex: ein Tarnkappenjäger der fünften Generation und der beste Luftüberlegenheitsjet der Union. Schnell, schwer zu sehen und tödlich.

catalogue-jet-f4 =
    .role = Abfangjäger, Stufe 2
    .lore = Der Spectre II: ein robustes zweistrahliges Arbeitspferd, geflogen von mehr Nationen als jeder andere Jet im Spiel. Zuverlässige Schlagkraft zu fairem Preis.

catalogue-jet-gapgen =
    .role = Fliegender Lückengenerator
    .lore = Ein unbewaffnetes Radarflugzeug, das den Boden unter sich vor dem Feind verbirgt. Schicke es über ein Gebiet, dann kreist es dort. Deckt damit einen Panzervorstoß.

catalogue-jet-grom =
    .role = Kampfdrohnen-Prototyp
    .lore = Die Grom-K: eine russische unbemannte Kampfdrohne. Billig, zerbrechlich und gefährlich für Infanterie. Eine pro Spieler.

catalogue-jet-harrier =
    .role = VTOL-Senkrechtstarter, Stufe 3
    .lore = Der Harrow startet senkrecht von winzigen Plätzen und Trägerdecks und trifft Fahrzeuge hart.

catalogue-jet-he177 =
    .role = Schwerer Bomber, Stufe 0
    .lore = Der Greif: Deutschlands viermotoriger Bomber aus dem Krieg, dessen gekoppelte Motoren zwei große Propeller antreiben – noch immer mit schwerer Bombenlast.

catalogue-jet-ho229 =
    .role = Tarnkappenbomber, Stufe 5
    .lore = Der Nachtflügel: Deutschlands Nurflügel-Düsenbomber, entstanden aus dem Kriegsentwurf der Brüder Horten und endlich gebaut – mit modernen Triebwerken und schwerer Lenkbombenlast.

catalogue-jet-j20 =
    .role = Tarnkappenjäger, Stufe 5
    .lore = Der JX-20 Jade Dragon: Chinas Tarnkappenjäger der fünften Generation, mit großer Reichweite und schwer zu sehen.

catalogue-jet-l39 =
    .role = Leichter Erdkampf, Stufe 2
    .lore = Die L-39U Albatross: ein leichter Erdkampf-Trainer, überraschend wirksam gegen Infanterie, leichte Panzerung und Drohnen.

catalogue-jet-la11 =
    .role = Kolbenmotorjäger, Stufe 0
    .lore = Die LaV-11 Fang: ein robuster Sternmotor-Jäger aus den 1940ern. Billig und schnell in großer Zahl aufgestellt.

catalogue-jet-m2000 =
    .role = Mehrzweckjäger, Stufe 3
    .lore = Die Mirago 2000: ein eleganter Deltaflügel-Mehrzweckjäger, den viele Nationen fliegen.

catalogue-jet-mig21 =
    .role = Düsenjäger, Stufe 2
    .lore = Die MiK-21 Fishbone: der meistgeflogene Jet im Vanguard-Block. Einfach, schnell und billig.

catalogue-jet-mig23 =
    .role = Mehrzweckjäger, Stufe 3
    .lore = Die MiK-23 Flintlock: ein Jagdbomber mit Schwenkflügeln, der schnell zuschlägt und schnell wieder weg ist.

catalogue-jet-mig25 =
    .role = Abfangjäger, Stufe 3
    .lore = Die MiK-25 Foxbane: ein brutal schneller Höhenabfangjäger. Kaum etwas kann ihn einholen.

catalogue-jet-mig3 =
    .role = Kolbenmotorjäger, Stufe 0
    .lore = Die MiK-3 Strela: ein Propellerjäger aus den 1940ern. Billig und schnell gebaut, gut zum Beschießen von Infanterie und leichten Fahrzeugen.

catalogue-jet-qaher =
    .role = Tarnkappen-Prototyp
    .lore = Die Qahir-X: Irans experimenteller Tarnkappenjäger. Einer pro Spieler.

catalogue-jet-rafale =
    .role = Mehrzweckjäger, Stufe 4
    .lore = Die Rafal F4: ein moderner Canard-Delta-Omnirole-Jäger, so gut im Erdkampf wie im Luftkampf.

catalogue-jet-saeqeh =
    .role = Düsenjäger, Stufe 3
    .lore = Die Saeqa: Irans selbst gebauter Jäger mit Doppelleitwerk, ein solider Jagdbomber gegen Fahrzeuge und Gebäude.

catalogue-jet-seavixen =
    .role = Seeangriff, Stufe 2
    .lore = Die Sea Vixa: ein Marine-Jagdbomber mit Doppelleitwerksträger, spezialisiert auf das Versenken von Schiffen.

catalogue-jet-sr71 =
    .role = Aufklärung, Stufe 3
    .lore = Die Blackwing: ein Hochgeschwindigkeits-Aufklärungsjet, der kaum abzufangen ist. Deckt im Überflug die feindliche Basis auf.

catalogue-jet-su25 =
    .role = Erdkampf, Stufe 3
    .lore = Die Sk-25 Rook: ein gepanzerter Erdkampfjet, der Panzer und Fahrzeuge im Tiefflug zermürbt.

catalogue-jet-su27 =
    .role = Luftüberlegenheit, Stufe 3
    .lore = Die Sk-27 Flankard: ein großer zweistrahliger Jäger mit großer Reichweite und schwerer Waffenlast.

catalogue-jet-su30 =
    .role = Mehrzweckjäger, Stufe 4
    .lore = Die Flankard-M: die zweisitzige Flanker für Luftkampf und Erdkampf, geflogen von Vanguard, Russland, Indien und China.

catalogue-jet-su35 =
    .role = Mehrzweckjäger, Stufe 4
    .lore = Die Sk-35 Flankard-E: Supermanövrierfähigkeit dank Schubvektorsteuerung und der beste Standardjäger der Vanguard.

catalogue-jet-su47 =
    .role = Prototyp-Jäger
    .lore = Die Sk-47 Berkov: ein experimenteller Tarnkappenjäger mit vorwärts gepfeilten Flügeln. Einer pro Spieler.

catalogue-jet-swarm =
    .role = Drohnenschwarm, Stufe 3
    .lore = Die Schwarmdrohnen der Türkei: billige unbemannte Angreifer, die Infanterie und leichte Panzerung durch Masse überwältigen.

catalogue-jet-tu160 =
    .role = Strategischer Bomber, Stufe 3
    .lore = Die Tv-160 Swanwing: Russlands Überschallbomber mit Schwenkflügeln, der eine gewaltige Last mit hohem Tempo ins Ziel bringt.

catalogue-jet-typhoon =
    .role = Mehrzweckjäger, Stufe 4
    .lore = Der Typhon: ein europäischer Canard-Delta-Jäger mit großer Wendigkeit und schwerer Angriffslast.

catalogue-jet-v22 =
    .role = Kipprotor-Transporter, Stufe 4
    .lore = Der Kestrel-Kipprotor startet wie ein Hubschrauber und fliegt wie ein Flugzeug – mit Infanterie weit hinter feindliche Linien. Unbewaffnet.

catalogue-jet-vulcan =
    .role = Schwerer Bomber, Stufe 2
    .lore = Die Volcan: ein Deltaflügel-V-Bomber, Englands schwerer Langstreckenschlag gegen Basen.

catalogue-jet-x47 =
    .role = Kampfdrohnen-Prototyp
    .lore = Die Stingray: eine unbemannte Kampfdrohne. Billig und zerbrechlich, beschießt aber Infanterie und leichte Panzerung, ohne einen Piloten zu riskieren. Eine pro Spieler.

catalogue-jet-yak141 =
    .role = VTOL-Prototyp
    .lore = Die Yk-141 Freestyler: ein Überschall-VTOL-Prototyp, der Fahrzeuge angreift. Einer pro Spieler.

catalogue-jet-yf23 =
    .role = Prototyp-Jäger
    .lore = Die Black Recluse: ein experimenteller Tarnkappenjäger. Nur einer pro Spieler – ein seltenes und tödliches Ass.

catalogue-jet-zeppelin =
    .role = Bomben-Luftschiff
    .lore = Ein gepanzertes Luftschiff mit gewaltiger Bombenlast. Sehr langsam, aber ein voll beladener Zeppelin über einer Basis ist verheerend. Schieß ihn früh ab.

catalogue-ka52 =
    .role = Kampfhubschrauber
    .lore = Der Alligator: zwei Koaxialrotoren und kein Heckrotor machen ihn schnell und wendig. Panzerabwehrraketen und eine 30-mm-Kanone jagen Panzer. Die Antwort der Vanguard auf den Longbow.

catalogue-kasirga =
    .role = Raketenwerfer (Türkei)
    .lore = Schwere 300-mm-Raketen mit sehr großer Reichweite, die Gebäude und Einheitengruppen zerschmettern. Lädt langsam nach.

catalogue-kenn =
    .role = Hundeausbildung
    .lore = Bildet Kampfhunde aus: schnelle, billige Jäger, die Infanterie mit einem Biss töten und verkleidete Spione wittern.

catalogue-kong =
    .role = Titan: Riesenaffe
    .lore = Der Riesenaffe walzt gleichermaßen durch Mauern und Panzerkolonnen. Aus der Nähe plättet sein beidhändiger Hammerschlag alles; auf Distanz reißt er Felsbrocken heraus und schleudert sie. Auch Jets und Hubschrauber über ihm sind nicht sicher: Er springt in die Luft und schlägt sie mit einem Hieb herunter. Schneller als Godzilla, aber Wasser hält ihn auf. Wird in der Lobby gewählt, einer pro Spieler – fällt er, ist er für immer verloren.

catalogue-kvst =
    .role = Sturmläufer
    .lore = Ein schwerer Panzerrumpf mit 152-mm-Geschütz, getragen von zwei gepanzerten Beinen statt Ketten. Langsam, aber er schreitet über Mauern, Gräben und alles, was im Weg steht.

catalogue-lha =
    .role = Amphibisches Angriffsschiff
    .lore = Ein Angriffsschiff mit Flachdeck, das eine ganze Landungsgruppe an den Strand bringt und unterwegs Luftangriffe abwehrt. Nur USA.

catalogue-lnch =
    .role = Raumstart
    .lore = Baut und startet Satelliten über den Reiter Luftfahrzeuge, bis zu 8 im Orbit. Das Tor zum orbitalen Lasernetz.

catalogue-lrx =
    .role = Raketenwerfer (Frankreich)
    .lore = Ein Kettenwerfer mit GPS-gelenkten Raketen. Präzise, mit +50 % Schaden gegen Gebäude. Das beste Werkzeug, um Verteidigungen zu zerlegen.

catalogue-lsam =
    .role = Weitreichende Flugabwehr
    .lore = Patriot-/S-400-Klasse. Stoppt Luftfahrzeuge, Marschflugkörper und taktische ballistische Raketen weit jenseits deines Basisrands. Benötigt eine Radarkuppel für volle Reichweite.

catalogue-lsat =
    .role = Orbitalwaffe
    .lore = Schwebt hoch über der Karte und feuert einen Laser senkrecht auf Feinde unter ihm. Satelliten im Umkreis von 12 Feldern bilden ein Netz, das den Strahl verstärkt. Nur ASAT-Stellungen erreichen ihn.

catalogue-lst =
    .role = Landungsboot
    .lore = Bringt Infanterie und Panzer über das Wasser und setzt sie an jedem Strand ab. Unbewaffnet.

catalogue-m16 =
    .role = Flugabwehrfahrzeug
    .lore = Ein Halbkettenfahrzeug mit vier schweren MGs auf drehbarer Lafette. Billig und schnell: zerfetzt Hubschrauber, tief fliegende Jets und Infanterie, aber Panzer lässt es kalt.

catalogue-marz =
    .role = Raketenwerfer (Deutschland)
    .lore = Ein Kettenwerfer mit 12-Raketen-Salve. Aufbauen, um auf Minenraketen umzuschalten, die Panzerminen auf den Weg des Feindes streuen.

catalogue-mcv =
    .role = Mobiler Bau
    .lore = Wird zum Bauhof aufgebaut. Eröffne damit eine zweite Basis an einem fernen Erzfeld oder baue nach einer Katastrophe neu auf.

catalogue-meads =
    .role = Weitreichende Flugabwehr
    .lore = Ein Werfer-Lkw mit senkrecht aufgerichteten Behältern. Jede Abfangrakete wird per Gas ausgestoßen, zündet über dem Fahrzeug ihren Motor und schwenkt aufs Ziel ein, wobei winzige Seitendüsen sie für den Volltreffer nachsteuern. Feuert ohne Drehen in jede Richtung und holt auch Marschflugkörper und ballistische Raketen herunter. Union-Nationen.

catalogue-mech =
    .role = Feldmechaniker
    .lore = Repariert Fahrzeuge im Feld und hält deine Panzer fern vom Reparaturdepot im Kampf.

catalogue-medi =
    .role = Feldsanitäter
    .lore = Heilt Infanterie in der Nähe im Feld. Gib jeder Infanteriegruppe einen mit, und deine Trupps überleben viel länger.

catalogue-mgg =
    .role = Mobiler Lückengenerator
    .lore = Hüllt seine Umgebung in Nebel. Fahre ihn mit deiner Armee mit, damit der Feind den Angriff nicht kommen sieht.

catalogue-mh60 =
    .role = Sturmhubschrauber
    .lore = Der Black Hawk: ein Kampfhubschrauber mit zwei Kettenkanonen gegen Infanterie und leichte Fahrzeuge. Schnell nachmunitioniert und ideal zum Räumen von Infanterie.

catalogue-mi17 =
    .role = Truppenhubschrauber
    .lore = Die Hip: das Arbeitspferd unter den Hubschraubern der Vanguard. Bringt einen vollen Trupp aus acht Mann an die Front, mit Türgeschütz, um die Landezone niederzuhalten.

catalogue-mi26 =
    .role = Schwerer Transporthubschrauber
    .lore = Die Halo: der größte je geflogene Hubschrauber, dessen Achtblattrotor zwölf Soldaten auf einmal hebt. Die Antwort der Vanguard auf den Chinook. Unbewaffnet, also setze den Trupp fern von Flugabwehr ab.

catalogue-mi35 =
    .role = Sturmhubschrauber
    .lore = Der fliegende Panzer: ein gepanzerter Kampfhubschrauber mit Kettenkanone, Raketenbehältern und Kabine für 5 Soldaten. Er beschießt die Landezone und setzt dann seinen Trupp darin ab.

catalogue-mi6 =
    .role = Geheimdienst-Hauptquartier
    .lore = Hauptquartier des britischen Geheimdienstes. Schaltet den Spion und die Spionagewagen frei. Nur England, eines pro Spieler, benötigt Energie.

catalogue-mig =
    .role = Angriffsjet
    .lore = Ein schnelles Erdkampfflugzeug mit Raketen gegen Gebäude und Fahrzeuge. Zuschlagen, dann zum Flugfeld zurückfliegen und nachmunitionieren.

catalogue-mlrs =
    .role = Raketenpanzer
    .lore = Ein Mehrfachraketenwerfer auf Ketten. Er leert sein ganzes Gestell in wenigen Sekunden, ein schwerer Strom aus 19 Raketen, der das Zielgebiet überzieht – und braucht dann lange zum Nachladen.

catalogue-mnly =
    .role = Minenleger
    .lore = Legt Panzer- und Antipersonenminen und sieht feindliche Minen. Vermine Erzfelder und Engpässe, damit jeder Angriff teuer wird.

catalogue-mrj =
    .role = Radarstörer
    .lore = Stört feindliche Radarkuppeln in der Nähe und lenkt anfliegende Lenkraketen ab. Eskortiere damit deine Panzer in raketenstarke Verteidigungen.

catalogue-msam =
    .role = Flugabwehr mittlerer Reichweite
    .lore = Eine Raketenbatterie mittlerer Reichweite und dein Raketenschild (nach Art des Iron Dome): zehn schnelle Abfangraketen starten in Folge, steigen fast senkrecht auf und zerlegen anfliegende Raketensalven und Jet-Raketen am Himmel, mit leuchtenden Streifen dahinter. Fängt auch Luftfahrzeuge, Marschflugkörper und Drohnen ab. Riesige Salven können sie beim Nachladen dennoch überlasten. Volle Reichweite nur mit Radarkuppel.

catalogue-mslo =
    .role = Superwaffe
    .lore = Ein Atomraketensilo. Nach langer Ladezeit startet es eine Atombombe, die ein ganzes Viertel einer feindlichen Basis einebnet. Nur eines baubar, und jeder Gegner wird gewarnt, sobald es bereit ist.

catalogue-msub =
    .role = Raketen-U-Boot
    .lore = Eine getauchte Belagerungsplattform, die Raketen auf Gebäude, Bodeneinheiten und Luftfahrzeuge tief im Landesinneren feuert. Schwach gegen andere Schiffe.

catalogue-mtnk =
    .role = Mittlerer Panzer
    .lore = Ein billigerer Kampfpanzer der Vanguard, schneller gebaut als der Schwere Panzer, mit leichterer Kanone.

catalogue-mtrk =
    .role = Zermalmer
    .lore = Ein ziviler Geländewagen auf Riesenrädern, zum Dienst eingezogen. Er hat überhaupt keine Waffe: Er überrollt einfach Infanterie, Zäune und Sandsackwälle, und in Kabine und Ladefläche passt ein Trupp aus vier Mann. Nur USA.

catalogue-nation-allies =
    .lore = Das gemeinsame Arsenal der Union, geteilt von allen ihren Nationen; ihre Fallschirmjäger fliegen in der langgestreckten C-141 Starlifter.

catalogue-nation-china =
    .lore = Roter Drache: der Superträger Fujian, der Tarnkappenjäger JX-20 und der PHX-16, der Raketenwerfer mit der größten Reichweite. Die Y-20 Kunpeng trägt sein Luftlandekorps.

catalogue-nation-cuba =
    .lore = Inselfestung: robuste alte Grad-Werfer in großer Zahl und eine Verteidigung, die jede Belagerung übersteht. Seine Fallschirmjäger fliegen in alten B-29 Superfortress.

catalogue-nation-egypt =
    .lore = Wüstenkommando: billige Mistral-Hubschrauberträger und Saqr-36-Streuraketen, die leichte Fahrzeuge zerfetzen. Seine Luftlandebrigaden fliegen in B-52 Stratofortress, umgerüstet zum Absetzen von Truppen.

catalogue-nation-england =
    .lore = Meister der Täuschung: MI6-Spione, mit Gadgets vollgepackte Spionagewagen und Lückengeneratoren, die den Feind blenden. Seine Luftlandetruppen fliegen die C-17A Globemaster III, den robustesten Jet-Transporter von allen.

catalogue-nation-france =
    .lore = Präzision und Tarnung: GPS-gelenkte LRX-Raketen, Rafale-Jäger und der tarnfähige Phasentransporter. Seine Fallschirmjäger springen aus C-130 Hercules.

catalogue-nation-germany =
    .lore = Ingenieure der Zeit: Chrono-Panzer, die über die Karte springen, und MARZ-Werfer, die Minenfelder säen. Seine Luftlandeangriffe fliegen in erbeuteten B-17 Flying Fortress, und der Nurflügel HG-229 Nachtflügel trägt seine schweren Lenkbomben.

catalogue-nation-india =
    .lore = Aufstrebende Macht: der selbst gebaute Träger Vikrant und Pinak-Werfer, die ihre Behälter in Sekunden leeren. Seine Fallschirmjäger springen aus der Il-76MD mit ihren Heckkanonen.

catalogue-nation-iran =
    .lore = Meister der Drohnen: der Drohnenträger Bagheri, Shard-Kampfdrohnen und der Tarnkappen-Prototyp Qahir-X. Seine Fallschirmjäger fliegen in einer umgerüsteten Boeing 707.

catalogue-nation-italy =
    .lore = Mittelmeer-Legion: der leichte Träger Cavour und der schnell nachladende Raketenwerfer Saetta. Seine Fallschirmjäger fliegen von Wasserflugzeugbasen im großen Flugboot Boeing 314 Clipper.

catalogue-nation-japan =
    .lore = Eine Inselmarine: der Senkrechtstarter-Träger Kaga und Sea-Arrow-Lkw, die Schiffe weit draußen auf See versenken. Seine Fallschirmjäger springen aus C-130 Hercules.

catalogue-nation-pakistan =
    .lore = Verteidiger der Berge: Fatah-Lenkraketen, die tief hinter der Front hart und präzise treffen. Seine Fallschirmjäger springen aus C-130 Hercules.

catalogue-nation-russia =
    .lore = Tesla-Waffen: Schocktruppler, Tesla-Panzer, der Träger Kusnezow und der thermobarische TOZ-1 Sunflare. Seine Fallschirmjäger springen aus der Il-76MD mit ihren Heckkanonen.

catalogue-nation-southkorea =
    .lore = Schild der Halbinsel: Chunmu-Werfer, die zwischen Raketensalven und einer schweren Lenkrakete wechseln. Seine Fallschirmjäger springen aus C-130 Hercules.

catalogue-nation-soviet =
    .lore = Das gemeinsame Arsenal der Vanguard, geteilt von allen ihren Nationen; ihre Fallschirmjäger fliegen in B-29 Superfortress, Niete für Niete kopiert. Vom Heli-Landeplatz kommen der Schwerlasthubschrauber Mi-26 Halo, die Kampfhubschrauber Hind und Mi-35 sowie der Ka-52 Alligator.

catalogue-nation-turkey =
    .lore = Tor der Kontinente: Drohnenkrieg vom Träger Anadolu, Schwarmdrohnen und schwere Kasirga-Raketen. Seine Fallschirmjäger springen aus C-130 Hercules.

catalogue-nation-ukraine =
    .lore = Sprengmeister: atomare Sprengstoff-Lkw, Fallschirmbomben-Angriffe, die riesige An-225 und präzise Vilkra-Raketen. Seine Fallschirmjäger springen aus der Il-76MD, deren 23-mm-Zwillingskanonen am Heck Jäger fernhalten.

catalogue-nation-usa =
    .lore = Das Arsenal der Demokratie der Union: die größte Luftflotte der Welt, Superträger, der Raketen-Lkw HIMAX und die AB-35 Longwing, die die Fatman-Atombombe abwirft. Seine Fallschirmjäger fliegen in C-130 Hercules von der Luftlandebasis.

catalogue-oilr =
    .role = Offshore-Wirtschaft
    .lore = Eine Wasserplattform, die stetig Credits fördert – ohne Sammler, die geschützt werden müssen. Muss auf Wasser neben deiner Basis gebaut werden und fördert bei Energiemangel nicht. Schiffe und U-Boote sind ihre größte Bedrohung.

catalogue-pbox =
    .role = Anti-Infanterie-Bunker
    .lore = Ein Betonbunker mit MG. Sieht getarnte Einheiten und mäht Infanterieangriffe nieder. Kombiniere ihn mit einem Panzerabwehrturm.

catalogue-phx16 =
    .role = Raketenwerfer (China)
    .lore = Der Raketenwerfer mit der größten Reichweite im Spiel. Beschießt Basen und Gruppen von weit hinter der Front. Lädt langsam nach.

catalogue-pinak =
    .role = Raketenwerfer (Indien)
    .lore = Feuert seine ganze Raketenladung in Sekunden ab. Eine verheerende Überraschungssalve gegen Infanterie und Basen.

catalogue-powr =
    .role = Energieerzeugung
    .lore = Grundversorgung für deine Basis. Verteidigungen, Radar und Superwaffen fallen bei Energiemangel aus – baue Kraftwerke also vorausschauend und verteile sie: Ein einziger Schlag auf eine Kraftwerksgruppe kann die ganze Basis lahmlegen.

catalogue-proc =
    .role = Wirtschaft
    .lore = Verwandelt Erz und Edelsteine in Credits und kommt mit einem kostenlosen Erzsammler. Baue sie nahe an reichen Feldern, um jede Fahrt zu verkürzen. Eine zweite Raffinerie an einem anderen Feld verdoppelt dein Einkommen fast.

catalogue-pt =
    .role = Kanonenboot
    .lore = Ein leichtes, schnelles Patrouillenboot, das U-Boote aufspürt und kleine Schiffe jagt. Billige Augen auf dem Wasser.

catalogue-ptnk =
    .role = Prismapanzer
    .lore = Ein weitreichender Strahlenpanzer, dessen Kristall-Lichtstrahl Gruppen von Infanterie, leichten Fahrzeugen und Gebäuden trifft. Zerbrechlich, also halte ihn hinter deinen schweren Panzern.

catalogue-ptwr =
    .role = Prisma-Verteidigung
    .lore = Feuert einen Kristall-Lichtstrahl. Nahe Prismatürme verbinden sich und leiten ihre Energie in den feuernden Turm: +40 % Schaden pro verbundenem Turm, bis zu +200 %. Baue sie in Gruppen.

catalogue-qtnk =
    .role = Seismischer Panzer
    .lore = Der MAD-Panzer erschüttert den Boden mit seismischen Wellen, die Fahrzeuge und Gebäude in der Nähe zerstören – und vernichtet sich dabei selbst. Fahre ihn mitten in eine feindliche Basis.

catalogue-rgun =
    .role = Panzerabwehr-Roboter
    .lore = Seine Railgun trifft Panzerung aus großer Entfernung, lädt aber langsam. Halte ihn hinter einem Infanterieschirm und lass ihn Panzer abschießen.

catalogue-sacm =
    .role = Strategisches Luftkommando
    .lore = Die Krone einer Luftwaffe: Stellplätze für 10 Flugzeuge auf einem Gelände. Nur eines baubar – verteidige es so gut wie deinen Bauhof.

catalogue-saetta =
    .role = Raketenwerfer (Italien)
    .lore = Ein billigerer Kettenwerfer, der schneller nachlädt. Mehrere abwechselnd feuernde Saettas halten den Druck konstant hoch.

catalogue-sam =
    .role = Flugabwehr kurzer Reichweite
    .lore = Feuert Boden-Luft-Raketen auf Luftfahrzeuge und Drohnen und kann manche Raketen und Marschflugkörper abschießen. Benötigt Energie.

catalogue-saqr36 =
    .role = Streuraketenwerfer (Ägypten)
    .lore = Streuraketen, die über dem Ziel in Submunition zerfallen. Verheerend für Infanterie und leichte Fahrzeuge, schwach gegen Panzer und Gebäude.

catalogue-sbag =
    .role = Leichte Barriere
    .lore = Billige Sandsäcke, die Infanterie und leichte Fahrzeuge aufhalten und Angreifer vor deine Geschütze lenken. Panzer walzen sie nieder.

catalogue-sbmb =
    .role = Superwaffen-Flugplatz
    .lore = Eine Bomberbasis im sowjetischen Stil mit einem riesigen Abstellplatz, einem Bogenhangar und einem thermonuklearen Waffenlager. Beherbergt die Tv-95 Bear und lädt den thermonuklearen Schlag, solange der Bomber lebt. Nur Russland, eine pro Spieler.

catalogue-scar =
    .role = Spionagefahrzeug
    .lore = Ein Luxuswagen mit versteckten MGs und ausfahrbaren Raketen, der einen Spion trägt. Feinde sehen ein harmloses Zivilfahrzeug, bis er angreift. Benötigt das MI6-Hauptquartier.

catalogue-scr2 =
    .role = Spionagefahrzeug
    .lore = Ein klassischer Gran Turismo mit versteckten Zwillings-MGs, der einen Spion trägt. Robuster und billiger als Spionagewagen 1. Benötigt das MI6-Hauptquartier.

catalogue-sdrn =
    .role = Selbstmorddrohne
    .lore = Eine schnelle, billige Spinnendrohne, die auf ihr Ziel zurennt und detoniert. Schicke Wellen davon gegen Panzerkolonnen und Roboterarmeen.

catalogue-sfng =
    .role = Experimenteller Panzer
    .lore = Ein Cyberpanzer aus den Labors von Project X. Seine Hauptwaffe schleudert eine schwere elektrische Entladung, die Panzerung von innen gart. Nur einer kann eingesetzt werden.

catalogue-shok =
    .role = Tesla-Soldat
    .lore = Elite-Infanterie mit tragbaren Tesla-Spulen, deren Blitze gleichermaßen durch Infanterie und Fahrzeuge schlagen. Russlands Markenzeichen-Soldat.

catalogue-silo =
    .role = Wirtschaftsspeicher
    .lore = Zusätzlicher Speicher für raffinierte Credits. Ohne genug Speicher verfällt Erz, das über dein Limit hinaus geliefert wird. Billig – baue also eines, sobald dein Einkommen den Speicher übersteigt.

catalogue-snip =
    .role = Scharfschütze
    .lore = Ein weitreichender Scharfschütze, der fast jeden Infanteristen mit einem Schuss tötet und sich im Stillstand versteckt. Tödlich als Sicherung, nutzlos gegen Panzerung.

catalogue-spdr =
    .role = Sturmläufer
    .lore = Der achtbeinige Spinnenpanzer der Vanguard huscht in Reichweite und entfesselt schwere Raketen, die auf die dünne Dachpanzerung von Panzern stürzen. Seine zwei Flugabwehrwerfer feuern Abfangraketen nach Art des Iron Dome auf Luftfahrzeuge und schießen auch anfliegende Raketen ab.

catalogue-spen =
    .role = Marineproduktion
    .lore = U-Boot-Bunker der Vanguard. Baut und repariert U-Boote, Transporter und Träger der Vanguard. Muss auf Wasser gebaut werden.

catalogue-spy =
    .role = Infiltrator
    .lore = Verkleidet sich als feindlicher Soldat und infiltriert Gebäude: Geld aus einer Raffinerie stehlen, Superwaffen zurücksetzen, ein Radar blenden oder Produktionsgeheimnisse erfahren. Hunde durchschauen die Verkleidung.

catalogue-spyd =
    .role = Mobile Flugabwehr
    .lore = Ein Lkw mit drehbarem, geneigtem Gestell aus vier Raketenbehältern: Python-Infrarotraketen für nahe Ziele und Derby-Radarraketen, deren Zweipulsmotoren zwischen den Brennphasen gleiten, für ferne. Beide steigen hoch, stürzen sich auf Luftziele und zerplatzen in großen Feuerbällen. Nur Indien.

catalogue-ss =
    .role = Jagd-U-Boot
    .lore = Taucht außer Sicht ab und torpediert Schiffe. Spürt andere U-Boote auf. Taucht nur zum Feuern auf.

catalogue-stek =
    .role = Fortgeschrittene Forschung
    .lore = Forschungszentrum der Vanguard. Schaltet die schwersten Panzer, Tesla-Waffen und die besten Jets der Vanguard frei.

catalogue-stnk =
    .role = Tarntransporter
    .lore = Ein leicht gepanzerter Transporter, der sich im Stillstand tarnt und Boden-Raketen feuert. Schleuse einen Trupp Ingenieure ungesehen an Verteidigungen vorbei.

catalogue-strd =
    .role = Sturmläufer
    .lore = Ein langsamer vierbeiniger Läufer der Vanguard mit schwerer Kanone und MG. Er walzt durch Infanterie und schlägt die meisten Panzer.

catalogue-supl =
    .role = Satellitenkontrolle
    .lore = Bodenkontrolle für deine Satelliten. Verlierst du jeden Uplink, gehen alle Satelliten offline, bis du einen neuen baust – baue also einen Ersatz weit weg von der Front.

catalogue-syrd =
    .role = Marineproduktion
    .lore = Werft der Union. Baut und repariert Kanonenboote, Zerstörer, Kreuzer, Transporter und, für manche Nationen, Flugzeugträger. Muss auf Wasser gebaut werden.

catalogue-taut =
    .role = Tesla-Roboter
    .lore = Ein schwerer Vanguard-Roboter, der Tesla-Blitze aus seinen Händen schleudert – tödlich für Infanterie und feindliche Roboter.

catalogue-tent =
    .role = Infanterieproduktion
    .lore = Kaserne der Union: bildet Schützen, Raketensoldaten, Ingenieure, Sanitäter und die Roboter-Infanterie aus. Mehrere Kasernen beschleunigen die Ausbildung. Setze einen Sammelpunkt, damit frische Trupps direkt an die Front marschieren.

catalogue-tiger =
    .role = Schwerer Kampfhubschrauber
    .lore = Der Tiger: ein deutsch-französischer Kampfhubschrauber mit HOT-Panzerabwehrraketen an den äußeren Trägern und Raketenbehältern, die einen Strom von 68-mm-Raketen abfeuern. Nur Frankreich und Deutschland.

catalogue-toz1 =
    .role = Thermobarischer Werfer (Russland)
    .lore = Ein gepanzerter thermobarischer Werfer. Kurze Reichweite, aber er verbrennt Infanterie und Gebäude in einem riesigen Feuerball.

catalogue-tran =
    .role = Transporthubschrauber
    .lore = Der Chinook: bringt einen Infanterietrupp überallhin auf der Karte. Unbewaffnet, also setze deine Truppen fern von Flugabwehr ab.

catalogue-truk =
    .role = Versorgungs-Lkw
    .lore = Bringt Geld zur Raffinerie eines verbündeten Spielers. Unbewaffnet. Halte damit einen angeschlagenen Mitspieler im Spiel.

catalogue-tsla =
    .role = Tesla-Verteidigung
    .lore = Schleudert Blitze, die Infanterie und Fahrzeuge gleichermaßen vernichten. Braucht viel Energie, und ein Stromausfall schaltet sie ab – schütze also deine Kraftwerke.

catalogue-ttnk =
    .role = Tesla-Panzer
    .lore = Ein Panzer mit aufgesetzter Tesla-Spule, deren Blitze durch Infanterie, Fahrzeuge und Gebäude schlagen. Russlands Antwort auf Panzermassen.

catalogue-tu95 =
    .role = Thermonuklearer Bomber
    .lore = Die Bear: ein Langstreckenbomber mit vier gegenläufigen Propellertriebwerken. Unbewaffnet fliegt sie nur eine Mission: Ist der thermonukleare Schlag bereit, wirft sie die RDS-37-Wasserstoffbombe ab und fliegt heim. Geht sie verloren, beginnt der Timer von vorn. Nur Russland, eine pro Spieler.

catalogue-type12 =
    .role = Anti-Schiff-Raketen (Japan)
    .lore = Ein Raketen-Lkw, der Schiffe weit draußen auf See trifft. An der Küste postiert, kommen feindliche Flotten nicht heran.

catalogue-v2rl =
    .role = Raketenartillerie
    .lore = Feuert eine riesige Rakete, die Infanterie und Gebäude aus großer Entfernung verwüstet. Lädt langsam nach und ist schwach gegen alles, was an sie herankommt.

catalogue-vilkra =
    .role = Raketenwerfer (Ukraine)
    .lore = Präzise Langstreckenraketen, die Gebäude, Infanterie und Fahrzeuge mit chirurgischer Genauigkeit treffen. Lädt langsam nach.

catalogue-weap =
    .role = Fahrzeugproduktion
    .lore = Baut jeden Panzer, Transporter und Raketenwerfer. Mit Reparaturdepot und Radarkuppel werden die schwereren Modelle freigeschaltet, einschließlich des eigenen Raketenwerfers deiner Nation.

