catalogue-xr85 =
    .role = 重炮机器人
    .lore = 法国 XR-85：行动缓慢的步行火炮平台，其火炮射程超过所有坦克，威力也胜过任何火炮。

catalogue-y20 =
    .role = 空降运输机，40 名伞兵
    .lore = 中国自研的重型喷气运输机，解放军空降兵军的中坚力量。

catalogue-yak =
    .role = 扫射喷气机
    .lore = 装备双联机枪的攻击机，可扫射步兵和轻装甲。

catalogue-yb35 =
    .role = 原子轰炸机
    .lore = 长翼：配备四副推进式螺旋桨的飞翼轰炸机。没有机炮。胖子打击就绪时起飞，向目标投下胖子原子弹后返航。失去它后打击计时将重新开始。美国专属，每名玩家限一架。

catalogue-zolf =
    .role = 弹道导弹车
    .lore = 重型轮式发射车，起竖架上载有两枚近程弹道导弹。射程超过其他所有地面单位；只有远程防空系统能拦截这些导弹。伊朗专属。

