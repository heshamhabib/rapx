button-command-bar-attack-move =
    .tooltip = 攻击移动
    .tooltipdesc =
        选中的单位将移动到目标位置，
        并攻击途中遇到的任何敌人。
        瞄准时按住 <(Ctrl)> 可下达强攻移动命令，
        攻击途中遇到的任何单位或建筑。
        左键点击图标，然后右键点击目标位置。

button-command-bar-deploy =
    .tooltip = 部署
    .tooltipdesc =
        选中的单位将执行默认部署动作
        - 基地车展开为建造厂
        - 建造厂重新打包为基地车
        - 运输单位卸下乘员
        - 爆破卡车和震荡坦克自毁
        - 布雷车布设地雷
        - 飞机返回基地
        立即作用于选中的单位。

button-command-bar-force-attack =
    .tooltip = 强制攻击
    .tooltipdesc =
        选中的单位将攻击目标单位或位置
        - 屏蔽对目标的默认动作
        - 可瞄准己方或盟友部队
        - 远程火炮单位将始终瞄准
        位置，忽略单位和建筑
        左键点击图标，然后右键点击目标。
        指挥单位时按住 <(Ctrl)> 可临时启用。

button-command-bar-force-move =
    .tooltip = 强制移动
    .tooltipdesc =
        选中的单位将移动到目标位置
        - 屏蔽对目标的默认动作
        - 载具将尝试碾压目标位置的敌人
        - 直升机将在目标位置降落
        - 超时空坦克将向目标位置传送
        左键点击图标，然后右键点击目标。
        指挥单位时按住 <(Alt)> 可临时启用。

button-command-bar-guard =
    .tooltip = 警戒
    .tooltipdesc =
        选中的单位将跟随目标单位。
        左键点击图标，然后右键点击目标单位。

button-command-bar-queue-orders =
    .tooltip = 路径点模式
    .tooltipdesc =
        使用路径点模式向选中的单位下达
        多个连续命令。单位收到命令后
        会立即执行。
        左键点击图标，然后在游戏世界中下达命令。
        指挥单位时按住 <(Shift)> 可临时启用。

button-command-bar-scatter =
    .tooltip = 散开
    .tooltipdesc =
        选中的单位将停止当前动作，
        并移动到附近位置。
        立即作用于选中的单位。

button-command-bar-stop =
    .tooltip = Stop
    .tooltipdesc =
        选中的单位将停止当前动作。
        选中的建筑将重置集结点。
        立即作用于选中的目标。

