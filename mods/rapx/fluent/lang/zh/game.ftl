catalogue-1tnk =
    .role = 轻型坦克
    .lore = 快速且廉价，适合侦察、袭扰运矿车和追击轻型载具。正面交战会输给更重的坦克。

catalogue-2tnk =
    .role = 主战坦克
    .lore = 联盟主战坦克：速度、装甲和火力均衡。与火箭兵和机动高射炮混编，可组成一支完整的军队。

catalogue-3tnk =
    .role = 重型坦克
    .lore = 先锋主战坦克，装备双联重炮。速度不及联盟装甲，但打击力强得多。正面坦克战中稳占上风。

catalogue-4tnk =
    .role = 超重型坦克
    .lore = 猛犸坦克：双联火炮对付坦克，导弹巢对付飞机和步兵，装甲厚重，受损时可自我修复。速度慢、造价高，连混凝土墙都能碾碎。

catalogue-abas =
    .role = 大型航空基地
    .lore = 更大的机场，可停放 6 架飞机。无需在基地内到处修建停机坪即可扩充航空联队。

catalogue-abrn =
    .role = 空降基地，3 座运输机停机坪
    .lore = 伞兵旅之家：包括兵营、降落伞叠伞库，以及三座供重型运输机使用的停机坪，每架运输机可将 40 名士兵投送至地图任意位置。

catalogue-afbs =
    .role = 空军基地
    .lore = 完整的空军基地，可停放 8 架飞机，足以组建一支强大的打击联队。

catalogue-afld =
    .role = 航空基地
    .lore = 建造喷气式飞机并为其补给弹药，可停放 4 架飞机。还提供侦察机和伞兵支援技能。战斗机每次出击后返回此处装填。

catalogue-agun =
    .role = 近程防空
    .lore = 高射炮，可在近距离撕碎飞机、无人机和来袭的巡航导弹。需要电力。在基地周围布设一圈以防御轰炸机。

catalogue-apc =
    .role = 装甲运输车
    .lore = 在装甲保护下运送一队步兵，并以机枪提供火力支援。可将工程师送入敌方基地，或将火箭兵快速投送到前线。

catalogue-apwr =
    .role = 重型发电设施
    .lore = 输出功率是发电厂的两倍，占地面积更大。是敌方轰炸机的首要目标，务必配置防空保护。

catalogue-arty =
    .role = 火炮
    .lore = 远程榴弹炮，可在敌方射程之外炮击防御工事和步兵。近战极其脆弱，务必随时配备护卫。

catalogue-asat =
    .role = 反卫星
    .lore = 击落 12 格范围内头顶的敌方卫星。无法攻击地面单位或飞机。是你对抗轨道激光网的唯一防御手段。

catalogue-atek =
    .role = 高级研究
    .lore = 联盟研究中心。解锁联盟最先进的武器，并可发射揭示全图的 GPS 卫星。

catalogue-aw101 =
    .role = 重型运输直升机
    .lore = 灰背隼：快速三发直升机，可远距离运送十名士兵。印度专属。

catalogue-b17t =
    .role = 空降运输机，40 名伞兵
    .lore = 一架缴获的空中堡垒，与战时特别中队用来向敌后空投特工的飞机如出一辙。

catalogue-b29t =
    .role = 空降运输机，40 名伞兵
    .lore = 先锋按每颗铆钉仿制的超级空中堡垒，弹舱里如今满载伞兵。

catalogue-b314 =
    .role = 空降运输机，40 名伞兵
    .lore = 飞剪时代的大型水上飞机，从水上飞机基地运送意大利伞兵。

catalogue-b52t =
    .role = 空降运输机，40 名伞兵
    .lore = 一架同温层堡垒，弹舱经过拆除改装，可空投四十人的伞兵队。

catalogue-barr =
    .role = 步兵生产
    .lore = 先锋兵营：训练动员兵、掷弹兵、火焰兵、震荡步兵和钢铁卫士外骨骼战士。多座兵营可加快训练速度。

catalogue-bb =
    .role = 战列舰
    .lore = 海上最强的巨炮：前后布置的三联装 16 英寸炮塔，可在大多数防御工事的射程之外炮击海岸。速度慢、极难击沉，但无法发现潜艇。

catalogue-bdrd =
    .role = 战斗机器人
    .lore = 装备爆能步枪的廉价联盟机器人，可大量生产。用它们淹没敌方步兵并吸收火力。

catalogue-bmbf =
    .role = 超级武器机场
    .lore = 戒备森严的轰炸机机场，设有一座巨型停机坪、一座机库和一座装甲炸弹掩体。停放 AB-35 长翼，并在轰炸机存活期间为胖子打击充能。美国专属，每名玩家限一座。

catalogue-bmd =
    .role = 弹道导弹防御
    .lore = 萨德级。在高空远距离拦截弹道导弹和高超音速导弹，是应对弹道导弹打击的利器（火箭弹交给中程防空导弹）。需要雷达站才能发挥全部射程。

catalogue-brik =
    .role = 重型屏障
    .lore = 混凝土墙可阻挡所有地面单位并抵挡敌方火力。只有猛犸坦克能碾碎它。用来保护发电厂和精炼厂。

catalogue-btr =
    .role = 装甲运输车
    .lore = 八轮装甲运兵车，装备炮塔机关炮：公路机动迅速，可将 5 名步兵送到前线并持续射击。俄罗斯专属。

catalogue-c130 =
    .role = 空降运输机，40 名伞兵
    .lore = 大力神：从美国到法国、日本、韩国、土耳其和巴基斯坦，空降部队的四发主力运输机。

catalogue-c141 =
    .role = 空降运输机，40 名伞兵
    .lore = 长机身喷气式运输机，数十年来一直运送联盟的空降师。

catalogue-c17 =
    .role = 空降运输机，40 名伞兵
    .lore = 英国皇家空军的战略运输机：四台涡扇发动机、巨大的货舱，可从侧门空投四十人的伞兵队。

catalogue-ca =
    .role = 巡洋舰
    .lore = 航速很慢的舰艇，装备巨大的远程火炮，可从远海炮击沿岸基地。需配备驱逐舰护航以防潜艇。

catalogue-cg =
    .role = 导弹巡洋舰
    .lore = 导弹巡洋舰：战斧导弹可打击内陆纵深目标，防空导弹和近防炮为舰队提供空中掩护。美国专属。

catalogue-chunmu =
    .role = 火箭炮（韩国）
    .lore = 重型轮式发射车，可齐射 6 枚火箭弹。部署后切换为一枚射程更远的重型制导导弹。

catalogue-croc =
    .role = 伏击猎手
    .lore = 尼罗河最古老的猎手，由埃及饲养训练。它能在陆地行走，游得比走得快，潜伏水中时只露出双眼，出击前无人察觉。一扑一咬即可解决一名士兵或一条军犬，随后停下吞食。鳞甲可无视步枪火力。埃及专属。

catalogue-ctnk =
    .role = 超时空坦克
    .lore = 发射对地导弹，可传送至范围内任意位置。闪现到敌后打击火炮和精炼厂，然后闪现撤离。

catalogue-cv1 =
    .role = 舰队航母
    .lore = 二战时期的埃塞克斯级航母：配备防空导弹发射器的海上空军基地。可在海上起降喷气机并为其补给弹药。

catalogue-cv2 =
    .role = 战斗航母
    .lore = 首艘核动力航母，企业级：甲板更大，舰体更坚固，防空导弹发射器更多。

catalogue-cv3 =
    .role = 超级航母
    .lore = 尼米兹级核动力超级航母，舰队的重装甲旗舰。

catalogue-cv4 =
    .role = 新一代超级航母
    .lore = 福特级航母，配备最新防御系统。海上最强大的战舰。

catalogue-cvcn =
    .role = 超级航母（中国）
    .lore = 福建舰：中国最新的超级航母，配备电磁弹射器。

catalogue-cveg =
    .role = 直升机航母（埃及）
    .lore = 西北风级：两栖直升机航母。造价低廉，建造迅速。

catalogue-cvfr =
    .role = 航母（法国）
    .lore = 戴高乐号：法国核动力航母，法国海军的骄傲。

catalogue-cvgb =
    .role = 航母（英国）
    .lore = 英国皇家海军伊丽莎白女王号航母，配备滑跃式舰艏和双舰岛。

catalogue-cvin =
    .role = 航母（印度）
    .lore = 维克兰特号：印度自建航母，配备滑跃式舰艏。

catalogue-cvir =
    .role = 无人机航母（伊朗）
    .lore = 巴盖里号：由商船改装而成，配有无人机飞行甲板。造价低廉，但很脆弱。

catalogue-cvit =
    .role = 轻型航母（意大利）
    .lore = 加富尔号：意大利轻型航母，搭载垂直起降战斗机和直升机。

catalogue-cvjp =
    .role = 轻型航母（日本）
    .lore = 加贺号：由直升机驱逐舰改装的轻型航母，搭载垂直起降战斗机。

catalogue-cvru =
    .role = 航母（俄罗斯）
    .lore = 库兹涅佐夫号：重型航空巡洋舰，配备滑跃式舰艏和强大的防空导弹。

catalogue-cvsu =
    .role = 航空巡洋舰
    .lore = 基辅级：半航母，半巡洋舰，后部是飞行甲板，前部是导弹发射器。

catalogue-cvtr =
    .role = 无人机航母（土耳其）
    .lore = 阿纳多卢号：由两栖舰改装的无人机航母，可放出成群的攻击无人机。

catalogue-cybt =
    .role = 生化步兵
    .lore = 装甲联盟生化战士，装备重型自动手枪。无法被坦克碾压，也从不需要掩护。坚韧的阵线守卫者。

catalogue-dd =
    .role = 驱逐舰
    .lore = 快速多用途战舰，可探测潜艇，并能与舰船、载具和飞机交战。联盟舰队的中坚力量。

catalogue-dog =
    .role = 攻击犬
    .lore = 快速且廉价，一口即可咬死步兵，还能嗅出伪装的间谍。在基地留几只作为反间谍猎手。

catalogue-dome =
    .role = 情报
    .lore = 开启雷达小地图，并解锁大部分中级单位和防御设施。还能使远程防空导弹发挥全部射程。失去它你将失明，务必严加保护。

catalogue-dtrk =
    .role = 核弹卡车
    .lore = 装载已武装核弹头的卡车，装甲薄如纸。开进敌方基地后引爆，附近的一切都将同归于尽，包括你自己的单位。

catalogue-e1 =
    .role = 步枪步兵
    .lore = 每支军队的中坚：便宜、训练迅速，擅长对付其他步兵。可驻守碉堡，或大量集结以掩护坦克免受火箭兵攻击。

catalogue-e2 =
    .role = 掷弹兵
    .lore = 投掷手榴弹，可溅射成群的步兵并损伤建筑。手榴弹可能误伤附近的友军，因此应让他们留在前线后方。

catalogue-e3 =
    .role = 反坦克/防空
    .lore = 肩扛式火箭可同时打击装甲和飞机。价格便宜，是步兵对付坦克和直升机的利器，但很容易被机枪收割。

catalogue-e4 =
    .role = 火焰兵
    .lore = 短程火焰喷射器，可焚烧掩体中的步兵并点燃建筑。擅长清剿地堡和突击基地。

catalogue-e6 =
    .role = 工程师
    .lore = 占领敌方建筑、维修己方建筑并修复损毁的桥梁。护送他们进入敌方基地，占领战车工厂或科技中心以窃取科技。

catalogue-e7 =
    .role = 精英突击队员
    .lore = 谭雅：双枪一发击毙步兵，C4 可夷平她所到达的任何建筑。只能部署一名。让她远离坦克和军犬。

catalogue-e8c =
    .role = 空降运输机，40 名伞兵
    .lore = 伊朗空军服役了半个世纪的波音 707 机体，经改装后用于运兵。

catalogue-elph =
    .role = 战象步行机甲
    .lore = 印度装甲战象：以四条钢腿行走的移动堡垒，背上的双联重炮连续开火。士兵无法像躲避坦克那样躲开它：脚下的任何人都会被践踏。速度慢、造价高，但极难阻挡。印度专属。

catalogue-enfw =
    .role = 突击步行机甲
    .lore = 联盟重型双足步行机甲。双臂机关炮撕碎步兵，肩部火箭巢击穿装甲。突破防线的移动堡垒。

catalogue-fact =
    .role = 基地指挥
    .lore = 每座基地的核心。它建造其他所有建筑并决定建造范围，失去它将无法继续扩张。将它置于防线深处；如果大厅设置允许，可将其重新打包为基地车以转移基地。

catalogue-fajir5 =
    .role = 火箭炮（伊朗）
    .lore = 射程远、价格低，但精度差。部署后切换为两架射程极远的 Shard-136 攻击无人机。

catalogue-fatah =
    .role = 火箭炮（巴基斯坦）
    .lore = 远程制导火箭弹，无论对建筑、步兵还是载具都极为精准。装填缓慢。

catalogue-fenc =
    .role = 轻型屏障
    .lore = 铁丝网可阻挡步兵和轻型载具。坦克可将其碾平。

catalogue-fix =
    .role = 野战维修
    .lore = 维修驶上平台的载具，需要付费。还可解锁高级载具。将它建在战车工厂与前线之间，让受损的坦克迅速重返战场。

catalogue-flak =
    .role = 防空防御
    .lore = 旋转座架上的重型双联高射炮。其弹幕可伤及附近所有飞机，还能将无人机和巡航导弹打下来。

catalogue-ftrk =
    .role = 机动防空
    .lore = 车载高射炮，可撕碎飞机、无人机和步兵。每支装甲纵队都应配备一辆。

catalogue-ftur =
    .role = 反步兵塔
    .lore = 向靠近的任何人倾泻燃烧的燃料。对步兵和轻型载具是灾难，但射程短，无法打击远处的坦克。

catalogue-gap =
    .role = 反情报
    .lore = 用黑幕笼罩你的基地，使敌人无法看到其中情况。侦察兵和侦察机只能短暂揭示。需要电力。

catalogue-godz =
    .role = 泰坦：行走的超级武器
    .lore = 一座从海中涉水而出的鳞甲之山。当它的背鳍亮起粉光时，前方的一切都将被焚毁：原子吐息的射程超过大多数火炮，还能将飞机从空中击落。靠近的坦克会被踩扁。在大厅中选择，每名玩家一只，一旦倒下便永远消失。

catalogue-grad =
    .role = 火箭炮（古巴）
    .lore = 老式冰雹火箭炮：便宜但精度差。大量集结即可用火箭弹覆盖一片区域。

catalogue-gun =
    .role = 反装甲炮塔
    .lore = 可击穿坦克的旋转炮塔。便宜可靠，但难以应对大批步兵，对飞机无能为力。

catalogue-gurz =
    .role = 机动防空系统
    .lore = 重型八轮卡车，搭载旋转战斗模块：两组小型红外导弹巢，中间是一门 35 毫米机炮。每次连射四枚导弹，每枚都以紧密的螺旋轨迹飞行，近炸引信爆出黑色的高射炮烟团。除印度外的先锋国家。

catalogue-hailstorm =
    .role = 火箭炮（英国）
    .lore = 履带式发射车，可大范围齐射 12 枚火箭弹。擅长打击步兵和基地，但速度慢。

catalogue-harv =
    .role = 运矿车
    .lore = 采集矿石和宝石并运回精炼厂。装甲厚重，但没有武装。保护好你的运矿车：它们是你的收入来源。

catalogue-hbox =
    .role = 伪装地堡
    .lore = 隐藏在伪装下的碉堡。敌人靠近之前无法发现，是在可能的进攻路线上设伏的绝佳选择。

catalogue-hcru =
    .role = 直升机巡洋舰
    .lore = 后部设有直升机甲板的巡洋舰：以导弹和加特林炮防空，以深水炸弹和声呐反潜。

catalogue-heli =
    .role = 攻击直升机
    .lore = 长弓：猎杀坦克、建筑和其他飞机的导弹武装直升机。打了就跑，然后返回直升机坪补给弹药。

catalogue-himax =
    .role = 火箭炮（美国）
    .lore = 快速轮式发射车，发射远程制导火箭弹。打了就跑，每次发射后立即转移，因此反击火力通常只能打中空地。

catalogue-hind =
    .role = 突击直升机
    .lore = 雌鹿：装备链炮的重型武装直升机，可收割步兵和轻型载具。

catalogue-hlfr =
    .role = 火箭卡车
    .lore = 轮式多管火箭炮，配备一组封闭式发射管。连续发射 30 枚轻型火箭弹覆盖目标区域，然后装填。

catalogue-hmmv =
    .role = 侦察车
    .lore = 美国陆军的主力车辆：有装甲、速度快，车顶装有 .50 口径机枪，可搭载四人火力小组。美国专属。

catalogue-hpad =
    .role = 直升机基地
    .lore = 为双方建造直升机并补给弹药：联盟的支奴干、黑鹰和长弓，先锋的 Mi-26、雌鹿、Mi-35 和 Ka-52。每座停机坪一次只能服务一架直升机，因此计划部署多少武装直升机就建多少座。

catalogue-il76 =
    .role = 空降运输机，40 名伞兵
    .lore = 耿直：乌克兰、俄罗斯和印度的重型喷气运输机。可在敌后空投四十人的伞兵队，并用双联 23 毫米机炮驱离尾后的战斗机。

catalogue-irgd =
    .role = 外骨骼步兵
    .lore = 身穿动力外骨骼的先锋士兵，装备弹链供弹重机枪。坦克无法碾压它，它能成片收割步兵。

catalogue-iron =
    .role = 超级武器
    .lore = 使一组单位或建筑在短时间内无敌。配合坦克突击使用，让先锋部队刀枪不入地抵达。

catalogue-jeep =
    .role = 侦察车辆
    .lore = 游骑兵：装备机枪的快速侦察车，可搭载一名士兵。用于侦察、追击步兵和猎杀运矿车。

catalogue-jet-a10 =
    .role = 对地攻击，第 3 代
    .lore = 雷霆猪：围绕一门巨型转管炮打造的飞行坦克。装甲厚重、速度慢，对装甲目标极具杀伤力。让战斗机远离它。

catalogue-jet-an225 =
    .role = 重型运输，第 4 代
    .lore = An-225 梦想：有史以来最大的飞机。可将步兵运送到地图另一端。无武装。

catalogue-jet-b2 =
    .role = 隐形轰炸机，第 5 代
    .lore = 幽灵：飞翼式隐形轰炸机，可将巨量炸弹投送至敌后纵深。

catalogue-jet-b52 =
    .role = 重型轰炸机，第 2 代
    .lore = 同温层：巨型地毯式轰炸机，可将基地的整片区域夷为平地。需要护航，因为它无法抵御战斗机。

catalogue-jet-f104 =
    .role = 截击机，第 2 代
    .lore = 星光：为极速而生的尖鼻冷战截击机。其导弹对建筑和载具伤害很高，但装甲薄弱。

catalogue-jet-f117 =
    .role = 隐形打击，第 3 代
    .lore = 夜鹰：多面体隐形喷气机，可溜过防空网打击高价值目标。

catalogue-jet-f14 =
    .role = 截击机，第 3 代
    .lore = 山猫：可变后掠翼舰队防空战斗机，配备远程导弹。仅美国和伊朗装备。

catalogue-jet-f16 =
    .role = 多用途战斗机，第 3 代
    .lore = 战隼：轻巧敏捷的多用途战斗机。打击载具和建筑性价比高。

catalogue-jet-f2 =
    .role = 舰载攻击战斗机，第 4 代
    .lore = 零式蝰蛇：日本自研攻击战斗机，由猎鹰放大而来，机翼更大，专门猎杀远海舰船。

catalogue-jet-f22 =
    .role = 隐形战斗机，第 5 代
    .lore = 猛禽：第五代隐形战斗机，联盟最强的制空战机。速度快、难以发现、致命。

catalogue-jet-f4 =
    .role = 截击机，第 2 代
    .lore = 鬼怪 II：坚固的双发主力战机，装备国家比游戏中任何其他喷气机都多。价格公道，打击力可靠。

catalogue-jet-gapgen =
    .role = 空中裂缝产生器
    .lore = 无武装的雷达飞机，可对敌方隐藏其下方的地面。命令它飞往某区域，它会在该处盘旋。用它掩护坦克突击。

catalogue-jet-grom =
    .role = 作战无人机原型
    .lore = 雷霆-K：俄罗斯无人作战无人机。便宜、脆弱，对步兵威胁很大。每名玩家限一架。

catalogue-jet-harrier =
    .role = 垂直起降战斗机，第 3 代
    .lore = 鹞式可从小型停机坪和航母甲板垂直起飞，重创载具。

catalogue-jet-he177 =
    .role = 重型轰炸机，第 0 代
    .lore = 狮鹫：德国战时四发轰炸机，成对的发动机驱动两副大型螺旋桨，至今仍能携带大量炸弹。

catalogue-jet-ho229 =
    .role = 隐形轰炸机，第 5 代
    .lore = 夜翼：德国飞翼式喷气轰炸机，源自霍顿兄弟的战时设计，终于以现代发动机和重型制导炸弹载荷建造完成。

catalogue-jet-j20 =
    .role = 隐形战斗机，第 5 代
    .lore = JX-20 玉龙：中国第五代隐形战斗机，航程远、难以发现。

catalogue-jet-l39 =
    .role = 轻型攻击，第 2 代
    .lore = L-39U 信天翁：轻型攻击教练机，对付步兵、轻装甲和无人机效果出奇地好。

catalogue-jet-la11 =
    .role = 活塞式战斗机，第 0 代
    .lore = LaV-11 獠牙：1940 年代坚固的星形发动机战斗机。便宜，可迅速大量部署。

catalogue-jet-m2000 =
    .role = 多用途战斗机，第 3 代
    .lore = 幻影 2000：外形流畅的三角翼多用途战斗机，被许多国家采用。

catalogue-jet-mig21 =
    .role = 喷气式战斗机，第 2 代
    .lore = MiK-21 鱼骨：先锋阵营装备最广的喷气机。简单、快速、便宜。

catalogue-jet-mig23 =
    .role = 多用途战斗机，第 3 代
    .lore = MiK-23 燧发枪：可变后掠翼战斗轰炸机，来去如风。

catalogue-jet-mig25 =
    .role = 截击机，第 3 代
    .lore = MiK-25 狐克星：速度惊人的高空截击机。几乎没有什么能追上它。

catalogue-jet-mig3 =
    .role = 活塞式战斗机，第 0 代
    .lore = MiK-3 箭：1940 年代的螺旋桨战斗机。便宜、建造迅速，适合扫射步兵和轻型载具。

catalogue-jet-qaher =
    .role = 隐形原型机
    .lore = 征服者-X：伊朗实验型隐形战斗机。每名玩家限一架。

catalogue-jet-rafale =
    .role = 多用途战斗机，第 4 代
    .lore = 阵风 F4：现代鸭式三角翼全能战斗机，对地打击与空中格斗同样出色。

catalogue-jet-saeqeh =
    .role = 喷气式战斗机，第 3 代
    .lore = 闪电：伊朗自研双垂尾战斗机，对付载具和建筑的可靠攻击机。

catalogue-jet-seavixen =
    .role = 海上打击，第 2 代
    .lore = 海雌狐：双尾撑舰载攻击战斗机，专门击沉舰船。

catalogue-jet-sr71 =
    .role = 侦察，第 3 代
    .lore = 黑翼：极难被拦截的高速侦察机。飞越途中可揭示敌方基地。

catalogue-jet-su25 =
    .role = 对地攻击，第 3 代
    .lore = Sk-25 白嘴鸦：装甲近距支援喷气机，可低空重创坦克和载具。

catalogue-jet-su27 =
    .role = 制空，第 3 代
    .lore = Sk-27 侧卫：大型双发战斗机，航程远，载弹量大。

catalogue-jet-su30 =
    .role = 多用途战斗机，第 4 代
    .lore = 侧卫-M：既能格斗又能对地打击的双座侧卫，由先锋、俄罗斯、印度和中国装备。

catalogue-jet-su35 =
    .role = 多用途战斗机，第 4 代
    .lore = Sk-35 侧卫-E：推力矢量带来超机动性，先锋最强的主流战斗机。

catalogue-jet-su47 =
    .role = 原型战斗机
    .lore = Sk-47 金雕：实验型前掠翼隐形战斗机。每名玩家限一架。

catalogue-jet-swarm =
    .role = 无人机蜂群，第 3 代
    .lore = 土耳其蜂群无人机：廉价的无人攻击机，以数量压垮步兵和轻装甲。

catalogue-jet-tu160 =
    .role = 战略轰炸机，第 3 代
    .lore = Tv-160 白天鹅：俄罗斯超音速可变后掠翼轰炸机，可高速投送巨量载荷。

catalogue-jet-typhoon =
    .role = 多用途战斗机，第 4 代
    .lore = 台风：欧洲鸭式三角翼战斗机，机动性出色，对地打击载荷大。

catalogue-jet-v22 =
    .role = 倾转旋翼运输机，第 4 代
    .lore = 红隼倾转旋翼机像直升机一样起飞，像飞机一样飞行，可将步兵运送至敌后纵深。无武装。

catalogue-jet-vulcan =
    .role = 重型轰炸机，第 2 代
    .lore = 火神：三角翼 V 系列轰炸机，英国打击基地的远程重拳。

catalogue-jet-x47 =
    .role = 作战无人机原型
    .lore = 魟鱼：无人作战无人机。便宜而脆弱，但无需冒飞行员风险即可扫射步兵和轻装甲。每名玩家限一架。

catalogue-jet-yak141 =
    .role = 垂直起降原型机
    .lore = Yk-141 自由式：超音速垂直起降战斗机原型，可打击载具。每名玩家限一架。

catalogue-jet-yf23 =
    .role = 原型战斗机
    .lore = 黑寡妇：实验型隐形战斗机。每名玩家仅限一架，罕见而致命的王牌。

catalogue-jet-zeppelin =
    .role = 轰炸飞艇
    .lore = 载弹量巨大的装甲飞艇。速度极慢，但一艘满载的齐柏林飞艇飞临基地上空将是毁灭性的。务必尽早击落。

catalogue-ka52 =
    .role = 攻击直升机
    .lore = 短吻鳄：共轴双旋翼且无尾桨，速度快、机动灵活。反坦克导弹和 30 毫米机炮专门猎杀装甲。先锋对长弓的回应。

catalogue-kasirga =
    .role = 火箭炮（土耳其）
    .lore = 射程极远的 300 毫米重型火箭弹，可摧毁建筑和集群单位。装填缓慢。

catalogue-kenn =
    .role = 军犬训练
    .lore = 训练攻击犬：快速、廉价的猎手，一口即可咬死步兵，还能嗅出伪装的间谍。

catalogue-kong =
    .role = 泰坦：巨型猩猩
    .lore = 巨型猩猩可同样轻松地穿过围墙和坦克纵队。近战时双拳重锤能砸扁一切；稍远处它会撕起巨石投掷。飞过头顶的喷气机和直升机也不安全：它会跃入空中一掌拍落。比哥斯拉更快，但会被水阻挡。在大厅中选择，每名玩家一只，一旦倒下便永远消失。

catalogue-kvst =
    .role = 突击步行机甲
    .lore = 重型坦克车体搭载 152 毫米火炮，以两条装甲腿代替履带。速度慢，但能跨越围墙、壕沟和任何挡路者。

catalogue-lha =
    .role = 两栖攻击舰
    .lore = 平甲板突击舰，可将整个登陆群运往海滩，并在途中抵御空中威胁。美国专属。

catalogue-lnch =
    .role = 航天发射
    .lore = 从飞机标签页建造并发射卫星，轨道上最多 8 颗。通往轨道激光网的大门。

catalogue-lrx =
    .role = 火箭炮（法国）
    .lore = 履带式发射车，发射 GPS 制导火箭弹。精准，对建筑伤害 +50%。拆解防御工事的最佳工具。

catalogue-lsam =
    .role = 远程防空
    .lore = 爱国者 / S-400 级。可在基地边缘之外远距离拦截飞机、巡航导弹和战术弹道导弹。需要雷达站才能发挥全部射程。

catalogue-lsat =
    .role = 轨道武器
    .lore = 悬停于地图高空，向正下方的敌人发射激光。12 格内的卫星互联成网，可增强光束。只有反卫星导弹发射场能打到它。

catalogue-lst =
    .role = 登陆艇
    .lore = 搭载步兵和坦克渡过水域，并在任意海滩登陆。无武装。

catalogue-m16 =
    .role = 防空车辆
    .lore = 旋转座架上装有四挺重机枪的半履带车。便宜快捷：可撕碎直升机、低空喷气机和步兵，但对坦克毫无威胁。

catalogue-marz =
    .role = 火箭炮（德国）
    .lore = 履带式发射车，可齐射 12 枚火箭弹。部署后切换为布雷火箭弹，在敌人的行进路线上抛撒反坦克地雷。

catalogue-mcv =
    .role = 移动建造
    .lore = 部署后成为建造厂。可用于在远处矿区附近开辟第二基地，或在遭受重创后重建。

catalogue-meads =
    .role = 远程防空
    .lore = 竖起发射筒的发射车。每枚拦截弹由燃气弹射而出，在空中点燃发动机后转向目标，接近时启动微型侧向推进器直接命中。无需转向即可向任意方向射击，还能击落巡航导弹和弹道导弹。联盟国家。

catalogue-mech =
    .role = 野战机械师
    .lore = 在野外维修载具，让你的坦克远离维修厂也能持续作战。

catalogue-medi =
    .role = 野战医疗兵
    .lore = 在野外治疗附近的步兵。每支步兵小队配备一名，部队的存活时间将大大延长。

catalogue-mgg =
    .role = 移动裂缝产生器
    .lore = 用黑幕覆盖周围区域。随大军一同行进，让敌人看不到即将到来的进攻。

catalogue-mh60 =
    .role = 突击直升机
    .lore = 黑鹰：配备双联链炮的武装直升机，专门对付步兵和轻型载具。补给迅速，清剿步兵的好手。

catalogue-mi17 =
    .role = 运兵直升机
    .lore = 河马：先锋的主力直升机。可将八人满编小队运往前线，并用舱门机枪压制着陆区的敌人。

catalogue-mi26 =
    .role = 重型运输直升机
    .lore = 光环：有史以来最大的直升机，八叶旋翼可一次运载十二名士兵。先锋对支奴干的回应。无武装，因此应在远离防空的地方让小队着陆。

catalogue-mi35 =
    .role = 突击直升机
    .lore = 飞行坦克：装备链炮和火箭巢的装甲武装直升机，机舱可容纳 5 名士兵。先扫射着陆区，再将小队投放其中。

catalogue-mi6 =
    .role = 情报总部
    .lore = 英国秘密情报局总部。解锁间谍和间谍车。英国专属，每名玩家限一座，需要电力。

catalogue-mig =
    .role = 攻击机
    .lore = 快速对地攻击机，以导弹打击建筑和载具。打击后飞回机场补给弹药。

catalogue-mlrs =
    .role = 火箭坦克
    .lore = 履带式多管火箭炮。几秒内打光整个发射架，19 枚火箭弹倾泻覆盖目标区域，随后需要很长时间装填。

catalogue-mnly =
    .role = 布雷车
    .lore = 布设反坦克地雷和反步兵地雷，并能看到敌方地雷。在矿区和要道布雷，让敌人的每次进攻都付出高昂代价。

catalogue-mrj =
    .role = 雷达干扰车
    .lore = 干扰附近的敌方雷达站，并使来袭的制导导弹偏航。用它护送装甲部队突入导弹密集的防线。

catalogue-msam =
    .role = 中程防空
    .lore = 中程导弹阵地，也是你的火箭盾（铁穹式）：十枚快速拦截弹连射升空，几乎垂直爬升，在空中击爆来袭的火箭弹齐射和机载火箭，留下发光的轨迹。还能拦截飞机、巡航导弹和无人机。在装填期间，大规模齐射仍可能使其饱和。只有配合雷达站才能发挥全部射程。

catalogue-mslo =
    .role = 超级武器
    .lore = 核导弹发射井。经过长时间充能后发射一枚原子弹，可夷平敌方基地的整片区域。只能建造一座，就绪时所有对手都会收到警告。

catalogue-msub =
    .role = 导弹潜艇
    .lore = 潜航攻城平台，可向内陆纵深的建筑、地面单位和飞机发射导弹。对付其他舰艇时较弱。

catalogue-mtnk =
    .role = 中型坦克
    .lore = 更便宜的先锋战斗坦克，比重型坦克建造更快，但火炮较轻。

catalogue-mtrk =
    .role = 碾压者
    .lore = 一辆被征召入伍的巨轮民用越野车。完全没有武器：它只是从步兵、围栏和沙袋墙上碾过，驾驶室和车斗可搭载四人小队。美国专属。

catalogue-nation-allies =
    .lore = 联盟的通用军械库，所有联盟国家共享；伞兵乘坐长机身的 C-141 运输星。

catalogue-nation-china =
    .lore = 赤龙：福建舰超级航母、JX-20 隐形战斗机和射程最远的 PHX-16 火箭炮。运-20 鲲鹏运送其空降军。

catalogue-nation-cuba =
    .lore = 岛屿要塞：大量齐射的坚固老式冰雹火箭炮，以及可熬过任何围攻的防御。伞兵乘坐老式 B-29 超级空中堡垒。

catalogue-nation-egypt =
    .lore = 沙漠司令部：廉价的西北风级直升机航母和可撕碎轻型载具的猎鹰-36 集束火箭弹。空降旅乘坐改装用于空投部队的 B-52 同温层堡垒。

catalogue-nation-england =
    .lore = 欺敌大师：军情六处间谍、满载装备的间谍车，以及致盲敌人的裂缝产生器。空降部队乘坐 C-17A 环球霸王 III，最坚固的喷气运输机。

catalogue-nation-france =
    .lore = 精确与隐形：GPS 制导的 LRX 火箭弹、阵风战斗机和可隐形的相位运输车。伞兵从 C-130 大力神运输机跳伞。

catalogue-nation-germany =
    .lore = 时间工程师：可闪现穿越地图的超时空坦克和布设雷场的 MARZ 发射车。空降突袭乘坐缴获的 B-17 空中堡垒，HG-229 夜翼飞翼机携带重型制导炸弹。

catalogue-nation-india =
    .lore = 崛起之力：自建的维克兰特号航母和几秒内打光火箭巢的皮纳卡火箭炮。伞兵从带尾炮的伊尔-76MD 跳伞。

catalogue-nation-iran =
    .lore = 无人机大师：巴盖里号无人机航母、Shard 攻击无人机和征服者-X 隐形原型机。伞兵乘坐改装的波音 707。

catalogue-nation-italy =
    .lore = 地中海军团：加富尔号轻型航母和快速装填的闪电箭火箭炮。伞兵乘坐大型波音 314 飞剪水上飞机，从水上飞机基地出发。

catalogue-nation-japan =
    .lore = 岛国海军：加贺号垂直起降航母和可击沉远海舰船的海箭导弹车。伞兵从 C-130 大力神运输机跳伞。

catalogue-nation-pakistan =
    .lore = 山地守护者：从前线后方纵深精准重击的征服者制导火箭弹。伞兵从 C-130 大力神运输机跳伞。

catalogue-nation-russia =
    .lore = 磁暴武器：震荡步兵、磁暴坦克、库兹涅佐夫号航母和 TOZ-1 日炎温压火箭。伞兵从带尾炮的伊尔-76MD 跳伞。

catalogue-nation-southkorea =
    .lore = 半岛之盾：可在火箭弹齐射和单枚重型制导导弹之间切换的天武发射车。伞兵从 C-130 大力神运输机跳伞。

catalogue-nation-soviet =
    .lore = 先锋的通用军械库，所有先锋国家共享；伞兵乘坐按每颗铆钉仿制的 B-29 超级空中堡垒。直升机坪可部署 Mi-26 光环重型运输机、雌鹿和 Mi-35 武装直升机以及 Ka-52 短吻鳄。

catalogue-nation-turkey =
    .lore = 大陆之门：来自阿纳多卢号航母的无人机战、蜂群无人机和重型旋风火箭弹。伞兵从 C-130 大力神运输机跳伞。

catalogue-nation-ukraine =
    .lore = 爆破专家：核爆破卡车、伞降炸弹空袭、巨型 An-225 和精确的维尔卡火箭弹。伞兵从伊尔-76MD 跳伞，其双联 23 毫米尾炮可驱离战斗机。

catalogue-nation-usa =
    .lore = 联盟的民主兵工厂：世界上最庞大的航空联队、超级航母、HIMAX 火箭车，以及投下胖子原子弹的 AB-35 长翼。伞兵乘坐从空降基地起飞的 C-130 大力神运输机。

catalogue-oilr =
    .role = 海上经济
    .lore = 海上平台，可源源不断地产出资金，无需保护运矿车。必须建造在基地附近的水面上，电力不足时停止开采。舰船和潜艇是它最大的威胁。

catalogue-pbox =
    .role = 反步兵地堡
    .lore = 装有机枪的混凝土碉堡。可发现隐形单位，并能粉碎步兵冲锋。与反坦克炮塔搭配使用。

catalogue-phx16 =
    .role = 火箭炮（中国）
    .lore = 游戏中射程最远的火箭炮。可从前线后方远处炮击基地和集群目标。装填缓慢。

catalogue-pinak =
    .role = 火箭炮（印度）
    .lore = 几秒内打光全部火箭弹。对步兵和基地的毁灭性突袭齐射。

catalogue-powr =
    .role = 发电
    .lore = 基地的基础电力。电力不足时防御设施、雷达和超级武器都会停止运作，因此要提前建造发电厂并分散布置：对密集发电厂的一次打击就可能让整个基地断电。

catalogue-proc =
    .role = 经济
    .lore = 将矿石和宝石转化为资金，并附赠一辆运矿车。建在富矿区附近以缩短每趟路程。在另一处矿区附近建造第二座精炼厂，收入几乎翻倍。

catalogue-pt =
    .role = 炮艇
    .lore = 轻快的巡逻艇，可探测潜艇并猎杀小型舰船。水上廉价的眼睛。

catalogue-ptnk =
    .role = 光棱坦克
    .lore = 远程光束坦克，其水晶光束可溅射成群的步兵、轻型载具和建筑。较脆弱，应部署在重装甲部队后方。

catalogue-ptwr =
    .role = 光棱防御
    .lore = 发射水晶光束。附近的光棱塔会互相连接，将能量汇聚到开火的那座：每连接一座伤害 +40%，最高 +200%。成群建造效果最佳。

catalogue-qtnk =
    .role = 震荡坦克
    .lore = 震荡坦克以地震波撼动地面，摧毁附近的载具和建筑，自身也会随之毁灭。把它开进敌方基地中心。

catalogue-rgun =
    .role = 反装甲机器人
    .lore = 其磁轨炮可远距离打击装甲，但充能缓慢。让它待在步兵屏障后方，逐一点杀坦克。

catalogue-sacm =
    .role = 战略空军司令部
    .lore = 空军的皇冠：一座营区可停放 10 架飞机。只能建造一座，要像保护建造厂一样保护它。

catalogue-saetta =
    .role = 火箭炮（意大利）
    .lore = 更便宜的履带式发射车，装填更快。数辆闪电箭轮番开火，可保持持续压制。

catalogue-sam =
    .role = 近程防空
    .lore = 向飞机和无人机发射地对空导弹，还能击落部分火箭弹和巡航导弹。需要电力。

catalogue-saqr36 =
    .role = 集束火箭炮（埃及）
    .lore = 集束火箭弹在目标上空分裂为子炸弹。对步兵和轻型载具是毁灭性的，对坦克和建筑较弱。

catalogue-sbag =
    .role = 轻型屏障
    .lore = 廉价的沙袋，可阻挡步兵和轻型载具，并将进攻者引入你的火力范围。坦克可将其碾平。

catalogue-sbmb =
    .role = 超级武器机场
    .lore = 苏式轰炸机基地，设有一座巨型停机坪、一座拱形机库和一座热核武器库。停放 Tv-95 熊式，并在轰炸机存活期间为热核打击充能。俄罗斯专属，每名玩家限一座。

catalogue-scar =
    .role = 间谍车辆
    .lore = 暗藏机枪和弹出式火箭的豪华轿车，可搭载一名间谍。在它发动攻击之前，敌人只会看到一辆无害的民用车。需要军情六处总部。

catalogue-scr2 =
    .role = 间谍车辆
    .lore = 暗藏双联机枪的经典豪华跑车，可搭载一名间谍。比间谍车 1 更坚固、更便宜。需要军情六处总部。

catalogue-sdrn =
    .role = 自杀式无人机
    .lore = 快速、廉价的蜘蛛无人机，冲向目标并引爆。派出一波波蜘蛛冲击坦克纵队和机器人大军。

catalogue-sfng =
    .role = 实验型坦克
    .lore = 来自 Project X 实验室的赛博坦克。其主炮释放强力电弧，从内部烧毁装甲。只能部署一辆。

catalogue-shok =
    .role = 磁暴步兵
    .lore = 携带便携式磁暴线圈的精英步兵，电弧可同时贯穿步兵和载具。俄罗斯的标志性士兵。

catalogue-silo =
    .role = 经济储存
    .lore = 为精炼后的资金提供额外储存空间。储存不足时，超出上限的矿石将被浪费。造价便宜，收入超过储存上限时就建一座。

catalogue-snip =
    .role = 神枪手
    .lore = 远程神枪手，一枪可击毙大多数步兵，静止时会隐蔽。担任火力掩护时致命，对装甲毫无作用。

catalogue-spdr =
    .role = 突击步行机甲
    .lore = 先锋的八足蜘蛛坦克迅速爬入射程，发射重型导弹俯冲攻击坦克薄弱的顶部装甲。其双联防空发射器向飞机发射铁穹式拦截弹，还能击落来袭的火箭弹。

catalogue-spen =
    .role = 海军生产
    .lore = 先锋潜艇基地。建造并维修潜艇、运输艇和先锋航母。必须建造在水面上。

catalogue-spy =
    .role = 渗透者
    .lore = 伪装成敌方士兵并渗透建筑：从精炼厂窃取资金、重置超级武器、致盲雷达或获取生产机密。军犬能识破伪装。

catalogue-spyd =
    .role = 机动防空系统
    .lore = 一辆卡车，载有可旋转、倾斜的四联导弹发射箱：怪蛇红外导弹对付近距离目标，德比雷达导弹以双脉冲发动机在两次燃烧之间滑翔，对付远距离目标。两者都会爬升至高空后俯冲攻击飞机，爆出巨大火球。印度专属。

catalogue-ss =
    .role = 攻击潜艇
    .lore = 潜入水下隐蔽，用鱼雷攻击舰船。可探测其他潜艇。只在开火时上浮。

catalogue-stek =
    .role = 高级研究
    .lore = 先锋研究中心。解锁先锋最重型的坦克、磁暴武器和最强的喷气机。

catalogue-stnk =
    .role = 隐形运输车
    .lore = 轻装甲运输车，闲置时自动隐形，并可发射对地导弹。让一队工程师悄无声息地溜过防线。

catalogue-strd =
    .role = 突击步行机甲
    .lore = 行动缓慢的先锋四足步行机甲，装备重炮和机枪。可穿过步兵队伍，火力胜过大多数坦克。

catalogue-supl =
    .role = 卫星控制
    .lore = 卫星的地面控制站。如果失去所有上行站，你的所有卫星都将离线，直到建造新的上行站，因此应在远离前线的地方建一座备用。

catalogue-syrd =
    .role = 海军生产
    .lore = 联盟船坞。建造并维修炮艇、驱逐舰、巡洋舰、运输艇，部分国家还可建造航母。必须建造在水面上。

catalogue-taut =
    .role = 磁暴机器人
    .lore = 重型先锋机器人，可从双手释放磁暴闪电，对步兵和敌方机器人致命。

catalogue-tent =
    .role = 步兵生产
    .lore = 联盟兵营：训练步枪兵、火箭兵、工程师、医疗兵和机器人步兵。多座兵营可加快训练速度。设置集结点，让新部队直接开赴前线。

catalogue-tiger =
    .role = 重型攻击直升机
    .lore = 虎式：法德联合研制的武装直升机，外侧挂架携带 HOT 反坦克导弹，火箭巢可连续发射 68 毫米火箭弹。法国和德国专属。

catalogue-toz1 =
    .role = 温压火箭炮（俄罗斯）
    .lore = 装甲温压火箭发射车。射程短，但能以巨大火球烧毁步兵和建筑。

catalogue-tran =
    .role = 运输直升机
    .lore = 支奴干：可将一队步兵运往地图任意位置。无武装，因此应在远离防空的地方投放部队。

catalogue-truk =
    .role = 补给卡车
    .lore = 向盟友的精炼厂运送资金。无武装。用它帮助陷入困境的队友坚持下去。

catalogue-tsla =
    .role = 磁暴防御
    .lore = 释放闪电，可同时摧毁步兵和载具。耗电量很大，停电时会关闭，因此要保护好发电厂。

catalogue-ttnk =
    .role = 磁暴坦克
    .lore = 搭载磁暴线圈的坦克，闪电可贯穿步兵、载具和建筑。俄罗斯应对大规模装甲的利器。

catalogue-tu95 =
    .role = 热核轰炸机
    .lore = 熊式：配备四台对转螺旋桨发动机的远程轰炸机。没有武装，只执行一项任务：热核打击就绪时投下 RDS-37 氢弹，然后返航。失去它后打击计时将重新开始。俄罗斯专属，每名玩家限一架。

catalogue-type12 =
    .role = 反舰导弹（日本）
    .lore = 可打击远海舰船的导弹车。部署在海岸，敌方舰队就无法靠近。

catalogue-v2rl =
    .role = 火箭炮
    .lore = 发射一枚巨型火箭，可在远距离重创步兵和建筑。装填缓慢，任何能接近它的敌人都能轻易将其摧毁。

catalogue-vilkra =
    .role = 火箭炮（乌克兰）
    .lore = 精确制导远程火箭弹，以外科手术般的精度打击建筑、步兵和载具。装填缓慢。

catalogue-weap =
    .role = 载具生产
    .lore = 建造所有坦克、运输车和火箭炮。增建维修厂和雷达站可解锁更重型的设计，包括你所属国家的专属火箭炮。

