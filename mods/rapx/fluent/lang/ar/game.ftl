catalogue-1tnk =
    .role = دبابة خفيفة
    .lore = سريعة ورخيصة، مثالية للاستطلاع ومضايقة شاحنات الخام واصطياد المركبات الخفيفة. تخسر المواجهة المباشرة أمام الدبابات الأثقل.

catalogue-2tnk =
    .role = دبابة قتال رئيسية
    .lore = دبابة القتال الرئيسية للاتحاد: توازن جيد بين السرعة والدروع والقوة النارية. اجمعها مع جنود الصواريخ والمدافع الجوية المتحركة لجيش متكامل.

catalogue-3tnk =
    .role = دبابة ثقيلة
    .lore = دبابة القتال الرئيسية للطليعة بمدفعين ثقيلين. أبطأ من مدرعات الاتحاد لكنها تضرب أقوى بكثير. تنتصر في معارك الدبابات المباشرة.

catalogue-4tnk =
    .role = دبابة فائقة الثقل
    .lore = الماموث: مدفعان للدبابات، وحاضنات صواريخ للطائرات والمشاة، ودروع ثقيلة وإصلاح ذاتي عند التضرر. بطيئة ومكلفة، وتسحق حتى الجدران الخرسانية.

catalogue-abas =
    .role = قاعدة جوية كبيرة
    .lore = مطار أكبر بمواقف لـ 6 طائرات. وسع جناحك الجوي دون نشر المنصات في أنحاء القاعدة.

catalogue-abrn =
    .role = قاعدة إنزال جوي، 3 منصات نقل
    .lore = موطن ألوية المظليين: ثكنات، وقاعة لطي المظلات، وثلاث منصات لطائرات النقل الثقيلة التي تحمل كل منها 40 جنديا إلى أي مكان في الخريطة.

catalogue-afbs =
    .role = قاعدة القوات الجوية
    .lore = قاعدة قوات جوية كاملة بمواقف لـ 8 طائرات لجناح ضارب جاد.

catalogue-afld =
    .role = قاعدة جوية
    .lore = تبني الطائرات النفاثة وتعيد تسليحها، بمواقف لـ 4 طائرات. وتمنح أيضا قدرتي طائرة التجسس والمظليين. تعود المقاتلات إليها لإعادة التذخير بعد كل طلعة.

catalogue-agun =
    .role = دفاع جوي قصير المدى
    .lore = مدفع مضاد للطائرات يمزق الطائرات والمسيرات وصواريخ كروز القادمة من مسافة قريبة. يحتاج إلى طاقة. طوق قاعدتك بها ضد القاذفات.

catalogue-apc =
    .role = ناقلة مدرعة
    .lore = تحمل فرقة مشاة تحت الدروع وتدعمها برشاش. أنزل المهندسين في قاعدة العدو أو اندفع بجنود الصواريخ إلى الجبهة.

catalogue-apwr =
    .role = توليد طاقة ثقيل
    .lore = ضعف إنتاج محطة الطاقة على مساحة أكبر. هدف رئيسي لقاذفات العدو، فاحمها بالدفاعات الجوية.

catalogue-arty =
    .role = مدفعية
    .lore = مدفع هاوتزر بعيد المدى يقصف الدفاعات والمشاة من خارج مداها. هش جدا عن قرب، فأبقه دائما مع مرافقة.

catalogue-asat =
    .role = مضاد للأقمار الصناعية
    .lore = يسقط أقمار العدو الصناعية فوقه ضمن 12 خلية. لا يستطيع إصابة الوحدات البرية أو الطائرات. دفاعك الوحيد ضد شبكة الليزر المدارية.

catalogue-atek =
    .role = أبحاث متقدمة
    .lore = مركز أبحاث الاتحاد. يفتح أكثر أسلحة الاتحاد تقدما ويطلق قمر GPS الذي يكشف الخريطة كلها.

catalogue-aw101 =
    .role = مروحية نقل ثقيلة
    .lore = Merlin: مروحية سريعة بثلاثة محركات تحمل عشرة جنود لمسافات طويلة. للهند فقط.

catalogue-b17t =
    .role = نقل جوي، 40 مظليا
    .lore = قلعة طائرة مغتنمة، كتلك التي استخدمها السرب الخاص في الحرب لإنزال العملاء خلف الخطوط.

catalogue-b29t =
    .role = نقل جوي، 40 مظليا
    .lore = القلعة الفائقة التي نسختها الطليعة مسمارا بمسمار، وحجرات قنابلها مليئة الآن بالمظليين.

catalogue-b314 =
    .role = نقل جوي، 40 مظليا
    .lore = قارب طائر عظيم من عصر الكليبر، يحمل مظليي إيطاليا من قواعده للطائرات المائية.

catalogue-b52t =
    .role = نقل جوي، 40 مظليا
    .lore = قلعة Stratofortress جردت حجرات قنابلها وأعيد تجهيزها لإنزال مجموعة من أربعين رجلا.

catalogue-barr =
    .role = إنتاج المشاة
    .lore = ثكنة الطليعة: تدرب المجندين ورماة القنابل وجنود اللهب وجنود الصدمة ومدرعي الحرس الحديدي. عدة ثكنات تسرع التدريب.

catalogue-bb =
    .role = بارجة
    .lore = أكبر المدافع في البحر: أبراج ثلاثية بمدافع 16 بوصة في المقدمة والمؤخرة تقصف الساحل من خارج مدى معظم الدفاعات. بطيئة وصعبة الإغراق جدا، لكنها عمياء أمام الغواصات.

catalogue-bdrd =
    .role = روبوت قتالي
    .lore = روبوتات رخيصة للاتحاد ببنادق ليزرية، تبنى بأعداد كبيرة. استخدمها لإغراق مشاة العدو وامتصاص النيران.

catalogue-bmbf =
    .role = مطار السلاح الخارق
    .lore = مطار قاذفات محمي بمنصة عملاقة وحظيرة ومخبأ قنابل مدرع. يؤوي AB-35 Longwing ويشحن ضربة فاتمان ما دامت القاذفة حية. للولايات المتحدة فقط، واحد لكل لاعب.

catalogue-bmd =
    .role = الدفاع ضد الصواريخ الباليستية
    .lore = فئة THAAD. يعترض الصواريخ الباليستية والفرط صوتية عاليا وبعيدا، وهو الرد على ضربات الصواريخ الباليستية (ويترك القذائف الصاروخية للدفاع الجوي متوسط المدى). يحتاج قبة رادار للمدى الكامل.

catalogue-brik =
    .role = حاجز ثقيل
    .lore = جدران خرسانية توقف كل الوحدات البرية وتصد نيران العدو. لا تسحقها إلا دبابة الماموث. استخدمها لحماية محطات الطاقة والمصافي.

catalogue-btr =
    .role = ناقلة مدرعة
    .lore = ناقلة جند مدرعة بثماني عجلات ومدفع آلي في برج: سريعة على الطرق، تنزل 5 من المشاة على الجبهة وتواصل الإطلاق. لروسيا فقط.

catalogue-c130 =
    .role = نقل جوي، 40 مظليا
    .lore = Hercules: حصان العمل رباعي المحركات للقوات المحمولة جوا من الولايات المتحدة إلى فرنسا واليابان وكوريا الجنوبية وتركيا وباكستان.

catalogue-c141 =
    .role = نقل جوي، 40 مظليا
    .lore = الطائرة النفاثة طويلة الجسم التي حملت الفرق المحمولة جوا للاتحاد لعقود.

catalogue-c17 =
    .role = نقل جوي، 40 مظليا
    .lore = طائرة النقل الاستراتيجي لسلاح الجو الملكي: أربعة محركات توربينية، وعنبر شحن ضخم، وأربعون رجلا يقفزون من الأبواب الجانبية.

catalogue-ca =
    .role = طراد
    .lore = سفينة بطيئة جدا بمدافع ضخمة بعيدة المدى تقصف القواعد الساحلية من عرض البحر. رافقها بالمدمرات ضد الغواصات.

catalogue-cg =
    .role = طراد صواريخ
    .lore = طراد صواريخ موجهة: تصل صواريخ توماهوك إلى أهداف في عمق اليابسة، بينما تحمي صواريخه أرض-جو ومدفعه القريب الأسطول من الجو. للولايات المتحدة فقط.

catalogue-chunmu =
    .role = قاذفة صواريخ (كوريا الجنوبية)
    .lore = قاذفة ثقيلة على عجلات برشقة من 6 صواريخ. انشرها للتبديل إلى صاروخ موجه ثقيل واحد بمدى أطول.

catalogue-croc =
    .role = مفترس الكمائن
    .lore = أقدم صيادي النيل، ربته مصر ودربته. يمشي على اليابسة ويسبح أسرع مما يمشي، ويكمن في الماء لا يظهر منه إلا عيناه، فلا يرى حتى ينقض. انقضاضة وعضة واحدة تنهيان جنديا أو كلبا؛ ثم يتوقف ليبتلع. جلده الحرشفي لا يبالي بنيران البنادق. لمصر فقط.

catalogue-ctnk =
    .role = دبابة كرونو
    .lore = تطلق صواريخ أرض-أرض ويمكنها الانتقال آنيا إلى أي مكان ضمن المدى. انتقل خلف خطوط العدو لضرب المدفعية والمصافي، ثم انتقل مبتعدا.

catalogue-cv1 =
    .role = حاملة الأسطول
    .lore = حاملة من فئة Essex من الحرب العالمية الثانية: قاعدة جوية عائمة بقاذفات صواريخ أرض-جو للدفاع. تطلق الطائرات النفاثة وتعيد تسليحها في البحر.

catalogue-cv2 =
    .role = حاملة المعركة
    .lore = أول حاملة تعمل بالطاقة النووية، فئة Enterprise: سطح أكبر وهيكل أمتن وقاذفات صواريخ أرض-جو أكثر.

catalogue-cv3 =
    .role = الحاملة العملاقة
    .lore = حاملة طائرات عملاقة نووية من فئة Nimitz، سفينة القيادة المدرعة بشدة في الأسطول.

catalogue-cv4 =
    .role = حاملة عملاقة من الجيل القادم
    .lore = حاملة من فئة Gerald R. Ford بأحدث الدفاعات. أقوى سفينة في البحار.

catalogue-cvcn =
    .role = حاملة عملاقة (الصين)
    .lore = فوجيان: أحدث حاملة طائرات عملاقة صينية، بمنجنيقات كهرومغناطيسية.

catalogue-cveg =
    .role = حاملة مروحيات (مصر)
    .lore = ميسترال: حاملة مروحيات برمائية. رخيصة وسريعة البناء.

catalogue-cvfr =
    .role = حاملة (فرنسا)
    .lore = شارل ديغول، حاملة فرنسا النووية وفخر البحرية الوطنية الفرنسية.

catalogue-cvgb =
    .role = حاملة (إنجلترا)
    .lore = حاملة الملكة إليزابيث التابعة للبحرية الملكية، بمقدمة قفز تزلجي وبرجي قيادة.

catalogue-cvin =
    .role = حاملة (الهند)
    .lore = فيكرانت: حاملة هندية محلية الصنع بمقدمة قفز تزلجي.

catalogue-cvir =
    .role = حاملة مسيرات (إيران)
    .lore = باقري: سفينة تجارية محولة بسطح طيران للمسيرات. رخيصة لكنها هشة.

catalogue-cvit =
    .role = حاملة خفيفة (إيطاليا)
    .lore = كافور: حاملة إيطالية خفيفة للطائرات العمودية والمروحيات.

catalogue-cvjp =
    .role = حاملة خفيفة (اليابان)
    .lore = كاغا: مدمرة مروحيات أعيد بناؤها كحاملة خفيفة للمقاتلات العمودية.

catalogue-cvru =
    .role = حاملة (روسيا)
    .lore = كوزنيتسوف: طراد ثقيل حامل للطائرات بمقدمة قفز تزلجي ودفاعات جوية قوية.

catalogue-cvsu =
    .role = طراد جوي
    .lore = كييف: نصفها حاملة ونصفها طراد، بسطح طيران في المؤخرة وقاذفات صواريخ في المقدمة.

catalogue-cvtr =
    .role = حاملة مسيرات (تركيا)
    .lore = أناضول: سفينة برمائية تحولت إلى حاملة مسيرات تطلق أسرابا من المسيرات الهجومية.

catalogue-cybt =
    .role = مشاة سايبورغ
    .lore = سايبورغ مدرع للاتحاد بمسدس آلي ثقيل. لا تسحقه الدبابات ولا يحتاج إلى ساتر أبدا. صامد قوي على الخط.

catalogue-dd =
    .role = مدمرة
    .lore = سفينة حربية سريعة متعددة المهام تكشف الغواصات وتقاتل السفن والمركبات والطائرات. عماد أسطول الاتحاد.

catalogue-dog =
    .role = كلب هجومي
    .lore = سريع ورخيص، يقتل المشاة بعضة واحدة ويشم الجواسيس المتنكرين. أبق اثنين في القاعدة لصيد الجواسيس.

catalogue-dome =
    .role = الاستخبارات
    .lore = يشغل خريطة الرادار المصغرة ويفتح معظم الوحدات والدفاعات متوسطة المستوى. ويمنح دفاعاتك الجوية بعيدة المدى مداها الكامل. فقدانه يعميك، فاحمه.

catalogue-dtrk =
    .role = شاحنة القنبلة النووية
    .lore = شاحنة برأس نووي مسلح ودروع رقيقة كالورق. قدها إلى قاعدة العدو وفجرها. تأخذ معها كل ما حولها، بما في ذلك وحداتك.

catalogue-e1 =
    .role = مشاة البنادق
    .lore = عماد كل جيش: رخيص وسريع التدريب وجيد ضد المشاة الآخرين. ضعهم في الدشم، أو احشدهم لحماية دباباتك من جنود الصواريخ.

catalogue-e2 =
    .role = رامي القنابل
    .lore = يقذف قنابل يدوية تصيب مجموعات المشاة وتلحق الضرر بالمباني. قد تؤذي قنابله الوحدات الصديقة القريبة، فأبقه خلف خط المواجهة.

catalogue-e3 =
    .role = مضاد للدبابات / للطائرات
    .lore = صواريخ تطلق من الكتف تصيب المدرعات والطائرات معا. رخيص، ورد المشاة على الدبابات والمروحيات، لكنه فريسة سهلة للرشاشات.

catalogue-e4 =
    .role = جندي اللهب
    .lore = قاذفات لهب قصيرة المدى تحرق المشاة المتحصنين وتشعل المباني. قوي في تطهير المخابئ ومهاجمة القواعد.

catalogue-e6 =
    .role = مهندس
    .lore = يستولي على مباني العدو ويصلح مبانيك ويرمم الجسور المدمرة. رافقه إلى قاعدة العدو واستول على مصنع حرب أو مركز تقنية لسرقة تقنياته.

catalogue-e7 =
    .role = كوماندوز النخبة
    .lore = تانيا: مسدسان يسقطان المشاة بطلقة واحدة، ومتفجرات C4 تسوي أي مبنى تصل إليه بالأرض. لا يمكن نشر إلا واحدة. أبعدها عن الدبابات والكلاب.

catalogue-e8c =
    .role = نقل جوي، 40 مظليا
    .lore = هيكل Boeing 707 من النوع الذي تشغله القوات الجوية الإيرانية منذ نصف قرن، أعيد تجهيزه لنقل الجنود.

catalogue-elph =
    .role = فيل حرب ماش
    .lore = فيل الحرب الهندي المدرع: قلعة تمشي على أربع أرجل فولاذية، على ظهرها مدفعان ثقيلان يطلقان القذيفة تلو الأخرى. لا يستطيع الجنود تفاديه كما يتفادون الدبابة: من يقع تحت قدميه يداس. بطيء ومكلف، لكن إيقافه صعب جدا. للهند فقط.

catalogue-enfw =
    .role = آلية هجوم ماشية
    .lore = آلية ثقيلة للاتحاد على ساقين. مدفعان آليان في الذراعين يمزقان المشاة، وحاضنة صواريخ على الكتف تخترق الدروع. قلعة ماشية لكسر الخطوط الدفاعية.

catalogue-fact =
    .role = قيادة القاعدة
    .lore = قلب كل قاعدة. تبني كل المنشآت الأخرى وتحدد نطاق البناء، وفقدانها يوقف كل توسع. أبقها في عمق دفاعاتك، وإن سمحت الردهة، أعد طيها إلى مركبة بناء لنقل قاعدتك.

catalogue-fajir5 =
    .role = قاذفة صواريخ (إيران)
    .lore = مدى بعيد بسعر منخفض، لكنها غير دقيقة. انشرها للتبديل إلى مسيرتين هجوميتين Shard-136 بمدى بعيد جدا.

catalogue-fatah =
    .role = قاذفة صواريخ (باكستان)
    .lore = صواريخ موجهة بعيدة المدى دقيقة جدا ضد المباني والمشاة والمركبات على حد سواء. بطيئة في إعادة التذخير.

catalogue-fenc =
    .role = حاجز خفيف
    .lore = أسلاك شائكة توقف المشاة والمركبات الخفيفة. تسحقها الدبابات.

catalogue-fix =
    .role = إصلاح ميداني
    .lore = يصلح المركبات التي تقف على منصته مقابل رسوم. ويفتح أيضا المركبات المتقدمة. ضعه بين مصنع الحرب والجبهة لتعود الدبابات المتضررة إلى القتال بسرعة.

catalogue-flak =
    .role = دفاع مضاد للطائرات
    .lore = مدفع ثقيل مزدوج مضاد للطائرات على قاعدة دوارة. تصيب رشقاته كل الطائرات القريبة، ويمكنه إسقاط المسيرات وصواريخ كروز من السماء.

catalogue-ftrk =
    .role = دفاع جوي متحرك
    .lore = مدفع مضاد للطائرات على شاحنة يمزق الطائرات والمسيرات والمشاة. أبق واحدا مع كل رتل مدرع.

catalogue-ftur =
    .role = برج مضاد للمشاة
    .lore = يصب الوقود المشتعل على كل من يقترب. يفتك بالمشاة والمركبات الخفيفة، لكن مداه قصير ولا يطال الدبابات عن بعد.

catalogue-gap =
    .role = مكافحة التجسس
    .lore = يلف قاعدتك بالضباب فلا يرى العدو ما بداخلها. لا تكشفها الكشافة وطائرات التجسس إلا لحظات. يحتاج إلى طاقة.

catalogue-godz =
    .role = عملاق: سلاح خارق ماش
    .lore = جبل من الحراشف يخرج من البحر. حين تتوهج صفائحه الظهرية بالوردي، فكل ما أمامه على وشك الاحتراق: نفسه الذري يصل أبعد من معظم المدفعية ويسقط الطائرات من السماء. والدبابات التي تقترب تداس. يختار في الردهة، واحد لكل لاعب، وحين يسقط يرحل إلى الأبد.

catalogue-grad =
    .role = قاذفة صواريخ (كوبا)
    .lore = قاذفة Grad قديمة: رخيصة لكنها غير دقيقة. احشدها وأغرق منطقة بالصواريخ.

catalogue-gun =
    .role = برج مضاد للدروع
    .lore = برج مدفع دوار يخترق الدبابات. رخيص وموثوق، لكنه ضعيف أمام حشود المشاة وعاجز أمام الطائرات.

catalogue-gurz =
    .role = دفاع جوي متحرك
    .lore = شاحنة ثقيلة بثماني عجلات تحمل وحدة قتالية دوارة: حاضنتان لصواريخ صغيرة بالأشعة تحت الحمراء ومدفع 35 مم بينهما. تطلق أربعة صواريخ متتالية، يلتف كل منها في دوامة ضيقة، وتنفجر صواعقها التقاربية في سحب سوداء. لدول الطليعة عدا الهند.

catalogue-hailstorm =
    .role = قاذفة صواريخ (إنجلترا)
    .lore = قاذفة مجنزرة تطلق رشقة كبيرة من 12 صاروخا على مساحة واسعة. قوية ضد المشاة والقواعد، لكنها بطيئة.

catalogue-harv =
    .role = شاحنة الخام
    .lore = تجمع الخام والجواهر وتحملها إلى مصفاتك. مدرعة بشدة لكنها غير مسلحة. احم شاحناتك: إنها دخلك.

catalogue-hbox =
    .role = مخبأ مموه
    .lore = دشمة مخفية تحت التمويه. لا يراها الأعداء حتى يقتربوا، فهي كمين مثالي على طريق هجوم محتمل.

catalogue-hcru =
    .role = طراد المروحيات
    .lore = طراد بسطح للمروحيات في المؤخرة: صواريخ ومدفع دوار ضد الطائرات، وقنابل أعماق وسونار ضد الغواصات.

catalogue-heli =
    .role = مروحية هجومية
    .lore = Longbow: مروحية صواريخ تصطاد الدبابات والمباني والطائرات الأخرى. اضرب وانسحب، ثم عد إلى مهبط المروحيات لإعادة التسليح.

catalogue-himax =
    .role = قاذفة صواريخ (الولايات المتحدة)
    .lore = قاذفة سريعة على عجلات بصواريخ موجهة بعيدة المدى. تضرب وتنسحب، متحركة بعد كل إطلاق، فتصيب النيران المضادة عادة أرضا خالية.

catalogue-hind =
    .role = مروحية هجومية
    .lore = Hind: مروحية حربية ثقيلة برشاشات دوارة تحصد المشاة والمركبات الخفيفة.

catalogue-hlfr =
    .role = شاحنة صواريخ
    .lore = راجمة صواريخ على عجلات بمجموعة من أنابيب الإطلاق المغلقة. تطلق 30 صاروخا خفيفا في سيل طويل يغرق منطقة الهدف، ثم تعيد التذخير.

catalogue-hmmv =
    .role = عربة استطلاع
    .lore = حصان العمل في الجيش الأمريكي: مدرعة وسريعة، برشاش عيار 50 على السقف ومكان لفريق من أربعة. للولايات المتحدة فقط.

catalogue-hpad =
    .role = قاعدة المروحيات
    .lore = تبني المروحيات وتعيد تسليحها للجانبين: Chinook وBlack Hawk وLongbow للاتحاد، وMi-26 وHind وMi-35 وKa-52 للطليعة. كل منصة تخدم مروحية واحدة في كل مرة، فابن منصة لكل مروحية حربية تنوي نشرها.

catalogue-il76 =
    .role = نقل جوي، 40 مظليا
    .lore = Candid: طائرة النقل النفاثة الثقيلة لأوكرانيا وروسيا والهند. تنزل أربعين رجلا خلف خطوط العدو وتبعد المقاتلات عن ذيلها بمدفعين 23 مم.

catalogue-irgd =
    .role = مشاة الهيكل الخارجي
    .lore = جندي طليعة في هيكل خارجي آلي برشاش ثقيل يغذى بالحزام. لا تستطيع الدبابات سحقه، ويحصد المشاة.

catalogue-iron =
    .role = سلاح خارق
    .lore = تجعل مجموعة من الوحدات أو المباني محصنة لوقت قصير. وقتها مع هجوم الدبابات لتصل رأس الحربة دون أن تمس.

catalogue-jeep =
    .role = مركبة استطلاع
    .lore = Ranger: عربة استطلاع سريعة برشاش تحمل جنديا واحدا. استخدمها للاستطلاع ومطاردة المشاة وصيد شاحنات الخام.

catalogue-jet-a10 =
    .role = هجوم أرضي، الجيل 3
    .lore = Thunderhog: دبابة طائرة مبنية حول مدفع دوار ضخم. مدرعة بشدة وبطيئة وقاتلة للمدرعات. أبعد المقاتلات عنها.

catalogue-jet-an225 =
    .role = نقل ثقيل، الجيل 4
    .lore = An-225 Dreamer: أكبر طائرة بنيت على الإطلاق. تنقل المشاة عبر الخريطة. غير مسلحة.

catalogue-jet-b2 =
    .role = قاذفة شبحية، الجيل 5
    .lore = Wraith: قاذفة شبحية بتصميم الجناح الطائر تلقي حمولة قنابل هائلة في عمق خطوط العدو.

catalogue-jet-b52 =
    .role = قاذفة ثقيلة، الجيل 2
    .lore = Stratoforce: قاذفة سجادية ضخمة تسوي أحياء كاملة من القاعدة بالأرض. رافقها، فهي لا تستطيع الدفاع عن نفسها ضد المقاتلات.

catalogue-jet-f104 =
    .role = اعتراض، الجيل 2
    .lore = Starflash: طائرة اعتراض من الحرب الباردة بأنف كالإبرة صممت للسرعة الخالصة. صواريخها تضرب المباني والمركبات بقوة، لكن دروعها قليلة.

catalogue-jet-f117 =
    .role = ضربة شبحية، الجيل 3
    .lore = Nightjar: طائرة شبحية متعددة الأوجه تتسلل عبر الدفاعات الجوية لضرب الأهداف الثمينة.

catalogue-jet-f14 =
    .role = اعتراض، الجيل 3
    .lore = Bobcat: مدافعة عن الأسطول بأجنحة متغيرة وصواريخ بعيدة المدى. تشغلها الولايات المتحدة وإيران فقط.

catalogue-jet-f16 =
    .role = مقاتلة متعددة المهام، الجيل 3
    .lore = Fighting Kestrel: مقاتلة خفيفة رشيقة متعددة المهام. قيمة جيدة لضرب المركبات والمباني.

catalogue-jet-f2 =
    .role = مقاتلة ضاربة بحرية، الجيل 4
    .lore = Zero Viper: مقاتلة الضربات اليابانية محلية الصنع، نسخة مطولة من Falcon بجناح أكبر صممت لصيد السفن في عرض البحر.

catalogue-jet-f22 =
    .role = مقاتلة شبحية، الجيل 5
    .lore = Raptorex: مقاتلة شبحية من الجيل الخامس وأفضل طائرة تفوق جوي لدى الاتحاد. سريعة ويصعب رصدها وقاتلة.

catalogue-jet-f4 =
    .role = اعتراض، الجيل 2
    .lore = Spectre II: حصان عمل متين بمحركين تشغله دول أكثر من أي طائرة أخرى في اللعبة. قوة ضاربة موثوقة بسعر معقول.

catalogue-jet-gapgen =
    .role = مولد تشويش جوي
    .lore = طائرة رادار غير مسلحة تخفي الأرض تحتها عن العدو. أرسلها فوق منطقة فتحوم فوقها. غط بها هجوم دباباتك.

catalogue-jet-grom =
    .role = نموذج أولي لمسيرة قتالية
    .lore = Grom-K: مسيرة قتالية روسية بدون طيار. رخيصة وهشة وخطيرة على المشاة. واحدة لكل لاعب.

catalogue-jet-harrier =
    .role = طائرة إقلاع عمودي، الجيل 3
    .lore = تقلع Harrow عموديا من منصات صغيرة وأسطح الحاملات وتضرب المركبات بقوة.

catalogue-jet-he177 =
    .role = قاذفة ثقيلة، الجيل 0
    .lore = Greif: قاذفة ألمانيا رباعية المحركات من زمن الحرب، تدير محركاتها المزدوجة مروحتين كبيرتين، ولا تزال تحمل قنابل ثقيلة.

catalogue-jet-ho229 =
    .role = قاذفة شبحية، الجيل 5
    .lore = Nachtflügel: قاذفة ألمانيا النفاثة بتصميم الجناح الطائر، ولدت من تصميم الأخوين هورتن في زمن الحرب وبنيت أخيرا بمحركات حديثة وحمولة ثقيلة من القنابل الموجهة.

catalogue-jet-j20 =
    .role = مقاتلة شبحية، الجيل 5
    .lore = JX-20 Jade Dragon: مقاتلة الصين الشبحية من الجيل الخامس، بعيدة المدى ويصعب رصدها.

catalogue-jet-l39 =
    .role = هجوم خفيف، الجيل 2
    .lore = L-39U Albatross: طائرة تدريب وهجوم خفيف فعالة على نحو مفاجئ ضد المشاة والمدرعات الخفيفة والمسيرات.

catalogue-jet-la11 =
    .role = مقاتلة مكبسية، الجيل 0
    .lore = LaV-11 Fang: مقاتلة متينة بمحرك شعاعي من الأربعينيات. رخيصة وسريعة النشر بأعداد كبيرة.

catalogue-jet-m2000 =
    .role = مقاتلة متعددة المهام، الجيل 3
    .lore = Mirago 2000: مقاتلة أنيقة متعددة المهام بجناح دلتا تستخدمها دول كثيرة.

catalogue-jet-mig21 =
    .role = مقاتلة نفاثة، الجيل 2
    .lore = MiK-21 Fishbone: أكثر الطائرات النفاثة انتشارا في كتلة الطليعة. بسيطة وسريعة ورخيصة.

catalogue-jet-mig23 =
    .role = مقاتلة متعددة المهام، الجيل 3
    .lore = MiK-23 Flintlock: مقاتلة قاذفة بأجنحة متغيرة تضرب بسرعة وتنسحب بسرعة.

catalogue-jet-mig25 =
    .role = اعتراض، الجيل 3
    .lore = MiK-25 Foxbane: طائرة اعتراض فائقة السرعة للارتفاعات العالية. قلة من الأشياء تستطيع اللحاق بها.

catalogue-jet-mig3 =
    .role = مقاتلة مكبسية، الجيل 0
    .lore = MiK-3 Strela: مقاتلة مروحية من الأربعينيات. رخيصة وسريعة البناء، جيدة لقصف المشاة والمركبات الخفيفة.

catalogue-jet-qaher =
    .role = نموذج شبحي أولي
    .lore = Qahir-X: مقاتلة إيران الشبحية التجريبية. واحدة لكل لاعب.

catalogue-jet-rafale =
    .role = مقاتلة متعددة المهام، الجيل 4
    .lore = Rafal F4: مقاتلة حديثة شاملة المهام بجناح دلتا وزعانف أمامية، بارعة في الضربات كبراعتها في الالتحام الجوي.

catalogue-jet-saeqeh =
    .role = مقاتلة نفاثة، الجيل 3
    .lore = Saeqa: مقاتلة إيرانية محلية الصنع بذيل مزدوج، طائرة ضاربة متينة ضد المركبات والمباني.

catalogue-jet-seavixen =
    .role = ضربة بحرية، الجيل 2
    .lore = Sea Vixa: مقاتلة ضاربة بحرية بذراعي ذيل مزدوجين متخصصة في إغراق السفن.

catalogue-jet-sr71 =
    .role = استطلاع، الجيل 3
    .lore = Blackwing: طائرة استطلاع عالية السرعة يصعب جدا اللحاق بها. تكشف قاعدة العدو أثناء مرورها.

catalogue-jet-su25 =
    .role = هجوم أرضي، الجيل 3
    .lore = Sk-25 Rook: طائرة دعم قريب مدرعة تدك الدبابات والمركبات على ارتفاع منخفض.

catalogue-jet-su27 =
    .role = تفوق جوي، الجيل 3
    .lore = Sk-27 Flankard: مقاتلة كبيرة بمحركين، بعيدة المدى وبحمولة أسلحة ثقيلة.

catalogue-jet-su30 =
    .role = مقاتلة متعددة المهام، الجيل 4
    .lore = Flankard-M: نسخة Flanker بمقعدين تلتحم جويا وتضرب معا، تشغلها الطليعة وروسيا والهند والصين.

catalogue-jet-su35 =
    .role = مقاتلة متعددة المهام، الجيل 4
    .lore = Sk-35 Flankard-E: قدرة مناورة فائقة بتوجيه الدفع وأفضل مقاتلة رئيسية لدى الطليعة.

catalogue-jet-su47 =
    .role = مقاتلة نموذج أولي
    .lore = Sk-47 Berkov: مقاتلة شبحية تجريبية بأجنحة مائلة للأمام. واحدة لكل لاعب.

catalogue-jet-swarm =
    .role = سرب مسيرات، الجيل 3
